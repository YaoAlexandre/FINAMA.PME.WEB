@* Pagination commune. Usage :
   <Pager @bind-Page="_page" @bind-PageSize="_taillePage" TotalItems="_liste.Count" />
   avec  _liste.Page(_page, _taillePage)  (PagingExtensions) pour découper la liste. *@

@if (TotalItems > 0)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 border-top">
        <div class="small text-muted font-monospace">@Debut - @Fin sur @TotalItems</div>

        @if (TotalPages > 1)
        {
            <nav aria-label="Pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Page <= 1 ? "disabled" : "")">
                        <button type="button" class="page-link" aria-label="Page précédente" disabled="@(Page <= 1)" @onclick="() => Aller(Page - 1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </li>
                    @foreach (var p in PagesAffichees())
                    {
                        @if (p == 0)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        else
                        {
                            <li class="page-item @(p == Page ? "active" : "")">
                                <button type="button" class="page-link" aria-label="Page @p" @onclick="() => Aller(p)">@p</button>
                            </li>
                        }
                    }
                    <li class="page-item @(Page >= TotalPages ? "disabled" : "")">
                        <button type="button" class="page-link" aria-label="Page suivante" disabled="@(Page >= TotalPages)" @onclick="() => Aller(Page + 1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }

        <div class="d-flex align-items-center gap-2">
            <label class="small text-muted mb-0">Par page</label>
            <select class="form-select form-select-sm" style="width: auto;" value="@PageSize" @onchange="SurChangementTaille">
                @foreach (var t in TaillesPage)
                {
                    <option value="@t">@t</option>
                }
            </select>
        </div>
    </div>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public int[] TaillesPage { get; set; } = { 10, 20, 50, 100 };

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalItems / (double)Math.Max(PageSize, 1)));
    private int Debut => TotalItems == 0 ? 0 : (Math.Max(Page, 1) - 1) * PageSize + 1;
    private int Fin => Math.Min(Math.Max(Page, 1) * PageSize, TotalItems);

    /// <summary>1 … 4 5 6 … 20 : première, dernière, page courante et ses voisines ; 0 = points de suspension.</summary>
    private IEnumerable<int> PagesAffichees()
    {
        var retenues = new SortedSet<int> { 1, TotalPages };
        for (var p = Page - 1; p <= Page + 1; p++)
            if (p >= 1 && p <= TotalPages) retenues.Add(p);

        var precedente = 0;
        foreach (var p in retenues)
        {
            if (precedente != 0 && p - precedente > 1) yield return 0;
            yield return p;
            precedente = p;
        }
    }

    private async Task Aller(int page)
    {
        var cible = Math.Clamp(page, 1, TotalPages);
        if (cible == Page) return;
        Page = cible;
        await PageChanged.InvokeAsync(cible);
    }

    private async Task SurChangementTaille(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var taille) || taille <= 0) return;
        PageSize = taille;
        Page = 1;
        await PageSizeChanged.InvokeAsync(taille);
        await PageChanged.InvokeAsync(1);
    }
}
