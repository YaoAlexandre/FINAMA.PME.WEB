@* Pagination commune à toutes les listes.
   Listes paginées par l'API : Page / PageSize / TotalItems viennent de la réponse.
   Listes chargées en entier : voir PagingExtensions.Page() pour découper côté client. *@

@if (TotalItems > 0)
{
    <nav class="fn-pagination d-flex flex-column flex-md-row justify-content-between align-items-center gap-3"
         aria-label="Pagination @Unite">
        <div class="d-flex align-items-center flex-wrap justify-content-center gap-3 small text-muted">
            <span>@Debut–@Fin sur <strong>@TotalItems.ToString("N0")</strong> @Unite</span>

            @if (OnPageSizeChange.HasDelegate && PageSizes.Length > 1)
            {
                <label class="d-flex align-items-center gap-2 mb-0">
                    <span>Par page</span>
                    <select class="form-select form-select-sm w-auto" value="@PageSize" @onchange="ChangerTaille" aria-label="Éléments par page">
                        @foreach (var s in PageSizes)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </label>
            }
        </div>

        @if (TotalPages > 1)
        {
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Page <= 1 ? "disabled" : "")">
                    <button type="button" class="page-link" aria-label="Page précédente" disabled="@(Page <= 1)"
                            @onclick="() => Aller(Page - 1)">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                </li>

                @foreach (var p in Fenetre())
                {
                    if (p == 0)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    else
                    {
                        <li class="page-item @(p == Page ? "active" : "")" aria-current="@(p == Page ? "page" : null)">
                            <button type="button" class="page-link" aria-label="Page @p" @onclick="() => Aller(p)">@p</button>
                        </li>
                    }
                }

                <li class="page-item @(Page >= TotalPages ? "disabled" : "")">
                    <button type="button" class="page-link" aria-label="Page suivante" disabled="@(Page >= TotalPages)"
                            @onclick="() => Aller(Page + 1)">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </li>
            </ul>
        }
    </nav>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public string Unite { get; set; } = "résultats";
    [Parameter] public int[] PageSizes { get; set; } = { 10, 20, 50, 100 };
    [Parameter] public EventCallback<int> OnPageChange { get; set; }
    [Parameter] public EventCallback<int> OnPageSizeChange { get; set; }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalItems / (double)Math.Max(PageSize, 1)));
    private int Debut => TotalItems == 0 ? 0 : (Page - 1) * PageSize + 1;
    private int Fin => Math.Min(Page * PageSize, TotalItems);

    // 1 … 4 5 [6] 7 8 … 20  (0 = points de suspension)
    private IEnumerable<int> Fenetre()
    {
        var pages = new SortedSet<int> { 1, TotalPages };
        for (var p = Page - 2; p <= Page + 2; p++)
            if (p >= 1 && p <= TotalPages) pages.Add(p);

        var precedent = 0;
        foreach (var p in pages)
        {
            if (precedent != 0 && p - precedent > 1) yield return 0;
            yield return p;
            precedent = p;
        }
    }

    private async Task Aller(int page)
    {
        page = Math.Clamp(page, 1, TotalPages);
        if (page != Page) await OnPageChange.InvokeAsync(page);
    }

    private async Task ChangerTaille(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var taille) && taille > 0 && taille != PageSize)
            await OnPageSizeChange.InvokeAsync(taille);
    }
}
