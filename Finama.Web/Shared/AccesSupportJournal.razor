@inject ApiClient Api

@* Journal des accès du support Finama, sur la page « Mon entreprise » (administrateur). *@
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 border-bottom border-light">
        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-headset text-secondary me-2"></i>Accès du support Finama</h5>
    </div>
    <div class="card-body">
        <p class="small text-muted">Chaque fois que l'équipe Finama accède à votre espace pour vous aider, l'accès est enregistré ici : qui, quand, pourquoi et pour combien de temps.</p>
        @if (_lignes is null)
        {
            <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-secondary"></div></div>
        }
        else if (!_lignes.Any())
        {
            <div class="text-muted small"><i class="bi bi-shield-check text-success me-1"></i>Aucun accès du support à ce jour.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="small text-uppercase text-muted"><tr><th>Date</th><th>Par</th><th>Motif</th><th>Accès</th><th>Durée</th></tr></thead>
                    <tbody>
                        @foreach (var a in _lignes)
                        {
                            <tr>
                                <td class="text-nowrap small">@a.DateDebut.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="small">@a.SuperAdminNom</td>
                                <td class="small">@a.Motif</td>
                                <td>
                                    <span class="badge @(a.LectureSeule ? "bg-secondary bg-opacity-10 text-secondary" : "bg-warning bg-opacity-25 text-dark")">
                                        @(a.LectureSeule ? "Consultation" : "Modification autorisée")
                                    </span>
                                </td>
                                <td class="small text-nowrap">
                                    @if (a.EnCours)
                                    {
                                        <span class="text-warning fw-bold">En cours</span>
                                    }
                                    else
                                    {
                                        @Duree(a)
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<LigneAcces>? _lignes;

    protected override async Task OnInitializedAsync()
    {
        _lignes = (await Api.GetAsync<List<LigneAcces>>("api/entreprise/acces-support")).Donnees ?? new();
    }

    private static string Duree(LigneAcces a)
    {
        var fin = a.DateFin ?? a.DateExpiration;
        var d = fin - a.DateDebut;
        return d.TotalMinutes < 1 ? "< 1 min" : $"{(int)d.TotalMinutes} min";
    }

    private sealed record LigneAcces(Guid Id, string SuperAdminNom, string Motif, bool LectureSeule,
        DateTime DateDebut, DateTime DateExpiration, DateTime? DateFin, bool EnCours);
}
