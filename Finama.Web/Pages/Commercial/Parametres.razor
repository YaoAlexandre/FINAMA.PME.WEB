@page "/commerce/parametres"
@using Finama.Web
@using Finama.Web.Services
@inject CommerceApiService CommerceApi
@inject Radzen.NotificationService NotificationService
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="mb-4">
    <h3 class="fw-bold text-dark mb-1"><i class="bi bi-sliders text-success me-2"></i>Configuration du commerce</h3>
    <p class="text-muted small mb-0">Adaptez Finama Commerce à votre activité. Tout reste modifiable à tout moment.</p>
</div>

@if (_chargement)
{
    <div class="text-center py-5"><div class="spinner-border text-success"></div></div>
}
else
{
    <!-- ÉTAPE 1 : ACTIVITÉ -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-transparent py-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-shop-window me-2 text-primary"></i>1. Votre activité</h5>
            <div class="text-muted small">Choisissez le modèle le plus proche : il règle les options et crée des catégories types si votre catalogue est vide. Aucun n'est limitatif.</div>
        </div>
        <div class="card-body">
            <div class="row g-3">
                @foreach (var p in _profils)
                {
                    var actif = string.Equals(_parametres.Activite, p.Code, StringComparison.OrdinalIgnoreCase);
                    <div class="col-md-6 col-xl-4" @key="p.Code">
                        <div class="card h-100 @(actif ? "border-success border-2" : "border")">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div class="fw-bold">@p.Libelle</div>
                                    @if (actif) { <span class="badge bg-success">Actif</span> }
                                </div>
                                <div class="small text-muted mb-2">@p.Description</div>
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    @if (p.UtiliseLots) { <span class="badge bg-light text-dark border">Lots & péremption</span> }
                                    @if (p.UtiliseVrac) { <span class="badge bg-light text-dark border">Vente au poids</span> }
                                    @if (p.UtiliseLivres) { <span class="badge bg-light text-dark border">Livres</span> }
                                </div>
                                @if (p.CategoriesTypes.Any())
                                {
                                    <div class="small text-muted mb-2">Catégories : @string.Join(", ", p.CategoriesTypes)</div>
                                }
                                <div class="mt-auto">
                                    <button class="btn btn-sm @(actif ? "btn-outline-success" : "btn-success") w-100" disabled="@_enCours" @onclick="() => Appliquer(p)">
                                        @(actif ? "Réappliquer" : "Choisir ce modèle")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ÉTAPE 2 : OPTIONS -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-transparent py-3">
            <h5 class="fw-bold mb-0"><i class="bi bi-toggles me-2 text-primary"></i>2. Options</h5>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="fw-bold small text-uppercase text-muted mb-2">Catalogue & stock</div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="optLots" @bind="_parametres.UtiliseLots" />
                        <label class="form-check-label" for="optLots"><strong>Lots et dates de péremption</strong> <span class="text-muted small">— produits périssables, sortie du plus proche d'expirer (FEFO)</span></label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="optVrac" @bind="_parametres.UtiliseVrac" />
                        <label class="form-check-label" for="optVrac"><strong>Vente au poids / à la mesure</strong> <span class="text-muted small">— kg, litres, mètres</span></label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="optLivres" @bind="_parametres.UtiliseLivres" />
                        <label class="form-check-label" for="optLivres"><strong>Livres</strong> <span class="text-muted small">— ISBN, auteur, éditeurs</span></label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="optNeg" @bind="_parametres.AutoriserStockNegatif" />
                        <label class="form-check-label" for="optNeg"><strong>Autoriser la vente en stock négatif</strong> <span class="text-muted small">— utile si les entrées de stock sont saisies après la vente</span></label>
                    </div>

                    <label class="form-label fw-bold small">TVA proposée à la création d'un article (%)</label>
                    <input type="number" class="form-control font-monospace" style="max-width: 160px;" min="0" max="100" step="0.01" @bind="_parametres.TauxTvaDefaut" />
                    <div class="form-text">0 si votre entreprise n'est pas assujettie à la TVA.</div>
                </div>

                <div class="col-lg-6">
                    <div class="fw-bold small text-uppercase text-muted mb-2">Caisse & clients</div>

                    <label class="form-label fw-bold small">Préfixe des tickets</label>
                    <input type="text" class="form-control font-monospace mb-3" style="max-width: 160px;" maxlength="10" @bind="_parametres.PrefixeTicket" />

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small">Remise sans PIN jusqu'à (%)</label>
                            <input type="number" class="form-control font-monospace" min="0" max="100" step="0.5" @bind="_parametres.SeuilRemiseSansPinPourcent" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small">Remise maximale (%)</label>
                            <input type="number" class="form-control font-monospace" min="0" max="100" step="0.5" @bind="_parametres.RemiseMaxPourcent" />
                        </div>
                    </div>

                    <div class="fw-bold small text-uppercase text-muted mb-2">Fidélité client</div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label fw-bold small">1 point par tranche de (FCFA)</label>
                            <input type="number" class="form-control font-monospace" min="0" @bind="_parametres.MontantParPoint" />
                            <div class="form-text">0 = fidélité désactivée</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small">Valeur d'un point (FCFA)</label>
                            <input type="number" class="form-control font-monospace" min="0" @bind="_parametres.ValeurPointFcfa" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer bg-light text-end">
            <button class="btn btn-success fw-bold px-4" @onclick="Sauvegarder" disabled="@_enCours">
                @if (_enCours) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Enregistrer les options
            </button>
        </div>
    </div>

    <div class="alert alert-light border small">
        <i class="bi bi-lightbulb me-1"></i>
        <strong>Étape suivante :</strong> adaptez vos catégories et leurs champs (taille, marque, dosage...) dans
        <a href="/commerce/categories" @onclick:preventDefault @onclick='() => Nav.NavigateTo("/commerce/categories")'>Catégories</a>.
    </div>
}

<ConfirmDialog @ref="_confirm" />

@code {
    private ConfirmDialog _confirm = default!;
    private ParametresCommerceDto _parametres = new();
    private List<ProfilActiviteDto> _profils = new();
    private bool _chargement = true;
    private bool _enCours;

    protected override async Task OnInitializedAsync()
    {
        _profils = await CommerceApi.GetProfilsActiviteAsync();
        _parametres = await CommerceApi.GetParametresAsync() ?? new ParametresCommerceDto();
        if (CommerceApi.DerniereErreur != null) NotificationService.Erreur(CommerceApi.DerniereErreur, "Chargement");
        _chargement = false;
    }

    private async Task Appliquer(ProfilActiviteDto profil)
    {
        var detail = profil.CategoriesTypes.Any()
            ? "Les options (lots, poids, livres) seront réglées.\nLes catégories types ne sont créées que si votre catalogue n'a encore aucune catégorie : rien n'est écrasé."
            : "Les options (lots, poids, livres) seront réglées. Vos catégories ne changent pas.";
        if (!await _confirm.DemanderAsync(detail, $"Appliquer « {profil.Libelle} » ?", "Appliquer le modèle")) return;

        _enCours = true;
        try
        {
            var resultat = await CommerceApi.AppliquerProfilAsync(profil.Code);
            if (resultat == null)
            {
                NotificationService.Erreur(CommerceApi.DerniereErreur ?? "Erreur inconnue.", "Application impossible");
                return;
            }

            _parametres = resultat;
            NotificationService.Succes($"Modèle « {profil.Libelle} » appliqué.", "Activité configurée");
        }
        finally { _enCours = false; }
    }

    private async Task Sauvegarder()
    {
        _enCours = true;
        try
        {
            var resultat = await CommerceApi.SauvegarderParametresAsync(_parametres);
            if (resultat == null)
            {
                NotificationService.Erreur(CommerceApi.DerniereErreur ?? "Erreur inconnue.", "Enregistrement impossible");
                return;
            }

            _parametres = resultat;
            NotificationService.Succes("Les options ont été mises à jour.");
        }
        finally { _enCours = false; }
    }

}
