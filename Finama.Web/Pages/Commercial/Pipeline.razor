@page "/ventes/pipeline"
@page "/commercial/pipeline"
@using Finama.Web.Services
@inject VentesApiService Ventes
@inject NavigationManager Nav

<PageTitle>Pipeline — Finama</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-kanban text-info me-2"></i>Pipeline des devis</h3>
        <p class="text-muted small mb-0">Où en est chaque affaire. Cliquez sur une carte pour la faire avancer.</p>
    </div>
    <button class="btn btn-info text-white fw-bold" @onclick='() => Nav.NavigateTo("/ventes/devis/nouveau")'><i class="bi bi-plus-circle me-1"></i>Nouveau devis</button>
</div>

@if (_devis is null)
{
    <div class="text-center py-5"><div class="spinner-border text-info"></div></div>
}
else
{
    <div class="pipeline">
        @foreach (var col in Colonnes)
        {
            var cartes = _devis.Where(d => col.Statuts.Contains(d.Statut)).OrderByDescending(d => d.DateCreation).ToList();
            <div class="pipeline-col">
                <div class="pipeline-entete @col.Classe">
                    <span class="fw-bold">@col.Titre</span>
                    <span class="badge bg-white text-dark">@cartes.Count</span>
                </div>
                <div class="small text-muted px-2 mb-2 font-monospace">@cartes.Sum(d => d.TotalTTC).ToString("N0") F TTC</div>
                @foreach (var d in cartes.Take(30))
                {
                    <a class="pipeline-carte" href="/ventes/devis/@d.Id">
                        <div class="d-flex justify-content-between">
                            <strong class="text-truncate">@d.TiersNom</strong>
                            <span class="font-monospace small text-nowrap ms-2">@d.TotalTTC.ToString("N0")</span>
                        </div>
                        <div class="small text-muted text-truncate">@d.Libelle</div>
                        <div class="d-flex justify-content-between small mt-1">
                            <span class="font-monospace text-muted">@d.Numero</span>
                            @if (d.Statut == StatutDevisVm.Expire)
                            {
                                <span class="text-warning fw-bold">Expiré</span>
                            }
                            else if (d.Statut == StatutDevisVm.Envoye && d.DateExpiration is { } e && e.Date <= DateTime.Today.AddDays(7))
                            {
                                <span class="text-danger">jusqu'au @e.ToString("dd/MM")</span>
                            }
                            else if (!string.IsNullOrEmpty(d.FactureNumero))
                            {
                                <span class="font-monospace">@d.FactureNumero</span>
                            }
                        </div>
                    </a>
                }
                @if (cartes.Count > 30)
                {
                    <a class="small px-2" href="/ventes/devis?statut=@((int)col.Statuts[0])">+ @(cartes.Count - 30) autres</a>
                }
            </div>
        }
    </div>
}

<style>
    .pipeline { display: grid; grid-template-columns: repeat(5, minmax(220px, 1fr)); gap: 12px; overflow-x: auto; padding-bottom: 8px; }
    .pipeline-col { background: var(--bs-tertiary-bg, #f1f3f5); border-radius: 12px; padding: 8px; min-height: 200px; }
    .pipeline-entete { display: flex; justify-content: space-between; align-items: center; padding: 8px 10px; border-radius: 8px; margin-bottom: 6px; }
    .pipeline-carte { display: block; background: var(--bs-body-bg, #fff); border-radius: 10px; padding: 10px; margin-bottom: 8px;
                      text-decoration: none; color: inherit; box-shadow: 0 1px 2px rgba(0,0,0,.08); }
    .pipeline-carte:hover { box-shadow: 0 4px 12px rgba(0,0,0,.12); }
</style>

@code {
    private List<DevisResumeVm>? _devis;

    private sealed record Colonne(string Titre, string Classe, StatutDevisVm[] Statuts);

    private static readonly Colonne[] Colonnes =
    [
        new("Brouillons", "bg-secondary bg-opacity-25", [StatutDevisVm.Brouillon]),
        new("Envoyés", "bg-primary bg-opacity-25", [StatutDevisVm.Envoye, StatutDevisVm.Expire]),
        new("Acceptés", "bg-success bg-opacity-25", [StatutDevisVm.Accepte]),
        new("Facturés", "bg-dark bg-opacity-25", [StatutDevisVm.Converti]),
        new("Perdus", "bg-danger bg-opacity-25", [StatutDevisVm.Refuse]),
    ];

    protected override async Task OnInitializedAsync()
        => _devis = await Ventes.ListerDevisAsync() ?? new();
}
