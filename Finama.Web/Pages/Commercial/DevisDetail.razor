@page "/commercial/devis/{Id:guid}"
@using Finama.Web.Models
@using Finama.Web.Services
@inject DevisApiService Api
@inject NavigationManager Nav

<div class="page-wrapper position-relative mb-5">

    @if (!string.IsNullOrEmpty(_messageErreur))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_messageErreur
            <button type="button" class="btn-close" @onclick="() => _messageErreur = null"></button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (_devis != null)
    {
        <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h2 class="page-title mb-0">Devis @_devis.Numero</h2>
                    @BadgeStatut(_devis.StatutLibelle)
                </div>
                <p class="page-subtitle text-muted mb-0">@_devis.Libelle</p>
            </div>

            <div class="d-flex flex-wrap gap-2">
                @if (_devis.Statut == StatutDevis.Brouillon)
                {
                    <button class="btn btn-light border shadow-sm px-3" @onclick="() => AllerModifier()">
                        <i class="bi bi-pencil me-2 text-secondary"></i>Modifier
                    </button>
                    <button class="btn btn-primary shadow-sm px-3" @onclick="() => ChangerStatut(StatutDevis.Envoye)">
                        <i class="bi bi-send me-2"></i>Marquer Envoyé
                    </button>
                }
                @if (_devis.Statut == StatutDevis.Envoye)
                {
                    <button class="btn btn-success shadow-sm px-3" @onclick="() => ChangerStatut(StatutDevis.Accepte)">
                        <i class="bi bi-check-lg me-2"></i>Accepter
                    </button>
                    <button class="btn btn-outline-danger shadow-sm px-3" @onclick="() => ChangerStatut(StatutDevis.Refuse)">
                        <i class="bi bi-x-lg me-2"></i>Refuser
                    </button>
                }
                @if (_devis.Statut == StatutDevis.Accepte)
                {
                    <button class="btn btn-info text-dark fw-bold shadow-sm px-3" @onclick="ConvertirEnFacture" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-arrow-up me-2"></i>
                        }
                        Convertir en Facture
                    </button>
                }
                <button class="btn btn-light border shadow-sm px-3" @onclick="() => AllerRetour()">
                    <i class="bi bi-arrow-left me-2"></i>Retour
                </button>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="row g-4 text-start">
                    <div class="col-sm-6 col-md-4">
                        <span class="text-muted small d-block text-uppercase font-monospace mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Destinataire / Client</span>
                        <div class="fw-bold fs-6 text-dark">
                            <i class="bi bi-building me-2 text-secondary"></i>@_devis.TiersNom
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <span class="text-muted small d-block text-uppercase font-monospace mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Date d'émission</span>
                        <div class="fw-semibold text-secondary">
                            <i class="bi bi-calendar-event me-2"></i>@_devis.DateCreation.ToString("dd MMMM yyyy")
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <span class="text-muted small d-block text-uppercase font-monospace mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Date de validité</span>
                        <div class="fw-semibold text-secondary">
                            <i class="bi bi-calendar-x me-2"></i>@(_devis.DateExpiration.HasValue? _devis.DateExpiration.Value.ToString("dd MMMM yyyy") : "—")
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_devis.Notes))
                {
                    <div class="mt-4 pt-3 border-top border-light">
                        <span class="text-muted small d-block text-uppercase font-monospace mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Notes & Mentions</span>
                        <div class="text-muted bg-light p-3 rounded-3 fst-italic" style="font-size: 0.9rem;">
                            @_devis.Notes
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                            <tr>
                                <th class="ps-4">Description de la prestation / article</th>
                                <th class="text-end" style="width: 140px">Quantité</th>
                                <th class="text-end" style="width: 180px">Prix unitaire HT</th>
                                <th class="text-center" style="width: 120px">TVA</th>
                                <th class="text-end pe-4" style="width: 200px">Total TTC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in _devis.Lignes)
                            {
                                <tr class="border-bottom border-light">
                                    <td class="ps-4 fw-medium text-dark">@l.Designation</td>
                                    <td class="text-end font-monospace">@l.Quantite.ToString("N2")</td>
                                    <td class="text-end font-monospace">@l.PrixUnitaireHT.ToString("N0") XOF</td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@l.TauxTVA %</span>
                                    </td>
                                    <td class="text-end fw-bold font-monospace pe-4 text-dark">
                                        @((l.Quantite * l.PrixUnitaireHT * (1 + l.TauxTVA / 100)).ToString("N0")) XOF
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row m-0 border-top border-light bg-light-subtle py-4 pe-4 justify-content-end">
                    <div class="col-md-5 col-lg-4">
                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom border-light-subtle">
                            <span class="text-muted small">Total Hors Taxes :</span>
                            <span class="fw-semibold text-secondary">@_devis.TotalHT.ToString("N0") XOF</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 pb-2 border-bottom border-light-subtle">
                            <span class="text-muted small">Montant TVA :</span>
                            <span class="fw-semibold text-warning">@_devis.TotalTVA.ToString("N0") XOF</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-dark fw-bold" style="font-size: 0.95rem;">Montant global TTC :</span>
                            <span class="fw-bold fs-5 text-primary">@_devis.TotalTTC.ToString("N0") XOF</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private DevisDto? _devis;
    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private string? _messageErreur;

    private void AllerRetour() => Nav.NavigateTo("/commercial/pipeline"); // Redirection harmonisée vers le Kanban
    private void AllerModifier() => Nav.NavigateTo($"/commercial/devis/{Id}/modifier");

    protected override async Task OnInitializedAsync()
    {
        await ChargerDevis();
    }

    private async Task ChargerDevis()
    {
        try
        {
            _devis = await Api.GetDevisAsync(Id);
        }
        catch (Exception)
        {
            _messageErreur = "Impossible de récupérer les détails du document.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ChangerStatut(StatutDevis statut)
    {
        try
        {
            await Api.MettreAJourStatutDevisAsync(Id, statut);
            await ChargerDevis();
        }
        catch (Exception)
        {
            _messageErreur = "Échec lors de la mise à jour du statut du devis.";
        }
    }

    private async Task ConvertirEnFacture()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        try
        {
            var factureId = await Api.ConvertirDevisEnFactureAsync(Id);
            if (factureId.HasValue)
                Nav.NavigateTo($"/commercial/reglements"); // Redirection vers le flux comptable / règlements
            else
                _messageErreur = "Le serveur n'a renvoyé aucun identifiant pour la nouvelle facture.";
        }
        catch (Exception ex)
        {
            _messageErreur = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private RenderFragment BadgeStatut(string statut) => statut switch
    {
        "Brouillon" => @<span class="badge bg-secondary-subtle text-secondary border px-2.5 py-1" style="font-size:0.8rem;">Brouillon</span>,
        "Envoyé" => @<span class="badge bg-info-subtle text-info border px-2.5 py-1" style="font-size:0.8rem;">Envoyé</span>,
        "Accepté" => @<span class="badge bg-success-subtle text-success border px-2.5 py-1" style="font-size:0.8rem;">Accepté</span>,
        "Refusé" => @<span class="badge bg-danger-subtle text-danger border px-2.5 py-1" style="font-size:0.8rem;">Refusé</span>,
        "Expiré" => @<span class="badge bg-warning-subtle text-warning border px-2.5 py-1" style="font-size:0.8rem;">Expiré</span>,
        "Converti" => @<span class="badge bg-primary-subtle text-primary border px-2.5 py-1" style="font-size:0.8rem;">Converti</span>,
        _ => @<span class="badge bg-light text-dark border px-2.5 py-1" style="font-size:0.8rem;">@statut</span>
    };
}