@page "/commerce/produits"
@using Finama.Web
@using Finama.Web.Services
@inject CommerceApiService CommerceApi
@inject Radzen.NotificationService NotificationService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-box-seam text-success me-2"></i>Articles & Services</h3>
        <p class="text-muted small mb-0">Votre catalogue : produits, articles au poids, services@(_parametres.UtiliseLivres ? ", livres" : "")</p>
    </div>
    <button class="btn btn-success fw-bold px-3 py-2 rounded-3 shadow-sm d-flex align-items-center gap-2" @onclick="OuvrirModalNouveauProduit">
        <i class="bi bi-plus-circle fs-6"></i>
        <span>Nouvel article</span>
    </button>
</div>

@if (string.IsNullOrWhiteSpace(_parametres.Activite))
{
    <div class="alert alert-info d-flex justify-content-between align-items-center shadow-sm">
        <div><i class="bi bi-magic me-2"></i><strong>Configurez votre activité</strong> en 1 minute : catégories types, champs adaptés à votre métier, options de stock.</div>
        <button class="btn btn-sm btn-info text-white fw-bold" @onclick='() => Nav.NavigateTo("/commerce/parametres")'>Configurer</button>
    </div>
}

<!-- RECHERCHE ET FILTRES -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <div class="row g-3">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace" @bind="_nouveauProduit.CodeBarres" placeholder="Facultatif" />
                        <button class="btn btn-outline-success" type="button" title="Scanner avec la caméra" @onclick="() => _scannerCode.OuvrirAsync()">
                            <i class="bi bi-camera"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select bg-light" @bind="_categorieFiltre" @bind:after="SurFiltre">
                    <option value="">Toutes les catégories</option>
                    @foreach (var c in _categories)
                    {
                        <option value="@c.Id">@CheminCategorie(c)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select bg-light" @bind="_typeFiltre" @bind:after="SurFiltre">
                    <option value="">Tous types</option>
                    <option value="0">Articles</option>
                    @if (_parametres.UtiliseVrac) { <option value="1">Au poids / mesure</option> }
                    @if (_parametres.UtiliseLivres) { <option value="2">Livres</option> }
                    <option value="3">Services</option>
                </select>
            </div>
            <div class="col-md-2 text-end d-flex align-items-center justify-content-end">
                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-2 font-monospace">@_produitsFiltres.Count article(s)</span>
            </div>
        </div>
    </div>
</div>

<!-- TABLEAU -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light small text-uppercase">
                    <tr>
                        <th class="ps-4">Code</th>
                        <th>Désignation & caractéristiques</th>
                        <th>Catégorie</th>
                        <th class="text-end">Prix achat</th>
                        <th class="text-end">Prix vente TTC</th>
                        <th class="text-center">Stock</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_chargement)
                    {
                        <tr><td colspan="7" class="text-center py-5"><div class="spinner-border text-success"></div></td></tr>
                    }
                    else if (!_produitsFiltres.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted"><i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>Aucun article. Créez le premier avec « Nouvel article ».</td></tr>
                    }
                    else
                    {
                        @foreach (var p in _produitsFiltres.Page(_page, _taillePage))
                        {
                            <tr @key="p.Id" class="@(p.EstActif ? "" : "text-muted")">
                                <td class="ps-4 font-monospace small fw-bold">@(p.CodeBarres ?? p.Isbn ?? p.Reference)</td>
                                <td>
                                    <div class="fw-bold text-dark">
                                        @p.Designation
                                        @if (!p.EstActif) { <span class="badge bg-secondary ms-1">Inactif</span> }
                                        @if (p.EstService) { <span class="badge bg-primary bg-opacity-10 text-primary ms-1">Service</span> }
                                        @if (p.EstVrac) { <span class="badge bg-warning bg-opacity-25 text-dark ms-1">Au poids</span> }
                                        @if (p.IsLivre) { <span class="badge bg-info bg-opacity-10 text-info ms-1"><i class="bi bi-book"></i></span> }
                                    </div>
                                    @if (p.IsLivre && !string.IsNullOrEmpty(p.Auteur))
                                    {
                                        <div class="text-muted small">@p.Auteur@(string.IsNullOrEmpty(p.Editeur) ? "" : $" · {p.Editeur}")</div>
                                    }
                                    @if (p.Attributs.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                            @foreach (var a in p.Attributs)
                                            {
                                                <span class="badge bg-light text-dark border font-monospace" style="font-size: 0.7rem;">@a.Key : @a.Value</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="small">@(p.CategorieNom ?? "—")</td>
                                <td class="text-end font-monospace">@p.PrixAchat.ToString("N0")</td>
                                <td class="text-end font-monospace fw-bold text-success">@p.PrixVenteTtc.ToString("N0")</td>
                                <td class="text-center">
                                    @if (!p.GereStock)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="badge @(p.StockActuel <= p.StockAlerte ? "bg-danger" : "bg-success") rounded-pill font-monospace px-3">@p.StockActuel.ToString("0.###")</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-success me-1" title="Modifier" @onclick="() => EditerProduit(p)"><i class="bi bi-pencil"></i></button>
                                    @if (p.EstActif)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" title="Désactiver" @onclick="() => Desactiver(p)"><i class="bi bi-slash-circle"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <Pager @bind-Page="_page" @bind-PageSize="_taillePage" TotalItems="_produitsFiltres.Count" />
    </div>
</div>

<!-- MODALE ARTICLE -->
@if (_afficherModalAjout)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.5); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-box-seam me-2"></i>@(_produitEnCoursId == Guid.Empty ? "Nouvel article" : "Modifier l'article")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FermerModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small">Désignation *</label>
                            <input type="text" class="form-control" @bind="_nouveauProduit.Designation" placeholder="Nom de l'article ou du service" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Type</label>
                            <select class="form-select" @bind="_nouveauProduit.Type" @bind:after="SurChangementType">
                                @foreach (var t in TypesDisponibles())
                                {
                                    <option value="@t.Valeur">@t.Libelle</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Catégorie</label>
                            <select class="form-select" @bind="_nouveauProduit.CategorieId">
                                <option value="">— Sans catégorie —</option>
                                @foreach (var c in _categories)
                                {
                                    <option value="@c.Id">@CheminCategorie(c)</option>
                                }
                            </select>
                        </div>

                        @if (_nouveauProduit.Type == 1 || _nouveauProduit.Type == 3)
                        {
                            <div class="col-md-3">
                                <label class="form-label fw-bold small">Unité de vente</label>
                                <select class="form-select" @bind="_nouveauProduit.Unite">
                                    @if (_nouveauProduit.Type == 1)
                                    {
                                        <option value="1">Kilogramme</option>
                                        <option value="2">Gramme</option>
                                        <option value="3">Litre</option>
                                        <option value="4">Mètre</option>
                                    }
                                    else
                                    {
                                        <option value="5">Heure</option>
                                        <option value="0">Forfait / pièce</option>
                                    }
                                </select>
                            </div>
                        }

                        <div class="col-md-@(_nouveauProduit.Type == 1 || _nouveauProduit.Type == 3 ? "3" : "6")">
                            <label class="form-label fw-bold small">Code-barres</label>
                            <input type="text" class="form-control font-monospace" @bind="_nouveauProduit.CodeBarres" placeholder="Facultatif" />
                        </div>

                        @if (_nouveauProduit.Type == 2)
                        {
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">ISBN-13</label>
                                <input type="text" class="form-control font-monospace" @bind="_nouveauProduit.Isbn" placeholder="978-..." />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Auteur</label>
                                <input type="text" class="form-control" @bind="_nouveauProduit.Auteur" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Éditeur</label>
                                <select class="form-select" @bind="_nouveauProduit.EditeurId">
                                    <option value="">— Non renseigné —</option>
                                    @foreach (var e in _editeurs.Where(x => x.EstActif || x.Id == _nouveauProduit.EditeurId))
                                    {
                                        <option value="@e.Id">@e.Nom</option>
                                    }
                                </select>
                            </div>
                        }

                        <!-- CHAMPS PERSONNALISÉS DE LA CATÉGORIE -->
                        @foreach (var champ in ChampsEffectifs(_nouveauProduit.CategorieId))
                        {
                            <div class="col-md-4" @key="champ.Nom">
                                <label class="form-label fw-bold small">@champ.Nom@(champ.Obligatoire ? " *" : "")</label>
                                @if (champ.Type == "liste")
                                {
                                    <select class="form-select" value="@ValeurChamp(champ.Nom)" @onchange="e => DefinirChamp(champ.Nom, e.Value?.ToString())">
                                        <option value="">—</option>
                                        @foreach (var o in champ.Options ?? new List<string>())
                                        {
                                            <option value="@o">@o</option>
                                        }
                                    </select>
                                }
                                else if (champ.Type == "nombre")
                                {
                                    <input type="number" step="any" class="form-control font-monospace" value="@ValeurChamp(champ.Nom)" @onchange="e => DefinirChamp(champ.Nom, e.Value?.ToString())" />
                                }
                                else if (champ.Type == "date")
                                {
                                    <input type="date" class="form-control font-monospace" value="@ValeurChamp(champ.Nom)" @onchange="e => DefinirChamp(champ.Nom, e.Value?.ToString())" />
                                }
                                else
                                {
                                    <input type="text" class="form-control" value="@ValeurChamp(champ.Nom)" @onchange="e => DefinirChamp(champ.Nom, e.Value?.ToString())" />
                                }
                            </div>
                        }

                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Prix d'achat (FCFA)</label>
                            <input type="number" class="form-control font-monospace" @bind="_nouveauProduit.PrixAchat" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Prix de vente TTC (FCFA) *</label>
                            <input type="number" class="form-control font-monospace" @bind="_nouveauProduit.PrixVenteTtc" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">TVA (%)</label>
                            <input type="number" class="form-control font-monospace" @bind="_nouveauProduit.TauxTva" />
                        </div>

                        @if (_nouveauProduit.Type != 3)
                        {
                            <div class="col-md-4">
                                <label class="form-label fw-bold small">Seuil d'alerte stock</label>
                                <input type="number" class="form-control font-monospace" @bind="_nouveauProduit.StockAlerte" />
                            </div>
                            @if (_parametres.UtiliseLots || _nouveauProduit.SuiviLots)
                            {
                                <div class="col-md-8 d-flex align-items-end">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="suiviLots" @bind="_nouveauProduit.SuiviLots" />
                                        <label class="form-check-label small fw-bold" for="suiviLots">Suivi par lots et dates de péremption</label>
                                    </div>
                                </div>
                            }
                        }

                        <div class="col-12">
                            <label class="form-label fw-bold small">Description</label>
                            <input type="text" class="form-control" @bind="_nouveauProduit.Description" placeholder="Facultatif" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light px-4" @onclick="FermerModal">Annuler</button>
                    <button type="button" class="btn btn-success px-4 fw-bold" @onclick="EnregistrerProduit" disabled="@_enCoursEnregistrement">
                        @if (_enCoursEnregistrement) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Enregistrer
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDialog @ref="_confirm" />
<ScannerCamera @ref="_scannerCode" OnCode="@(c => _nouveauProduit.CodeBarres = c)" Titre="Scanner le code-barres du produit" />
@code {
    private ScannerCamera _scannerCode = default!;
    private ConfirmDialog _confirm = default!;
    private List<ProduitCommerceDto> _produits = new();
    private List<ProduitCommerceDto> _produitsFiltres = new();
    private List<CategorieCommerceDto> _categories = new();
    private List<EditeurCommerceDto> _editeurs = new();
    private ParametresCommerceDto _parametres = new();
    private bool _chargement = true;
    private int _page = 1;
    private int _taillePage = 20;
    private bool _afficherModalAjout;
    private bool _enCoursEnregistrement;
    private string _recherche = "";
    private string _typeFiltre = "";
    private string _categorieFiltre = "";
    private Guid _produitEnCoursId = Guid.Empty;
    private ProduitCommerceDto _nouveauProduit = new();

    protected override async Task OnInitializedAsync()
    {
        _parametres = await CommerceApi.GetParametresAsync() ?? new ParametresCommerceDto();
        _categories = await CommerceApi.GetCategoriesAsync();
        if (_parametres.UtiliseLivres) _editeurs = await CommerceApi.GetEditeursAsync();
        await ChargerProduits();
    }

    private async Task ChargerProduits()
    {
        _chargement = true;
        _produits = await CommerceApi.GetProduitsAsync();
        if (CommerceApi.DerniereErreur != null) NotificationService.Erreur(CommerceApi.DerniereErreur, "Chargement");
        FiltrerProduits();
        _chargement = false;
    }

    private void FiltrerProduits()
    {
        var q = (_recherche ?? "").Trim();
        Guid.TryParse(_categorieFiltre, out var catId);
        var idsCategorie = catId == Guid.Empty ? null : DescendantsEtSoi(catId);

        _produitsFiltres = _produits.Where(p =>
            (string.IsNullOrEmpty(q)
                || p.Designation.Contains(q, StringComparison.OrdinalIgnoreCase)
                || p.Reference.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (p.CodeBarres != null && p.CodeBarres.Contains(q, StringComparison.OrdinalIgnoreCase))
                || (p.Isbn != null && p.Isbn.Contains(q, StringComparison.OrdinalIgnoreCase))
                || p.Attributs.Values.Any(v => v.Contains(q, StringComparison.OrdinalIgnoreCase)))
            && (idsCategorie == null || (p.CategorieId.HasValue && idsCategorie.Contains(p.CategorieId.Value)))
            && (string.IsNullOrEmpty(_typeFiltre) || p.Type.ToString() == _typeFiltre)
        ).ToList();

        _page = PagingExtensions.PageValide(_page, _produitsFiltres.Count, _taillePage);
    }

    // Changement de recherche ou de filtre par l'utilisateur : retour à la première page.
    private void SurFiltre()
    {
        _page = 1;
        FiltrerProduits();
    }

    // ── Catégories & champs personnalisés ──
    private string CheminCategorie(CategorieCommerceDto c)
    {
        var chemin = c.Libelle;
        var courant = c;
        var garde = 0;
        while (courant.ParentId.HasValue && garde++ < 10)
        {
            var parent = _categories.FirstOrDefault(x => x.Id == courant.ParentId.Value);
            if (parent == null) break;
            chemin = $"{parent.Libelle} › {chemin}";
            courant = parent;
        }
        return chemin;
    }

    private HashSet<Guid> DescendantsEtSoi(Guid id)
    {
        var resultat = new HashSet<Guid> { id };
        var file = new Queue<Guid>();
        file.Enqueue(id);
        while (file.Count > 0)
        {
            var courant = file.Dequeue();
            foreach (var enfant in _categories.Where(c => c.ParentId == courant))
                if (resultat.Add(enfant.Id)) file.Enqueue(enfant.Id);
        }
        return resultat;
    }

    /// <summary>Champs de la catégorie + ceux de ses parents (la catégorie fille l'emporte).</summary>
    private List<ChampPersonnaliseDto> ChampsEffectifs(Guid? categorieId)
    {
        var chaine = new List<CategorieCommerceDto>();
        var courant = categorieId;
        var garde = 0;
        while (courant.HasValue && garde++ < 10)
        {
            var cat = _categories.FirstOrDefault(c => c.Id == courant.Value);
            if (cat == null) break;
            chaine.Add(cat);
            courant = cat.ParentId;
        }

        chaine.Reverse();
        var resultat = new Dictionary<string, ChampPersonnaliseDto>(StringComparer.OrdinalIgnoreCase);
        foreach (var cat in chaine)
            foreach (var champ in cat.Champs)
                resultat[champ.Nom] = champ;
        return resultat.Values.ToList();
    }

    private string ValeurChamp(string nom)
        => _nouveauProduit.Attributs.TryGetValue(nom, out var v) ? v : "";

    private void DefinirChamp(string nom, string? valeur)
    {
        if (string.IsNullOrWhiteSpace(valeur)) _nouveauProduit.Attributs.Remove(nom);
        else _nouveauProduit.Attributs[nom] = valeur.Trim();
    }

    // ── Types ──
    private List<(int Valeur, string Libelle)> TypesDisponibles()
    {
        var liste = new List<(int, string)> { (0, "Article (à l'unité)") };
        if (_parametres.UtiliseVrac || _nouveauProduit.Type == 1) liste.Add((1, "Vendu au poids / à la mesure"));
        if (_parametres.UtiliseLivres || _nouveauProduit.Type == 2) liste.Add((2, "Livre"));
        liste.Add((3, "Service (sans stock)"));
        return liste;
    }

    private void SurChangementType()
    {
        switch (_nouveauProduit.Type)
        {
            case 1: _nouveauProduit.Unite = _nouveauProduit.Unite is >= 1 and <= 4 ? _nouveauProduit.Unite : 1; break;
            case 3: _nouveauProduit.Unite = _nouveauProduit.Unite is 0 or 5 ? _nouveauProduit.Unite : 5; _nouveauProduit.SuiviLots = false; break;
            default: _nouveauProduit.Unite = 0; break;
        }
    }

    // ── Modale ──
    private void OuvrirModalNouveauProduit()
    {
        _produitEnCoursId = Guid.Empty;
        _nouveauProduit = new ProduitCommerceDto
        {
            StockAlerte = 0,
            TauxTva = _parametres.TauxTvaDefaut,
            SuiviLots = _parametres.UtiliseLots,
            Reference = $"REF-{DateTime.Now:yyyyMMdd}-{Random.Shared.Next(1000, 9999)}"
        };
        _afficherModalAjout = true;
    }

    private void EditerProduit(ProduitCommerceDto p)
    {
        _produitEnCoursId = p.Id;
        _nouveauProduit = new ProduitCommerceDto
        {
            Id = p.Id, Reference = p.Reference, Libelle = p.Libelle, Description = p.Description,
            Type = p.Type, Unite = p.Unite, CategorieId = p.CategorieId,
            PrixAchat = p.PrixAchat, PrixVenteTTC = p.PrixVenteTTC, TauxTva = p.TauxTva,
            SeuilReappro = p.SeuilReappro, SuiviLots = p.SuiviLots, CodeBarres = p.CodeBarres,
            Isbn = p.Isbn, Auteur = p.Auteur, EditeurId = p.EditeurId,
            Attributs = new Dictionary<string, string>(p.Attributs)
        };
        _afficherModalAjout = true;
    }

    private void FermerModal() => _afficherModalAjout = false;

    private async Task EnregistrerProduit()
    {
        if (string.IsNullOrWhiteSpace(_nouveauProduit.Libelle) || _nouveauProduit.PrixVenteTTC <= 0)
        {
            NotificationService.Avertir("Renseignez la désignation et un prix de vente valide.", "Champs requis");
            return;
        }

        var manquant = ChampsEffectifs(_nouveauProduit.CategorieId)
            .FirstOrDefault(c => c.Obligatoire && string.IsNullOrWhiteSpace(ValeurChamp(c.Nom)));
        if (manquant != null)
        {
            NotificationService.Avertir($"Le champ « {manquant.Nom} » est obligatoire pour cette catégorie.", "Champ requis");
            return;
        }

        _enCoursEnregistrement = true;
        try
        {
            var succes = _produitEnCoursId == Guid.Empty
                ? await CommerceApi.CreerProduitAsync(_nouveauProduit)
                : await CommerceApi.ModifierProduitAsync(_produitEnCoursId, _nouveauProduit);

            if (!succes)
            {
                NotificationService.Erreur(CommerceApi.DerniereErreur ?? "Erreur inconnue.", "Enregistrement impossible");
                return;
            }

            NotificationService.Succes(_produitEnCoursId == Guid.Empty ? "Article ajouté." : "Article mis à jour.");
            _afficherModalAjout = false;
            await ChargerProduits();
        }
        finally
        {
            _enCoursEnregistrement = false;
        }
    }

    private async Task Desactiver(ProduitCommerceDto p)
    {
        if (!await _confirm.DemanderAsync(
                $"« {p.Designation} » n'apparaîtra plus en caisse ni dans les listes de vente.\nL'historique des ventes et du stock est conservé.",
                "Désactiver cet article ?", "Désactiver", type: ConfirmationType.Danger)) return;

        if (!await CommerceApi.DesactiverProduitAsync(p.Id))
        {
            NotificationService.Erreur(CommerceApi.DerniereErreur ?? "Opération impossible.");
            return;
        }
        await ChargerProduits();
    }

}
