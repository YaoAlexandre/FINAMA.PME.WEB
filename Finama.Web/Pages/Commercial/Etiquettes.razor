@page "/commerce/etiquettes"
@using Finama.Web.Services
@attribute [Authorize(Policy = "Commercial")]
@implements IAsyncDisposable
@inject ICatalogueService CatalogueApi
@inject ErreursCommerce ErreurCommerce
@inject ApiClient Api
@inject IJSRuntime JS
@inject NotificationService NotificationService

<PageTitle>Étiquettes — Finama</PageTitle>

<div class="no-print">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1"><i class="bi bi-upc-scan text-success me-2"></i>Étiquettes & codes-barres</h3>
            <p class="text-muted small mb-0">Générez un code pour les articles qui n'en ont pas, puis imprimez les étiquettes à coller en rayon</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-success fw-bold" @onclick="GenererCodesManquants" disabled="@(_enCours || NbSelectionSansCode == 0)"
                    title="Attribue un code-barres interne (EAN-13 commençant par 20) aux articles sélectionnés qui n'en ont pas">
                @if (_enCours) { <span class="spinner-border spinner-border-sm me-1"></span> } else { <i class="bi bi-magic me-1"></i> }
                Générer les codes manquants (@NbSelectionSansCode)
            </button>
            <button class="btn btn-success fw-bold" @onclick="Imprimer" disabled="@(_enCours || NbEtiquettes == 0)">
                <i class="bi bi-printer me-1"></i>Imprimer @NbEtiquettes étiquette(s)
            </button>
        </div>
    </div>

    <!-- OPTIONS -->
    <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="card-body row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold">Rechercher</label>
                <input type="text" class="form-control" placeholder="Nom, référence, code…" @bind="_recherche" @bind:event="oninput" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">Format</label>
                <select class="form-select" @bind="_format">
                    <option value="A4">A4 — 21 étiquettes (63,5 × 38,1 mm)</option>
                    <option value="R5030">Rouleau 50 × 30 mm</option>
                    <option value="R4025">Rouleau 40 × 25 mm</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Code imprimé</label>
                <select class="form-select" @bind="_typeCode">
                    <option value="AUTO">Automatique</option>
                    <option value="QR">QR code</option>
                </select>
            </div>
            <div class="col-md-3 d-flex flex-wrap gap-3">
                <div class="form-check"><input class="form-check-input" type="checkbox" id="aff-prix" @bind="_afficherPrix" /><label class="form-check-label small" for="aff-prix">Prix</label></div>
                <div class="form-check"><input class="form-check-input" type="checkbox" id="sans-code" @bind="_seulementSansCode" /><label class="form-check-label small" for="sans-code">Sans code uniquement</label></div>
            </div>
        </div>
        <div class="card-footer bg-transparent small text-muted">
            <i class="bi bi-info-circle me-1"></i>
            <strong>Automatique</strong> : code-barres classique si l'article a un EAN-13, sinon QR code (référence de l'article).
            Les deux se lisent en caisse, à la douchette 2D comme à la caméra.
        </div>
    </div>

    <!-- LISTE -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light small text-uppercase">
                    <tr>
                        <th class="ps-3" style="width:40px;">
                            <input class="form-check-input" type="checkbox" checked="@ToutSelectionne" @onchange="BasculerTout" title="Tout sélectionner" />
                        </th>
                        <th>Article</th>
                        <th>Code</th>
                        <th class="text-end">Prix TTC</th>
                        <th class="text-center" style="width:130px;">Nb étiquettes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_chargement)
                    {
                        <tr><td colspan="5" class="text-center py-5"><div class="spinner-border text-success"></div></td></tr>
                    }
                    else if (!Filtres.Any())
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted">Aucun article.</td></tr>
                    }
                    else
                    {
                        @foreach (var a in Filtres)
                        {
                            var codeArticle = CodeDe(a);
                            <tr @key="a.Id">
                                <td class="ps-3"><input class="form-check-input" type="checkbox" checked="@_selection.ContainsKey(a.Id)" @onchange="e => Basculer(a, e)" /></td>
                                <td>
                                    <div class="fw-bold">@a.Libelle</div>
                                    <span class="small text-muted">@a.CategorieNom</span>
                                </td>
                                <td class="font-monospace small">
                                    @if (!string.IsNullOrWhiteSpace(a.CodeBarres))
                                    {
                                        <span>@a.CodeBarres</span>
                                        @if (CodeBarresSvg.EstEan13(a.CodeBarres)) { <span class="badge bg-success bg-opacity-10 text-success ms-1">EAN-13</span> }
                                    }
                                    else
                                    {
                                        <span class="text-warning"><i class="bi bi-exclamation-circle me-1"></i>aucun</span>
                                        <span class="text-muted d-block">QR : @codeArticle</span>
                                    }
                                </td>
                                <td class="text-end font-monospace text-nowrap">@a.PrixVenteTTC.ToString("N0") F@(UniteSuffixe(a))</td>
                                <td class="text-center">
                                    @if (_selection.TryGetValue(a.Id, out var nb))
                                    {
                                        <input type="number" min="1" max="200" class="form-control form-control-sm text-center" value="@nb"
                                               @onchange="e => ChangerNombre(a.Id, e.Value)" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- PLANCHE IMPRIMÉE -->
<div class="planche planche-@_format">
    @foreach (var (article, index) in EtiquettesAImprimer.Select((a, i) => (a, i)))
    {
        var codeEtiquette = CodeDe(article);
        var ean = _typeCode == "AUTO" ? CodeBarresSvg.Ean13(codeEtiquette) : null;
        <div class="etiquette" @key="index">
            <div class="etq-nom">@article.Libelle</div>
            <div class="etq-code @(ean is null ? "etq-qr" : "")">
                @if (ean is not null)
                {
                    @((MarkupString)ean)
                }
                else if (_qr.TryGetValue(codeEtiquette, out var svg))
                {
                    @((MarkupString)svg)
                    <div class="etq-texte-code">@codeEtiquette</div>
                }
            </div>
            @if (_afficherPrix)
            {
                <div class="etq-prix">@article.PrixVenteTTC.ToString("N0") F@(UniteSuffixe(article))</div>
            }
        </div>
    }
</div>

<style>
    .planche { display: none; }

    @@media print {
        .no-print, .sidebar, .topbar, .rz-notification { display: none !important; }
        .main-content, .page-wrapper { margin: 0 !important; padding: 0 !important; width: auto !important; }
        .planche { display: grid !important; }
        @@page { size: @TaillePage; margin: @MargePage; }

        .etiquette {
            box-sizing: border-box;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            text-align: center;
            font-family: Arial, Helvetica, sans-serif;
            color: #000;
            break-inside: avoid;
        }

        .etq-nom { font-weight: 700; line-height: 1.1; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; width: 100%; }
        .etq-code { flex: 1 1 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-height: 0; }
        .etq-code svg { max-width: 100%; max-height: 100%; }
        .etq-qr svg { height: 100%; width: auto; aspect-ratio: 1 / 1; }
        .etq-texte-code { font-family: "Courier New", monospace; }
        .etq-prix { font-weight: 800; }

        /* A4 type Avery L7160 : 3 × 7, 63,5 × 38,1 mm */
        .planche-A4 { grid-template-columns: repeat(3, 63.5mm); grid-auto-rows: 38.1mm; column-gap: 2.5mm; row-gap: 0; }
        .planche-A4 .etiquette { padding: 2mm 3mm; }
        .planche-A4 .etq-nom { font-size: 8.5pt; }
        .planche-A4 .etq-code { height: 20mm; }
        .planche-A4 .etq-texte-code { font-size: 6pt; }
        .planche-A4 .etq-prix { font-size: 11pt; }

        /* Rouleaux : une étiquette par « page » */
        .planche-R5030, .planche-R4025 { grid-template-columns: 1fr; }
        .planche-R5030 .etiquette, .planche-R4025 .etiquette { break-after: page; padding: 1.5mm 2mm; }
        .planche-R5030 .etiquette { width: 50mm; height: 30mm; }
        .planche-R4025 .etiquette { width: 40mm; height: 25mm; }
        .planche-R5030 .etq-nom { font-size: 7.5pt; }
        .planche-R4025 .etq-nom { font-size: 6.5pt; -webkit-line-clamp: 1; }
        .planche-R5030 .etq-code { height: 15mm; }
        .planche-R4025 .etq-code { height: 12mm; }
        .planche-R5030 .etq-prix { font-size: 9pt; }
        .planche-R4025 .etq-prix { font-size: 8pt; }
        .planche-R5030 .etq-texte-code, .planche-R4025 .etq-texte-code { font-size: 5pt; }
    }
</style>

@code {
    private List<ProduitCommerceDto> _articles = new();
    private readonly Dictionary<Guid, int> _selection = new();   // article → nombre d'étiquettes
    private readonly Dictionary<string, string> _qr = new();     // code → SVG du QR
    private IJSObjectReference? _module;

    private bool _chargement = true;
    private bool _enCours;
    private string _recherche = "";
    private string _format = "A4";
    private string _typeCode = "AUTO";
    private bool _afficherPrix = true;
    private bool _seulementSansCode;

    private IEnumerable<ProduitCommerceDto> Filtres => _articles.Where(a =>
        (!_seulementSansCode || string.IsNullOrWhiteSpace(a.CodeBarres)) &&
        (string.IsNullOrWhiteSpace(_recherche) ||
         a.Libelle.Contains(_recherche, StringComparison.OrdinalIgnoreCase) ||
         a.Reference.Contains(_recherche, StringComparison.OrdinalIgnoreCase) ||
         (a.CodeBarres?.Contains(_recherche, StringComparison.OrdinalIgnoreCase) ?? false)));

    private bool ToutSelectionne => Filtres.Any() && Filtres.All(a => _selection.ContainsKey(a.Id));
    private int NbEtiquettes => _selection.Values.Sum();
    private int NbSelectionSansCode => _articles.Count(a => _selection.ContainsKey(a.Id) && string.IsNullOrWhiteSpace(a.CodeBarres));

    private IEnumerable<ProduitCommerceDto> EtiquettesAImprimer => _articles
        .Where(a => _selection.ContainsKey(a.Id))
        .SelectMany(a => Enumerable.Repeat(a, _selection[a.Id]));

    private string TaillePage => _format switch { "R5030" => "50mm 30mm", "R4025" => "40mm 25mm", _ => "A4" };
    private string MargePage => _format == "A4" ? "15.1mm 7.2mm" : "0";

    protected override async Task OnInitializedAsync() => await Charger();

    private async Task Charger()
    {
        _chargement = true;
        _articles = (await CatalogueApi.GetProduitsAsync()).Where(a => a.EstActif).OrderBy(a => a.Libelle).ToList();
        if (ErreurCommerce.Derniere is { } e) NotificationService.Erreur(e, "Articles");
        _chargement = false;
    }

    /// <summary>Code imprimé : code-barres principal, sinon ISBN, sinon référence (toutes reconnues par la caisse).</summary>
    private static string CodeDe(ProduitCommerceDto a)
        => !string.IsNullOrWhiteSpace(a.CodeBarres) ? a.CodeBarres!
         : !string.IsNullOrWhiteSpace(a.Isbn) ? a.Isbn!
         : a.Reference;

    private void Basculer(ProduitCommerceDto a, ChangeEventArgs e)
    {
        if (e.Value is true) _selection[a.Id] = 1;
        else _selection.Remove(a.Id);
    }

    private void BasculerTout(ChangeEventArgs e)
    {
        foreach (var a in Filtres)
        {
            if (e.Value is true) _selection.TryAdd(a.Id, 1);
            else _selection.Remove(a.Id);
        }
    }

    private void ChangerNombre(Guid id, object? valeur)
    {
        if (int.TryParse(valeur?.ToString(), out var n))
            _selection[id] = Math.Clamp(n, 1, 200);
    }

    private async Task GenererCodesManquants()
    {
        var ids = _articles.Where(a => _selection.ContainsKey(a.Id) && string.IsNullOrWhiteSpace(a.CodeBarres)).Select(a => a.Id).ToList();
        if (ids.Count == 0) return;

        _enCours = true;
        try
        {
            var reponse = await Api.PostAsync("api/commerce/produits/codes-internes", new { ProduitIds = ids },
                "Génération impossible.", "Codes générés.");

            if (!reponse.Succes)
            {
                NotificationService.Erreur(reponse.Message, "Codes-barres");
                return;
            }

            NotificationService.Succes(reponse.Message, "Codes-barres");
            await Charger();   // les nouveaux codes apparaissent ; la sélection est conservée
        }
        catch (Exception)
        {
            NotificationService.Erreur("Serveur injoignable. Réessayez.", "Codes-barres");
        }
        finally
        {
            _enCours = false;
        }
    }

    private async Task Imprimer()
    {
        _enCours = true;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/finama-codes.js");

            // QR nécessaires : mode QR, ou code qui n'est pas un EAN-13
            var codesQr = _articles
                .Where(a => _selection.ContainsKey(a.Id))
                .Select(CodeDe)
                .Where(c => _typeCode == "QR" || !CodeBarresSvg.EstEan13(c))
                .Distinct()
                .Where(c => !_qr.ContainsKey(c))
                .ToList();

            if (codesQr.Count > 0)
            {
                var svgs = await _module.InvokeAsync<string[]>("qrSvgListe", codesQr);
                for (var i = 0; i < codesQr.Count; i++) _qr[codesQr[i]] = svgs[i];
            }

            StateHasChanged();
            await Task.Yield();
            await _module.InvokeVoidAsync("imprimer");
        }
        catch (Exception)
        {
            NotificationService.Erreur("L'impression n'a pas pu être préparée.", "Étiquettes");
        }
        finally
        {
            _enCours = false;
        }
    }

    private static string UniteSuffixe(ProduitCommerceDto a) => (a.Unite ?? 0) switch
    {
        1 => "/kg", 2 => "/g", 3 => "/L", 4 => "/m", 5 => "/h", _ => ""
    };

    public async ValueTask DisposeAsync()
    {
        try { if (_module is not null) await _module.DisposeAsync(); }
        catch { /* runtime arrêté */ }
    }

}
