@page "/commerce/fin-journee"
@using System.Net.Http.Json
@using Finama.Web.Services
@attribute [Authorize(Policy = "AdminTenant")]
@implements IAsyncDisposable
@inject HttpClient Http
@inject CommerceApiService CommerceApi
@inject IJSRuntime JS
@inject NotificationService NotificationService

<PageTitle>Fin de journée — Finama</PageTitle>

<!-- EN-TÊTE + FILTRES -->
<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4 no-print">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-calendar-check text-success me-2"></i>Fin de journée</h3>
        <p class="text-muted small mb-0">Encaissements, tickets, articles vendus et crédits clients</p>
    </div>
    <div class="d-flex align-items-end gap-2 flex-wrap">
        <div>
            <label class="form-label small fw-bold mb-1">Date</label>
            <input type="date" class="form-control" @bind="_date" @bind:after="Charger" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        @if (_magasins.Count > 1)
        {
            <div>
                <label class="form-label small fw-bold mb-1">Point de vente</label>
                <select class="form-select" @bind="_magasinId" @bind:after="Charger">
                    @foreach (var m in _magasins)
                    {
                        <option value="@m.Id">@m.Nom</option>
                    }
                </select>
            </div>
        }
        <button class="btn btn-outline-secondary" @onclick="() => DecalerJour(-1)" title="Jour précédent"><i class="bi bi-chevron-left"></i></button>
        <button class="btn btn-outline-secondary" @onclick="() => DecalerJour(1)" disabled="@(_date >= DateTime.Today)" title="Jour suivant"><i class="bi bi-chevron-right"></i></button>
        <BoutonExportExcel Url="@($"api/exports/fin-journee?date={_date:yyyy-MM-dd}" + (_magasinId != Guid.Empty ? $"&magasinId={_magasinId}" : ""))"
                           NomFichier="@($"FinDeJournee_{_date:yyyy-MM-dd}.xlsx")" Desactive="@(_journal is null)" />
        <button class="btn btn-success fw-bold" @onclick="Imprimer" disabled="@(_journal is null)">
            <i class="bi bi-printer me-1"></i>Imprimer
        </button>
    </div>
</div>

@if (_chargement)
{
    <div class="text-center py-5"><div class="spinner-border text-success"></div></div>
}
else if (_erreur is not null)
{
    <div class="alert alert-warning">@_erreur</div>
}
else if (_journal is { } j)
{
    <!-- Titre imprimé -->
    <div class="print-only mb-3">
        <h4 class="fw-bold mb-0">@(string.IsNullOrWhiteSpace(_entreprise) ? "Fin de journée" : _entreprise) — @j.Magasin</h4>
        <div>Journée du @j.Date.ToString("dddd dd MMMM yyyy") · édité le @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </div>

    <!-- INDICATEURS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="kpi-jour">
                <span class="kpi-libelle">Chiffre d'affaires TTC</span>
                <span class="kpi-valeur text-success">@Fcfa(j.TotalTTC)</span>
                <span class="kpi-sous">HT @Fcfa(j.TotalHT) · TVA @Fcfa(j.TotalTVA)</span>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-jour">
                <span class="kpi-libelle">Tickets</span>
                <span class="kpi-valeur">@j.NbTickets</span>
                <span class="kpi-sous">Panier moyen @Fcfa(j.NbTickets == 0 ? 0 : j.TotalTTC / j.NbTickets)@(j.NbAnnules > 0 ? $" · {j.NbAnnules} annulé(s)" : "")</span>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-jour">
                <span class="kpi-libelle">Marge brute</span>
                <span class="kpi-valeur @(j.MargeBrute >= 0 ? "text-success" : "text-danger")">@Fcfa(j.MargeBrute)</span>
                <span class="kpi-sous">@(j.TotalHT == 0 ? "—" : $"{j.MargeBrute / j.TotalHT:P1} du CA HT") · coût @Fcfa(j.CoutTotal)</span>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-jour">
                <span class="kpi-libelle">Crédits accordés</span>
                <span class="kpi-valeur @(TotalCredits > 0 ? "text-warning" : "")">@Fcfa(TotalCredits)</span>
                <span class="kpi-sous">@j.Credits.Count client(s)</span>
            </div>
        </div>
    </div>

    if (j.NbTickets == 0 && !j.Sessions.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-receipt fs-1 d-block mb-2 opacity-50"></i>
            Aucune vente ni session de caisse ce jour-là.
        </div>
    }
    else
    {
        <!-- ONGLETS -->
        <ul class="nav nav-tabs mb-3 no-print">
            @foreach (var (code, libelle, nb) in Onglets)
            {
                <li class="nav-item">
                    <button class="nav-link @(_onglet == code ? "active fw-bold" : "")" @onclick="() => _onglet = code">
                        @libelle <span class="badge bg-light text-dark border ms-1">@nb</span>
                    </button>
                </li>
            }
        </ul>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                @switch (_onglet)
                {
                    case "ENC":
                        <h6 class="fw-bold mb-3">Encaissé dans la journée</h6>
                        <div class="table-responsive mb-4">
                            <table class="table table-sm align-middle">
                                <thead class="small text-uppercase text-muted"><tr><th>Mode</th><th class="text-end">Opérations</th><th class="text-end">Montant</th></tr></thead>
                                <tbody>
                                    @foreach (var e in j.Encaissements)
                                    {
                                        <tr>
                                            <td><i class="bi @IconeMode(e.Mode) me-2"></i>@LibelleMode(e.Mode)</td>
                                            <td class="text-end">@e.NbOperations</td>
                                            <td class="text-end font-monospace fw-bold">@Fcfa(e.Montant)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold"><td>Total</td><td></td><td class="text-end font-monospace">@Fcfa(j.Encaissements.Sum(e => e.Montant))</td></tr>
                                </tfoot>
                            </table>
                        </div>

                        <h6 class="fw-bold mb-3">Contrôle des caisses</h6>
                        foreach (var s in j.Sessions)
                        {
                            <div class="border rounded-3 p-3 mb-3">
                                <div class="d-flex justify-content-between flex-wrap gap-2 mb-2">
                                    <span class="fw-bold"><i class="bi bi-pc-display me-1"></i>@s.Caisse</span>
                                    <span class="small text-muted">
                                        Ouverte @s.DateOuverture.ToLocalTime().ToString("dd/MM HH:mm") ·
                                        @(s.EstCloturee ? $"clôturée {s.DateCloture?.ToLocalTime():dd/MM HH:mm}" : "en cours") ·
                                        fond @Fcfa(s.FondDeCaisse)
                                    </span>
                                </div>
                                <table class="table table-sm mb-0">
                                    <thead class="small text-uppercase text-muted"><tr><th>Mode</th><th class="text-end">Attendu</th><th class="text-end">Déclaré</th><th class="text-end">Écart</th></tr></thead>
                                    <tbody>
                                        @foreach (var l in s.Lignes)
                                        {
                                            <tr>
                                                <td>@LibelleMode(l.Mode)@(l.Mode == ModeP.Especes ? " (fond compris)" : "")</td>
                                                <td class="text-end font-monospace">@Fcfa(l.Theorique)</td>
                                                <td class="text-end font-monospace">@(l.Declare is { } d ? Fcfa(d) : "—")</td>
                                                <td class="text-end font-monospace fw-bold @CouleurEcart(l.Ecart)">@(l.Ecart is { } e ? (e > 0 ? "+" : "") + Fcfa(e) : "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (!s.EstCloturee)
                                {
                                    <div class="small text-warning mt-2"><i class="bi bi-hourglass-split me-1"></i>Caisse non clôturée : les montants déclarés seront disponibles après la clôture.</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(s.Commentaire))
                                {
                                    <div class="small text-muted mt-2"><i class="bi bi-chat-left-text me-1"></i>@s.Commentaire</div>
                                }
                            </div>
                        }
                        break;

                    case "TIC":
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle">
                                <thead class="small text-uppercase text-muted">
                                    <tr><th>Ticket</th><th>Heure</th><th>Client</th><th>Paiement</th><th class="text-end">Total TTC</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in j.Tickets)
                                    {
                                        <tr class="ligne-cliquable @(t.EstAnnule ? "text-decoration-line-through text-muted" : "")" @onclick="() => BasculerTicket(t.Id)">
                                            <td class="font-monospace fw-bold"><i class="bi @(_ticketOuvert == t.Id ? "bi-chevron-down" : "bi-chevron-right") me-1 no-print"></i>@t.Numero</td>
                                            <td>@t.DateVente.ToLocalTime().ToString("HH:mm")</td>
                                            <td>@(t.Client ?? "—")</td>
                                            <td class="small">@string.Join(" + ", t.Paiements.Select(p => LibelleMode(p.Mode)))</td>
                                            <td class="text-end font-monospace fw-bold">@Fcfa(t.TotalTTC)</td>
                                        </tr>
                                        if (_ticketOuvert == t.Id)
                                        {
                                            <tr class="bg-light">
                                                <td colspan="5">
                                                    @if (t.EstAnnule)
                                                    {
                                                        <div class="text-danger small mb-2">Annulé : @t.MotifAnnulation</div>
                                                    }
                                                    <table class="table table-sm table-borderless mb-2 small">
                                                        @foreach (var l in t.Lignes)
                                                        {
                                                            <tr>
                                                                <td>@l.Libelle</td>
                                                                <td class="text-end">@l.Quantite.ToString("0.###") × @Fcfa(l.PrixUnitaireTTC)</td>
                                                                <td class="text-end font-monospace">@Fcfa(l.MontantTTC)</td>
                                                            </tr>
                                                        }
                                                    </table>
                                                    <div class="small d-flex flex-wrap gap-3">
                                                        @foreach (var p in t.Paiements)
                                                        {
                                                            <span><strong>@LibelleMode(p.Mode)</strong> @Fcfa(p.Montant)@(string.IsNullOrWhiteSpace(p.Reference) ? "" : $" ({p.Reference})")</span>
                                                        }
                                                        @if (t.RenduMonnaie > 0)
                                                        {
                                                            <span class="text-muted">Rendu @Fcfa(t.RenduMonnaie)</span>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                        break;

                    case "ART":
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead class="small text-uppercase text-muted">
                                    <tr><th>Article</th><th class="text-end">Quantité</th><th class="text-end">CA TTC</th><th class="text-end">Coût</th><th class="text-end">Marge</th><th class="text-end">Taux</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in j.Articles)
                                    {
                                        <tr>
                                            <td class="fw-bold">@a.Libelle</td>
                                            <td class="text-end font-monospace">@a.Quantite.ToString("0.###")</td>
                                            <td class="text-end font-monospace">@Fcfa(a.ChiffreAffairesTTC)</td>
                                            <td class="text-end font-monospace text-muted">@Fcfa(a.Cout)</td>
                                            <td class="text-end font-monospace fw-bold @(a.Marge >= 0 ? "text-success" : "text-danger")">@Fcfa(a.Marge)</td>
                                            <td class="text-end small">@(a.ChiffreAffairesHT == 0 ? "—" : (a.Marge / a.ChiffreAffairesHT).ToString("P0"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="small text-muted"><i class="bi bi-info-circle me-1"></i>Marge = CA HT − coût d'achat moyen au moment de la vente. Un service sans coût d'achat a une marge de 100 %.</div>
                        break;

                    case "CRE":
                        if (!j.Credits.Any())
                        {
                            <div class="text-muted text-center py-4">Aucune vente à crédit ce jour-là.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle">
                                    <thead class="small text-uppercase text-muted">
                                        <tr><th>Client</th><th>Téléphone</th><th class="text-end">Crédit du jour</th><th class="text-end">Total dû</th><th class="text-end">Plafond</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in j.Credits)
                                        {
                                            <tr>
                                                <td class="fw-bold">@c.Client</td>
                                                <td>@(c.Telephone ?? "—")</td>
                                                <td class="text-end font-monospace">@Fcfa(c.CreditDuJour)</td>
                                                <td class="text-end font-monospace fw-bold text-danger">@Fcfa(c.SoldeTotalDu)</td>
                                                <td class="text-end font-monospace text-muted">@Fcfa(c.Plafond)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        break;
                }
            </div>
        </div>
    }
}

<style>
    .kpi-jour { background: var(--bs-body-bg, #fff); border-radius: 12px; padding: 14px 16px; box-shadow: 0 1px 3px rgba(0,0,0,.08); display: flex; flex-direction: column; gap: 2px; height: 100%; }
    .kpi-libelle { font-size: .75rem; text-transform: uppercase; color: #6c757d; font-weight: 600; }
    .kpi-valeur { font-size: 1.45rem; font-weight: 700; font-family: var(--bs-font-monospace); white-space: nowrap; }
    .kpi-sous { font-size: .75rem; color: #6c757d; }
    .ligne-cliquable { cursor: pointer; }
    .print-only { display: none; }

    @@media print {
        .sidebar, .topbar, .no-print, .rz-notification { display: none !important; }
        .main-content, .page-wrapper { margin: 0 !important; padding: 0 !important; width: 100% !important; }
        .print-only { display: block !important; }
        .card, .kpi-jour { box-shadow: none !important; border: 1px solid #ccc !important; }
        @@page { size: A4; margin: 12mm; }
    }
</style>

@code {
    private DateTime _date = DateTime.Today;
    private Guid _magasinId;
    private List<MagasinDto> _magasins = new();
    private JournalJour? _journal;
    private string? _erreur;
    private string? _entreprise;
    private bool _chargement = true;
    private string _onglet = "ENC";
    private Guid? _ticketOuvert;
    private IJSObjectReference? _jsPos;

    private decimal TotalCredits => _journal?.Credits.Sum(c => c.CreditDuJour) ?? 0;

    private (string Code, string Libelle, int Nb)[] Onglets => _journal is null
        ? Array.Empty<(string, string, int)>()
        : new[]
        {
            ("ENC", "Encaissements", _journal.Sessions.Count),
            ("TIC", "Tickets", _journal.Tickets.Count),
            ("ART", "Articles vendus", _journal.Articles.Count),
            ("CRE", "Crédits clients", _journal.Credits.Count)
        };

    protected override async Task OnInitializedAsync()
    {
        _magasins = (await CommerceApi.GetMagasinsAsync())
            .Where(m => m.EstActif && m.Type == TypeMagasin.PointDeVente)
            .OrderByDescending(m => m.EstPrincipal).ThenBy(m => m.Nom)
            .ToList();

        var actif = await CommerceApi.GetMagasinActifIdAsync();
        _magasinId = _magasins.FirstOrDefault(m => m.Id == actif)?.Id ?? _magasins.FirstOrDefault()?.Id ?? Guid.Empty;

        await Charger();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _jsPos = await JS.InvokeAsync<IJSObjectReference>("import", "./js/finama-pos.js");
            _entreprise = await JS.InvokeAsync<string?>("localStorage.getItem", "finama_entreprise");
        }
        catch { /* impression indisponible */ }
    }

    private async Task Charger()
    {
        _chargement = true;
        _erreur = null;
        _ticketOuvert = null;
        try
        {
            var url = $"api/commerce/pos/journal?date={_date:yyyy-MM-dd}" + (_magasinId != Guid.Empty ? $"&magasinId={_magasinId}" : "");
            using var reponse = await Http.GetAsync(url);

            if (reponse.IsSuccessStatusCode)
            {
                _journal = await reponse.Content.ReadFromJsonAsync<JournalJour>();
            }
            else
            {
                _journal = null;
                _erreur = reponse.StatusCode == System.Net.HttpStatusCode.Forbidden
                    ? "La fin de journée est réservée à l'administrateur."
                    : await LireMessageAsync(reponse) ?? "Impossible de charger la journée.";
            }
        }
        catch (HttpRequestException)
        {
            _journal = null;
            _erreur = "Serveur injoignable. Vérifiez votre connexion.";
        }
        finally
        {
            _chargement = false;
        }
    }

    private async Task DecalerJour(int jours)
    {
        var cible = _date.AddDays(jours);
        if (cible > DateTime.Today) return;
        _date = cible;
        await Charger();
    }

    private void BasculerTicket(Guid id) => _ticketOuvert = _ticketOuvert == id ? null : id;

    private async Task Imprimer()
    {
        try { if (_jsPos is not null) await _jsPos.InvokeVoidAsync("imprimerTicket"); }
        catch { NotificationService.Avertir("L'impression n'a pas pu être lancée."); }
    }

    public async ValueTask DisposeAsync()
    {
        try { if (_jsPos is not null) await _jsPos.DisposeAsync(); }
        catch { /* runtime JS arrêté */ }
    }

    private static async Task<string?> LireMessageAsync(HttpResponseMessage r)
    {
        try { return (await r.Content.ReadFromJsonAsync<MessageApi>())?.Message; }
        catch { return null; }
    }

    private static string Fcfa(decimal montant) => $"{montant:N0} F";

    private static string CouleurEcart(decimal? ecart) => ecart switch
    {
        null => "",
        0 => "text-success",
        < 0 => "text-danger",
        _ => "text-warning"
    };

    private static string LibelleMode(ModeP m) => m switch
    {
        ModeP.Especes => "Espèces",
        ModeP.Carte => "Carte",
        ModeP.MobileMoney => "Mobile Money",
        ModeP.Credit => "Crédit client",
        ModeP.Points => "Points fidélité",
        _ => m.ToString()
    };

    private static string IconeMode(ModeP m) => m switch
    {
        ModeP.Especes => "bi-cash text-success",
        ModeP.Carte => "bi-credit-card text-primary",
        ModeP.MobileMoney => "bi-phone text-warning",
        ModeP.Credit => "bi-journal-text text-danger",
        ModeP.Points => "bi-star text-info",
        _ => "bi-question-circle"
    };

    // ─── Modèles (alignés sur JournalJourDto de l'API) ───
    public enum ModeP { Especes = 1, Carte = 2, MobileMoney = 3, Credit = 4, Points = 5 }

    public record MessageApi(string? Message);

    public record JournalJour(
        DateOnly Date, Guid MagasinId, string Magasin, int NbTickets, int NbAnnules,
        decimal TotalTTC, decimal TotalHT, decimal TotalTVA, decimal TotalRemises, decimal CoutTotal, decimal MargeBrute,
        List<Encaissement> Encaissements, List<SessionJour> Sessions, List<TicketJour> Tickets,
        List<ArticleVendu> Articles, List<CreditJour> Credits);

    public record Encaissement(ModeP Mode, decimal Montant, int NbOperations);

    public record SessionJour(Guid SessionId, string Caisse, DateTime DateOuverture, DateTime? DateCloture, decimal FondDeCaisse,
        bool EstCloturee, List<LigneControle> Lignes, decimal? EcartTotal, string? Commentaire);

    public record LigneControle(ModeP Mode, decimal Theorique, decimal? Declare, decimal? Ecart);

    public record TicketJour(Guid Id, string Numero, DateTime DateVente, string Caisse, string? Client,
        decimal TotalHT, decimal TotalTVA, decimal TotalRemise, decimal TotalTTC, decimal RenduMonnaie,
        bool EstAnnule, string? MotifAnnulation, List<LigneTicket> Lignes, List<PaiementTicket> Paiements);

    public record LigneTicket(string Libelle, decimal Quantite, decimal PrixUnitaireTTC, decimal RemiseMontant, decimal MontantTTC);

    public record PaiementTicket(ModeP Mode, decimal Montant, string? Reference);

    public record ArticleVendu(Guid ProduitId, string Libelle, decimal Quantite, decimal ChiffreAffairesTTC, decimal ChiffreAffairesHT, decimal Cout, decimal Marge);

    public record CreditJour(Guid ClientId, string Client, string? Telephone, decimal CreditDuJour, decimal SoldeTotalDu, decimal Plafond);
}
