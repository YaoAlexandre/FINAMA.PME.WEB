@page "/ventes"
@using Finama.Web.Services
@inject VentesApiService Ventes
@inject NavigationManager Nav

<PageTitle>Ventes & Devis — Finama</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-file-earmark-check text-info me-2"></i>Ventes & Devis</h3>
        <p class="text-muted small mb-0">Vos devis, ce qui attend une réponse et ce qui est prêt à facturer</p>
    </div>
    <button class="btn btn-info text-white fw-bold" @onclick='() => Nav.NavigateTo("/ventes/devis/nouveau")'>
        <i class="bi bi-plus-circle me-1"></i>Nouveau devis
    </button>
</div>

@if (_tb is null)
{
    @if (_erreur is not null)
    {
        <div class="alert alert-warning">@_erreur</div>
    }
    else
    {
        <div class="text-center py-5"><div class="spinner-border text-info"></div></div>
    }
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <a class="kpi-vente" href="/ventes/devis?statut=1">
                <span class="kpi-l">En attente de réponse</span>
                <span class="kpi-v text-primary">@_tb.NbEnvoyes</span>
                <span class="kpi-s">@Fcfa(_tb.MontantEnAttente) TTC</span>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a class="kpi-vente" href="/ventes/devis?statut=2">
                <span class="kpi-l">Acceptés à facturer</span>
                <span class="kpi-v text-success">@_tb.NbAcceptesNonFactures</span>
                <span class="kpi-s">@Fcfa(_tb.MontantAcceptesNonFactures) TTC</span>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-vente">
                <span class="kpi-l">Taux de transformation</span>
                <span class="kpi-v">@_tb.TauxTransformation.ToString("P0")</span>
                <span class="kpi-s">devis acceptés sur 12 mois</span>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-vente">
                <span class="kpi-l">Facturé ce mois (HT)</span>
                <span class="kpi-v text-info">@Fcfa(_tb.CaDevisFacturesMois)</span>
                <span class="kpi-s">@_tb.NbBrouillons brouillon(s) en préparation</span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold"><i class="bi bi-hourglass-split text-warning me-2"></i>À relancer : expirent sous 7 jours</div>
                <div class="list-group list-group-flush">
                    @if (!_tb.AExpirer.Any())
                    {
                        <div class="list-group-item text-muted small py-4 text-center">Aucun devis n'expire dans les 7 prochains jours.</div>
                    }
                    @foreach (var d in _tb.AExpirer)
                    {
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/ventes/devis/@d.Id">
                            <span><strong>@d.TiersNom</strong> <span class="text-muted small">· @d.Numero · @d.Libelle</span></span>
                            <span class="text-nowrap small">
                                <span class="fw-bold">@Fcfa(d.TotalTTC)</span>
                                <span class="d-block text-danger">jusqu'au @d.DateExpiration?.ToString("dd/MM")</span>
                            </span>
                        </a>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold d-flex justify-content-between">
                    <span><i class="bi bi-clock-history text-info me-2"></i>Derniers devis</span>
                    <a href="/ventes/devis" class="small">Tout voir →</a>
                </div>
                <div class="list-group list-group-flush">
                    @if (!_tb.Derniers.Any())
                    {
                        <div class="list-group-item text-center py-4">
                            <div class="text-muted small mb-2">Aucun devis pour l'instant.</div>
                            <a href="/ventes/devis/nouveau" class="btn btn-sm btn-info text-white">Créer mon premier devis</a>
                        </div>
                    }
                    @foreach (var d in _tb.Derniers)
                    {
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/ventes/devis/@d.Id">
                            <span><strong>@d.TiersNom</strong> <span class="text-muted small">· @d.Numero</span></span>
                            <span class="d-flex align-items-center gap-2">
                                <span class="fw-bold small text-nowrap">@Fcfa(d.TotalTTC)</span>
                                <BadgeStatutDevis Statut="d.Statut" />
                            </span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .kpi-vente { display: flex; flex-direction: column; gap: 2px; background: var(--bs-body-bg, #fff); border-radius: 12px; padding: 14px 16px;
                 box-shadow: 0 1px 3px rgba(0,0,0,.08); text-decoration: none; color: inherit; height: 100%; }
    a.kpi-vente:hover { box-shadow: 0 4px 12px rgba(0,0,0,.12); }
    .kpi-l { font-size: .75rem; text-transform: uppercase; color: #6c757d; font-weight: 600; }
    .kpi-v { font-size: 1.6rem; font-weight: 700; font-family: var(--bs-font-monospace); white-space: nowrap; }
    .kpi-s { font-size: .75rem; color: #6c757d; }
</style>

@code {
    private VentesTableauBordVm? _tb;
    private string? _erreur;

    protected override async Task OnInitializedAsync()
    {
        _tb = await Ventes.TableauBordAsync();
        if (_tb is null) _erreur = Ventes.DerniereErreur ?? "Tableau de bord indisponible.";
    }

    private static string Fcfa(decimal m) => $"{m:N0} F";
}
