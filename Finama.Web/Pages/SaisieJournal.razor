@page "/comptabilite/saisie"
@page "/comptabilite/saisie/{Id:guid}"
@using System.Globalization
@using Finama.Web.Models
@using Finama.Web.Services
@using Finama.Web.Shared
@inject FinamaApiService Api
@inject NavigationManager Nav
@inject AppState State
@inject NotificationService Notif

<div class="container py-4 pb-5">
    <div class="d-flex align-items-center mb-3">
        <button type="button" class="btn btn-light border btn-sm me-3 px-3" @onclick="Annuler">
            <i class="bi bi-arrow-left me-1"></i> Journal
        </button>
        <div>
            <h2 class="page-title mb-0">
                <i class="bi @(Id.HasValue ? "bi-pencil-square" : "bi-journal-plus") me-2"></i>@(Id.HasValue ? "Modification du brouillon" : "Saisie d'écriture")
            </h2>
            <p class="text-muted small mb-0">Chaque ligne débite ou crédite un compte. Le total débit doit égaler le total crédit.</p>
        </div>
    </div>

    @if (_verrouille)
    {
        <div class="alert alert-warning border-0 shadow-sm" role="alert">
            <i class="bi bi-lock-fill me-2"></i>@_motifVerrou
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Date</label>
                    <input type="date" class="form-control" @bind="_request.DateEcriture" @bind:format="yyyy-MM-dd" disabled="@_verrouille" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Journal</label>
                    <select class="form-select" @bind="_request.Journal" disabled="@_verrouille">
                        <option value="OD">OD - Opérations diverses</option>
                        <option value="BQ">BQ - Banque</option>
                        <option value="AC">AC - Achats</option>
                        <option value="VT">VT - Ventes</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Libellé de l'opération</label>
                    <input class="form-control @(_tentative && string.IsNullOrWhiteSpace(_request.Libelle) ? "is-invalid" : "")"
                           @bind="_request.Libelle" @bind:event="oninput" placeholder="Ex. Règlement facture FA-2026-014" disabled="@_verrouille" />
                </div>
            </div>
            @if (_request.Journal == "BQ")
            {
                <div class="small text-muted mt-2"><i class="bi bi-info-circle me-1"></i>Journal banque : une des lignes doit utiliser un compte de trésorerie (classe 5, ex. 521 Banques).</div>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="fn-lignes">
            <div class="fn-ligne fn-ligne-entete">
                <div>Compte</div>
                <div>Libellé de la ligne</div>
                <div class="text-end">Débit</div>
                <div class="text-end">Crédit</div>
                <div></div>
            </div>

            @for (var i = 0; i < _request.Lignes.Count; i++)
            {
                var ligne = _request.Lignes[i];
                var numero = i + 1;
                <div class="fn-ligne">
                    <div data-label="Compte">
                        <CompteSelector Comptes="_comptes" Value="ligne.CompteId" ValueChanged="id => ligne.CompteId = id"
                                        Invalide="@(_tentative && ligne.CompteId == Guid.Empty && (ligne.Debit > 0 || ligne.Credit > 0))" />
                    </div>
                    <div data-label="Libellé">
                        <input type="text" class="form-control form-control-sm" @bind="ligne.Libelle" placeholder="Identique au libellé général si vide" disabled="@_verrouille" />
                    </div>
                    <div data-label="Débit">
                        <input type="number" min="0" step="any" inputmode="decimal" class="form-control form-control-sm text-end fn-montant fn-debit"
                               value="@Format(ligne.Debit)" @oninput="e => SaisirDebit(ligne, e)" placeholder="0" disabled="@_verrouille" />
                    </div>
                    <div data-label="Crédit">
                        <input type="number" min="0" step="any" inputmode="decimal" class="form-control form-control-sm text-end fn-montant fn-credit"
                               value="@Format(ligne.Credit)" @oninput="e => SaisirCredit(ligne, e)" placeholder="0" disabled="@_verrouille" />
                    </div>
                    <div class="fn-ligne-actions">
                        @if (!EstEquilibre && TotalDebit + TotalCredit > 0 && !_verrouille)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary border-0" title="Équilibrer l'écriture sur cette ligne" @onclick="() => Equilibrer(ligne)">
                                <i class="bi bi-magic"></i>
                            </button>
                        }
                        <button type="button" class="btn btn-sm text-danger border-0" title="Supprimer la ligne @numero"
                                @onclick="() => SupprimerLigne(ligne)" disabled="@(_request.Lignes.Count <= 2 || _verrouille)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }

            <div class="p-3 border-top">
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AjouterLigne" disabled="@_verrouille">
                    <i class="bi bi-plus-lg me-1"></i> Ajouter une ligne
                </button>
            </div>
        </div>
    </div>
</div>

<div class="fn-barre-equilibre @(EstEquilibre ? "ok" : (TotalDebit + TotalCredit > 0 ? "ko" : ""))">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <span><span class="text-muted small">Débit</span> <strong class="fn-debit-txt">@TotalDebit.ToString("N0")</strong></span>
            <span><span class="text-muted small">Crédit</span> <strong class="fn-credit-txt">@TotalCredit.ToString("N0")</strong></span>
            @if (EstEquilibre)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Équilibrée</span>
            }
            else if (TotalDebit + TotalCredit > 0)
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                    <i class="bi bi-exclamation-triangle me-1"></i>Écart de @Math.Abs(TotalDebit - TotalCredit).ToString("N0")
                </span>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-light border px-4" @onclick="Annuler" disabled="@_isSubmitting">Annuler</button>
            <button type="button" class="btn btn-primary px-4 fw-semibold" @onclick="SoumettreEcriture" disabled="@(!EstEquilibre || _isSubmitting || _verrouille)">
                @if (_isSubmitting) { <span class="spinner-border spinner-border-sm me-2" role="status"></span> }
                else { <i class="bi bi-cloud-arrow-up me-2"></i> }
                Enregistrer le brouillon
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private List<CompteSelectDto> _comptes = new();
    private CreerEcritureRequest _request = new()
    {
        DateEcriture = DateTime.Today,
        Journal = "OD",
        Lignes = new List<CreerLigneEcritureRequest>()
    };

    private bool _isSubmitting;
    private bool _tentative;       // devient vrai après un premier essai d'enregistrement : active les surlignages
    private bool _verrouille;
    private string _motifVerrou = string.Empty;

    private decimal TotalDebit => _request.Lignes.Sum(l => l.Debit);
    private decimal TotalCredit => _request.Lignes.Sum(l => l.Credit);
    private bool EstEquilibre => TotalDebit > 0 && TotalDebit == TotalCredit;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Liste complète : un compte déjà choisi ne disparaît jamais quand on change de journal
            _comptes = await Api.GetPlanComptableSelectAsync();
        }
        catch (Exception)
        {
            Notif.ErreurServeur("Plan comptable indisponible");
        }

        if (Id.HasValue && Id.Value != Guid.Empty)
        {
            await ChargerBrouillonPourModification();
        }
        else
        {
            _request.Lignes.Add(new());
            _request.Lignes.Add(new());
        }
    }

    private async Task ChargerBrouillonPourModification()
    {
        try
        {
            var existante = await Api.GetEcritureAsync(Id!.Value);
            if (existante is null)
            {
                Verrouiller("Cette écriture est introuvable.");
                return;
            }

            if (existante.Statut != "Brouillon")
            {
                Verrouiller("Cette écriture est validée : elle est verrouillée et ne peut plus être modifiée.");
                return;
            }

            _request = new CreerEcritureRequest
            {
                DateEcriture = existante.DateEcriture,
                Journal = existante.Journal,
                Libelle = existante.Libelle,
                ExerciceId = existante.ExerciceId,
                Lignes = existante.Lignes.Select(l => new CreerLigneEcritureRequest
                {
                    CompteId = l.CompteId,
                    Libelle = l.Libelle,
                    Debit = l.Debit,
                    Credit = l.Credit
                }).ToList()
            };
        }
        catch (Exception)
        {
            Verrouiller("Impossible de charger le brouillon. Retournez au journal et réessayez.");
            Notif.ErreurServeur();
        }
    }

    private void Verrouiller(string motif)
    {
        _verrouille = true;
        _motifVerrou = motif;
        if (_request.Lignes.Count == 0) { _request.Lignes.Add(new()); _request.Lignes.Add(new()); }
    }

    // ---- Montants : une ligne est soit au débit, soit au crédit ----
    private static string Format(decimal valeur) => valeur == 0 ? "" : valeur.ToString(CultureInfo.InvariantCulture);

    private static decimal Lire(ChangeEventArgs e)
        => decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v) && v > 0 ? v : 0;

    private void SaisirDebit(CreerLigneEcritureRequest ligne, ChangeEventArgs e)
    {
        ligne.Debit = Lire(e);
        if (ligne.Debit > 0) ligne.Credit = 0;
    }

    private void SaisirCredit(CreerLigneEcritureRequest ligne, ChangeEventArgs e)
    {
        ligne.Credit = Lire(e);
        if (ligne.Credit > 0) ligne.Debit = 0;
    }

    // Place sur cette ligne le montant qui manque pour équilibrer l'écriture
    private void Equilibrer(CreerLigneEcritureRequest ligne)
    {
        var debitAutres = TotalDebit - ligne.Debit;
        var creditAutres = TotalCredit - ligne.Credit;
        var ecart = debitAutres - creditAutres;

        if (ecart > 0) { ligne.Credit = ecart; ligne.Debit = 0; }
        else if (ecart < 0) { ligne.Debit = -ecart; ligne.Credit = 0; }
    }

    private void AjouterLigne() => _request.Lignes.Add(new());

    private void SupprimerLigne(CreerLigneEcritureRequest ligne)
    {
        if (_request.Lignes.Count > 2) _request.Lignes.Remove(ligne);
    }

    private void Annuler() => Nav.NavigateTo("/comptabilite/ecritures");

    // ---- Enregistrement ----
    private async Task SoumettreEcriture()
    {
        if (_isSubmitting || _verrouille) return;
        _tentative = true;

        var utiles = _request.Lignes.Where(l => l.Debit > 0 || l.Credit > 0 || l.CompteId != Guid.Empty).ToList();
        var problemes = new List<string>();

        if (string.IsNullOrWhiteSpace(_request.Libelle)) problemes.Add("Saisissez le libellé de l'opération.");
        if (State.DonneesTableauBord?.ExerciceId == null) problemes.Add("Aucun exercice comptable n'est sélectionné.");
        if (utiles.Count < 2) problemes.Add("Une écriture comporte au moins deux lignes.");

        foreach (var l in utiles)
        {
            var n = _request.Lignes.IndexOf(l) + 1;
            if (l.CompteId == Guid.Empty) problemes.Add($"Ligne {n} : choisissez un compte.");
            else if (l.Debit == 0 && l.Credit == 0) problemes.Add($"Ligne {n} : indiquez un montant au débit ou au crédit.");
        }

        if (problemes.Count > 0)
        {
            Notif.Avertir(string.Join(" ", problemes.Take(3)), "Écriture incomplète");
            return;
        }

        _isSubmitting = true;
        try
        {
            var payload = new CreerEcritureRequest
            {
                ExerciceId = State.DonneesTableauBord!.ExerciceId,
                DateEcriture = _request.DateEcriture,
                Journal = _request.Journal,
                Libelle = _request.Libelle.Trim(),
                FactureId = _request.FactureId,
                Lignes = utiles.Select(l => new CreerLigneEcritureRequest
                {
                    CompteId = l.CompteId,
                    TiersId = l.TiersId,
                    Libelle = string.IsNullOrWhiteSpace(l.Libelle) ? _request.Libelle.Trim() : l.Libelle.Trim(),
                    Debit = l.Debit,
                    Credit = l.Credit,
                    Devise = l.Devise,
                    TauxChange = l.TauxChange
                }).ToList()
            };

            var res = Id.HasValue
                ? await Api.ModifierEcritureAsync(Id.Value, payload)
                : await Api.CreerEcritureAsync(payload);

            if (res is not null && res.Id != Guid.Empty)
            {
                Notif.Succes($"{res.Reference} est enregistrée en brouillon. Validez-la depuis le journal pour la verrouiller.", "Écriture enregistrée");
                Nav.NavigateTo("/comptabilite/ecritures");
            }
            else
            {
                Notif.Erreur("Le serveur a refusé l'écriture. Vérifiez que la date est dans l'exercice ouvert et que les comptes sont actifs.");
            }
        }
        catch (Exception)
        {
            Notif.ErreurServeur("Enregistrement impossible");
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
