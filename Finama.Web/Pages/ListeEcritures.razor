@page "/comptabilite/ecritures"
@using Finama.Web.Models
@using Finama.Web.Services
@using Finama.Web.Shared
@inject FinamaApiService Api
@inject NavigationManager Nav
@inject NotificationService Notif

<div class="page-wrapper">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title"><i class="bi bi-book-half me-2"></i>Journal des Écritures</h2>
            <p class="page-subtitle text-muted">Gestion et suivi des flux comptables</p>
        </div>
        <button class="btn btn-primary shadow-sm px-4" @onclick="OuvrirNouvelleSaisie">
            <i class="bi bi-plus-circle-fill me-2"></i>Nouvelle Saisie
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-0 pt-3 pb-0 px-3">
            <div class="row g-2 align-items-center">
                <div class="col-6 col-md-3 col-lg-2">
                    <select class="form-select form-select-sm" value="@(_filtre.Journal ?? "")" @onchange="ChangerJournal" aria-label="Filtrer par journal">
                        <option value="">Tous les journaux</option>
                        <option value="OD">OD - Divers</option>
                        <option value="BQ">BQ - Banque</option>
                        <option value="AC">AC - Achats</option>
                        <option value="VT">VT - Ventes</option>
                    </select>
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <select class="form-select form-select-sm" value="@(_filtre.Statut ?? "")" @onchange="ChangerStatut" aria-label="Filtrer par statut">
                        <option value="">Tous les statuts</option>
                        <option value="Brouillon">Brouillons</option>
                        <option value="Validee">Validées</option>
                        <option value="Cloturee">Clôturées</option>
                    </select>
                </div>
                @if (FiltreActif)
                {
                    <div class="col-auto">
                        <button class="btn btn-sm btn-link text-decoration-none" @onclick="ReinitialiserFiltres">
                            <i class="bi bi-x-circle me-1"></i>Effacer les filtres
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="card-body p-0 position-relative">
            @if (_chargement && _ecritures != null)
            {
                <div class="fn-chargement" aria-live="polite"><div class="spinner-border spinner-border-sm text-primary" role="status"></div></div>
            }

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 mt-2">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4"><i class="bi bi-calendar3 me-2"></i>Date</th>
                            <th><i class="bi bi-hash me-2"></i>Référence</th>
                            <th><i class="bi bi-journal-bookmark me-2"></i>Journal</th>
                            <th><i class="bi bi-chat-left-text me-2"></i>Libellé</th>
                            <th class="text-end"><i class="bi bi-dash-circle me-2"></i>Débit</th>
                            <th class="text-end"><i class="bi bi-plus-circle me-2"></i>Crédit</th>
                            <th class="text-center">Statut</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_ecritures == null)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <div class="mt-2 text-muted">Récupération des données...</div>
                                </td>
                            </tr>
                        }
                        else if (!_ecritures.Items.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-x fs-2 d-block mb-2"></i>
                                    @(FiltreActif ? "Aucune écriture ne correspond à ces filtres." : "Aucune écriture comptable trouvée pour cet exercice.")
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var ecriture in _ecritures.Items)
                            {
                                <tr>
                                    <td class="ps-4">@ecriture.DateEcriture.ToString("dd/MM/yyyy")</td>
                                    <td><span class="fw-bold text-primary">@ecriture.Reference</span></td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-tag-fill me-1 text-secondary"></i>@ecriture.Journal
                                        </span>
                                    </td>
                                    <td>@ecriture.Libelle</td>
                                    <td class="text-end fw-bold text-danger">@ecriture.TotalDebit.ToString("N2")</td>
                                    <td class="text-end fw-bold text-success">@ecriture.TotalCredit.ToString("N2")</td>
                                    <td class="text-center">
                                        @if (ecriture.Statut == "Brouillon")
                                        {
                                            <span class="badge rounded-pill bg-warning text-dark px-2 py-1"><i class="bi bi-hourglass-split me-1"></i>Brouillon</span>
                                        }
                                        else if (ecriture.Statut == "Cloturee")
                                        {
                                            <span class="badge rounded-pill bg-secondary px-2 py-1"><i class="bi bi-lock-fill me-1"></i>Clôturée</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-success px-2 py-1"><i class="bi bi-check-all me-1"></i>Validée</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group d-inline-flex gap-1">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Consulter(ecriture.Id)" title="Consulter">
                                                <i class="bi bi-eye-fill"></i>
                                            </button>
                                            @if (ecriture.Statut == "Brouillon")
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Modifier(ecriture.Id)" title="Modifier le brouillon">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-success" @onclick="() => DemanderValidation(ecriture)" title="Valider définitivement">
                                                    <i class="bi bi-shield-check"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DemanderSuppression(ecriture)" title="Supprimer">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (_ecritures != null && _ecritures.TotalItems > 0)
        {
            <div class="card-footer bg-transparent border-top py-3 px-3">
                <Pagination Page="_ecritures.Page" PageSize="_ecritures.PageSize" TotalItems="_ecritures.TotalItems"
                            Unite="écritures" OnPageChange="AllerPage" OnPageSizeChange="ChangerTaille" />
            </div>
        }
    </div>
</div>

@if (_afficherModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" style="background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        @if (_actionType == ActionModal.Validation)
                        {
                            <i class="bi bi-shield-check text-success display-4"></i>
                        }
                        else
                        {
                            <i class="bi bi-exclamation-triangle text-danger display-4"></i>
                        }
                    </div>
                    <h5 class="fw-bold mb-2">@_modalTitre</h5>
                    <p class="text-muted mb-4">@_modalMessage</p>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-light px-4 fw-semibold border" @onclick="FermerModal" disabled="@_actionEnCours">Annuler</button>
                        <button type="button" class="btn @(_actionType == ActionModal.Validation ? "btn-success" : "btn-danger") px-4"
                                @onclick="ExecuterAction" disabled="@_actionEnCours">
                            @if (_actionEnCours) { <span class="spinner-border spinner-border-sm me-1" role="status"></span> }
                            else { <i class="bi @(_actionType == ActionModal.Validation ? "bi-check2-circle" : "bi-trash3") me-1"></i> }
                            @(_actionType == ActionModal.Validation ? "Confirmer la validation" : "Confirmer la suppression")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private enum ActionModal { Validation, Suppression }

    private PagedResult<EcritureDto>? _ecritures;
    private FiltreEcritureQuery _filtre = new() { Page = 1, PageSize = 20 };
    private bool _chargement;

    private bool _afficherModal;
    private bool _actionEnCours;
    private string _modalTitre = "";
    private string _modalMessage = "";
    private EcritureDto? _ecritureCible;
    private ActionModal _actionType;

    private bool FiltreActif => !string.IsNullOrEmpty(_filtre.Journal) || !string.IsNullOrEmpty(_filtre.Statut);

    protected override async Task OnInitializedAsync() => await ChargerDonnees();

    private async Task ChargerDonnees()
    {
        _chargement = true;
        try
        {
            var resultat = await Api.GetEcrituresAsync(_filtre);

            // La page demandée n'existe plus (dernière ligne supprimée, filtre plus restrictif) : retour à la dernière page
            if (resultat is { TotalPages: > 0 } && _filtre.Page > resultat.TotalPages)
            {
                _filtre.Page = resultat.TotalPages;
                resultat = await Api.GetEcrituresAsync(_filtre);
            }

            _ecritures = resultat ?? new PagedResult<EcritureDto>();
        }
        catch (Exception)
        {
            _ecritures ??= new PagedResult<EcritureDto>();
            Notif.ErreurServeur("Chargement impossible");
        }
        finally
        {
            _chargement = false;
        }
    }

    // ---- Pagination et filtres ----
    private async Task AllerPage(int page) { _filtre.Page = page; await ChargerDonnees(); }

    private async Task ChangerTaille(int taille) { _filtre.PageSize = taille; _filtre.Page = 1; await ChargerDonnees(); }

    private async Task ChangerJournal(ChangeEventArgs e)
    {
        _filtre.Journal = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();
        _filtre.Page = 1;
        await ChargerDonnees();
    }

    private async Task ChangerStatut(ChangeEventArgs e)
    {
        _filtre.Statut = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString();
        _filtre.Page = 1;
        await ChargerDonnees();
    }

    private async Task ReinitialiserFiltres()
    {
        _filtre.Journal = null;
        _filtre.Statut = null;
        _filtre.Page = 1;
        await ChargerDonnees();
    }

    // ---- Navigation ----
    private void OuvrirNouvelleSaisie() => Nav.NavigateTo("/comptabilite/saisie");
    private void Consulter(Guid id) => Nav.NavigateTo($"/comptabilite/ecritures/details/{id}");
    private void Modifier(Guid id) => Nav.NavigateTo($"/comptabilite/saisie/{id}");

    // ---- Validation / suppression ----
    private void DemanderValidation(EcritureDto ecriture)
    {
        _ecritureCible = ecriture;
        _actionType = ActionModal.Validation;
        _modalTitre = "Validation définitive";
        _modalMessage = $"Voulez-vous valider définitivement l'écriture {ecriture.Reference} ? Cette action verrouille les lignes comptables au Grand Livre.";
        _afficherModal = true;
    }

    private void DemanderSuppression(EcritureDto ecriture)
    {
        _ecritureCible = ecriture;
        _actionType = ActionModal.Suppression;
        _modalTitre = "Suppression du brouillon";
        _modalMessage = $"Cette action est irréversible. Supprimer définitivement le brouillon {ecriture.Reference} ?";
        _afficherModal = true;
    }

    private void FermerModal()
    {
        if (_actionEnCours) return;
        _afficherModal = false;
        _ecritureCible = null;
    }

    private async Task ExecuterAction()
    {
        if (_ecritureCible == null || _actionEnCours) return;

        _actionEnCours = true;
        var cible = _ecritureCible;
        var validation = _actionType == ActionModal.Validation;
        try
        {
            var succes = validation
                ? await Api.ValiderEcritureAsync(cible.Id)
                : await Api.SupprimerEcritureAsync(cible.Id);

            if (succes)
            {
                Notif.Succes(
                    validation ? $"L'écriture {cible.Reference} est validée et verrouillée." : $"Le brouillon {cible.Reference} a été supprimé.",
                    validation ? "Écriture validée" : "Brouillon supprimé");
                _afficherModal = false;
                _ecritureCible = null;
                await ChargerDonnees();
            }
            else
            {
                Notif.Erreur(validation
                    ? $"{cible.Reference} n'a pas pu être validée. Vérifiez qu'elle est équilibrée et que l'exercice est ouvert."
                    : $"{cible.Reference} n'a pas pu être supprimée. Elle est peut-être déjà validée : actualisez la liste.");
            }
        }
        catch (Exception)
        {
            Notif.ErreurServeur();
        }
        finally
        {
            _actionEnCours = false;
        }
    }
}
