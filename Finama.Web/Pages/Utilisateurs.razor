@page "/utilisateurs"
@attribute [Authorize(Policy = "AdminTenant")]
@using Finama.Web.Models
@using Finama.Web.Services
@using Finama.Web.Shared
@using Radzen
@inject IUtilisateursService UtilisateursApi
@inject NavigationManager Nav
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject ApiClient Client

<div class="page-wrapper position-relative">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title"><i class="bi bi-shield-lock me-2"></i>Gestion des Utilisateurs</h2>
            <p class="page-subtitle text-muted">Attribuez les accès et gérez l'équipe de votre entreprise</p>
        </div>
        <button class="btn btn-primary shadow-sm px-4" @onclick="() => _afficherFormulaire = true">
            <i class="bi bi-person-plus-fill me-2"></i>Nouvel Utilisateur
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Utilisateur</th>
                            <th>Email</th>
                            <th>Rôle</th>
                            <th class="text-center">Statut</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_utilisateurs == null)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4">
                                    <div class="spinner-border text-primary" role="status"></div>
                                </td>
                            </tr>
                        }
                        else if (!_utilisateurs.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted small">Aucun utilisateur pour le moment.</td></tr>
                        }
                        else
                        {
                            @foreach (var user in _utilisateurs.Page(_page, _taille))
                            {
                                var occupe = _enCours.Contains(user.Id);
                                <tr class="@(user.EstActif ? "" : "opacity-75")">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar bg-primary-subtle text-primary rounded-circle me-2 d-flex align-items-center justify-content-center fw-bold" style="width: 35px; height: 35px;">
                                                @Initiales(user)
                                            </div>
                                            <span class="fw-bold">@user.Prenom @user.Nom</span>
                                        </div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-person-badge me-1"></i>@LibelleAcces(user)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill @(user.EstActif ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") px-2 py-1">
                                            @(user.EstActif ? "Actif" : "Suspendu")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-secondary" title="Voir la fiche" @onclick="() => AfficherDetails(user)">
                                                <i class="bi bi-eye-fill"></i>
                                            </button>
                                            <button class="btn btn-outline-secondary" title="Réinitialiser le mot de passe"
                                                    @onclick="() => DemanderReinitialisation(user)" disabled="@occupe">
                                                <i class="bi bi-key"></i>
                                            </button>
                                            <button class="btn @(user.EstActif ? "btn-outline-danger" : "btn-outline-success")"
                                                    title="@(user.EstActif ? "Suspendre l'accès" : "Réactiver l'accès")"
                                                    @onclick="() => DemanderBascule(user)" disabled="@occupe">
                                                @if (occupe)
                                                {
                                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                                }
                                                else
                                                {
                                                    <i class="bi @(user.EstActif ? "bi-person-x" : "bi-person-check")"></i>
                                                }
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (_utilisateurs is { Count: > 0 })
        {
            <div class="card-footer bg-transparent border-top py-3 px-3">
                <Pagination Page="_page" PageSize="_taille" TotalItems="_utilisateurs.Count" Unite="utilisateurs"
                            OnPageChange="p => _page = p" OnPageSizeChange="ChangerTaille" PageSizes="@(new[] { 10, 20, 50 })" />
            </div>
        }
    </div>
</div>

@* ===== Fiche utilisateur ===== *@
@if (_utilisateurSelectionne != null)
{
    var u = _utilisateurSelectionne;
    var occupe = _enCours.Contains(u.Id);

    <div class="offcanvas show offcanvas-end border-0 shadow-lg" tabindex="-1" style="visibility: visible; background: var(--bg-card); color: var(--text-main); width: 400px; max-width: 100vw; z-index: 1050;">
        <div class="offcanvas-header bg-light border-bottom p-4">
            <h5 class="offcanvas-title fw-bold"><i class="bi bi-card-text me-2"></i>Fiche Utilisateur</h5>
            <button type="button" class="btn-close" aria-label="Fermer" @onclick="FermerDetails"></button>
        </div>
        <div class="offcanvas-body p-4">
            <div class="text-center mb-4">
                <div class="avatar bg-primary text-white rounded-circle mx-auto d-flex align-items-center justify-content-center fw-bold shadow-sm mb-2" style="width: 70px; height: 70px; font-size: 1.5rem;">
                    @Initiales(u)
                </div>
                <h4 class="fw-bold mb-1">@u.Prenom @u.Nom</h4>
                <span class="badge @(u.EstActif ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") px-3 py-1 rounded-pill">
                    @(u.EstActif ? "Compte actif" : "Compte suspendu")
                </span>
            </div>

            <hr class="text-muted opacity-25" />

            <div class="mb-4">
                <h6 class="text-uppercase text-muted small fw-bold mb-3">Informations de connexion</h6>
                <div class="mb-3">
                    <label class="text-muted small d-block">Identifiant unique (ID)</label>
                    <span class="font-monospace small text-secondary">@u.Id</span>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Adresse email</label>
                    <span class="fw-semibold">@u.Email</span>
                </div>
            </div>

            <div class="mb-4">
                <h6 class="text-uppercase text-muted small fw-bold mb-3">Permissions et droits</h6>
                <div class="p-3 bg-light rounded border">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-shield-check text-primary me-2 fs-5"></i>
                        <span class="fw-bold">@LibelleAcces(u)</span>
                    </div>
                    <p class="small text-muted mb-0">@DescriptionAcces(u)</p>
                </div>

                @if (u.Role != "SuperAdmin")
                {
                    <button class="btn btn-sm btn-outline-primary mt-3" @onclick="() => OuvrirIdentite(u)" disabled="@occupe">
                        <i class="bi bi-pencil-square me-1"></i>Modifier nom, prénom, e-mail
                    </button>
                    <div class="mt-3">
                        <label class="form-label small fw-bold">Changer de profil</label>
                        <div class="input-group input-group-sm">
                            <select class="form-select" @bind="_nouvelAcces">
                                <optgroup label="Profils prêts à l'emploi">
                                    @foreach (var r in RolesFinama.Attribuables)
                                    {
                                        <option value="@($"r:{r.Valeur}")">@r.Libelle</option>
                                    }
                                </optgroup>
                                @if (_profilsPerso.Any())
                                {
                                    <optgroup label="Profils de l'entreprise">
                                        @foreach (var p in _profilsPerso)
                                        {
                                            <option value="@($"p:{p.Id}")">@p.Nom</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            <button class="btn btn-primary" @onclick="() => ChangerAcces(u)" disabled="@(occupe || _nouvelAcces == AccesActuel(u))">Appliquer</button>
                        </div>
                        <div class="form-text">Droits appliqués immédiatement ; menus mis à jour à sa prochaine connexion. <a href="/administration/profils">Gérer les profils</a></div>
                    </div>
                }
            </div>

            <div class="d-grid gap-2 mt-5">
                <button class="btn btn-outline-primary btn-sm" @onclick="() => DemanderReinitialisation(u)" disabled="@occupe">
                    <i class="bi bi-key me-2"></i>Réinitialiser le mot de passe
                </button>
                <button class="btn @(u.EstActif ? "btn-outline-danger" : "btn-outline-success") btn-sm" @onclick="() => DemanderBascule(u)" disabled="@occupe">
                    <i class="bi @(u.EstActif ? "bi-person-x" : "bi-person-check") me-2"></i>
                    @(u.EstActif ? "Suspendre l'accès" : "Réactiver l'accès")
                </button>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show" style="z-index: 1040; backdrop-filter: blur(2px); background: rgba(0,0,0,0.2);" @onclick="FermerDetails"></div>
}

@* ===== Nouvel utilisateur ===== *@
@if (_afficherFormulaire)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-light border-0">
                    <h5 class="fw-bold modal-title"><i class="bi bi-person-plus me-2"></i>Ajouter un collaborateur</h5>
                    <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => _afficherFormulaire = false"></button>
                </div>
                <EditForm Model="_request" OnValidSubmit="EnregistrerUtilisateur">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Nom</label>
                                <input class="form-control" maxlength="150" @bind="_request.Nom" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Prénom</label>
                                <input class="form-control" maxlength="150" @bind="_request.Prenom" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">Adresse email</label>
                                <ChampEmail @bind-Value="_request.Email" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">Mot de passe temporaire</label>
                                <input type="password" class="form-control" minlength="10" maxlength="128" autocomplete="new-password" @bind="_request.MotDePasse" @bind:event="oninput" required />
                                <div class="form-text @(!string.IsNullOrEmpty(_request.MotDePasse) && _request.MotDePasse.Length < 10 ? "text-danger" : "")">
                                    10 caractères minimum. Le collaborateur devra le modifier à sa première connexion.
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">Profil (ce que la personne pourra faire)</label>
                                <select class="form-select" @bind="_accesCreation">
                                    <optgroup label="Profils prêts à l'emploi">
                                        @foreach (var r in RolesFinama.Attribuables)
                                        {
                                            <option value="@($"r:{r.Valeur}")">@r.Libelle — @r.Acces</option>
                                        }
                                    </optgroup>
                                    @if (_profilsPerso.Any())
                                    {
                                        <optgroup label="Profils de l'entreprise">
                                            @foreach (var p in _profilsPerso)
                                            {
                                                <option value="@($"p:{p.Id}")">@p.Nom</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                <div class="small text-muted mt-2 p-2 bg-light rounded border">@DescriptionChoix(_accesCreation)</div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light" @onclick="() => _afficherFormulaire = false">Annuler</button>
                        <button type="submit" class="btn btn-primary px-4"
                                disabled="@(string.IsNullOrWhiteSpace(_request.Nom) || string.IsNullOrWhiteSpace(_request.Prenom) || ControlesSaisie.Email(_request.Email) is not null || string.IsNullOrWhiteSpace(_request.Email) || (_request.MotDePasse?.Length ?? 0) < 10)">Créer l'accès</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* ===== Mot de passe temporaire à transmettre (si l'email n'a pas pu partir) ===== *@
@if (_motDePasseAffiche is not null)
{
    <div class="modal-backdrop fade show" style="z-index:1065"></div>
    <div class="modal fade show d-block" style="z-index:1070" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Mot de passe temporaire</h5>
                    <button type="button" class="btn-close" aria-label="Fermer" @onclick="() => _motDePasseAffiche = null"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">L'email n'a pas pu être envoyé. Transmettez ce mot de passe à @_motDePasseAffiche.Value.Utilisateur. Il ne sera plus affiché.</p>
                    <div class="input-group">
                        <input class="form-control font-monospace" readonly value="@_motDePasseAffiche.Value.MotDePasse" />
                        <button class="btn btn-outline-primary" @onclick="CopierMotDePasse">
                            <i class="bi @(_copie ? "bi-check2" : "bi-clipboard") me-1"></i>@(_copie ? "Copié" : "Copier")
                        </button>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-primary" @onclick="() => _motDePasseAffiche = null">Terminé</button>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDialog @ref="_confirm" />

@if (_identite is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15,23,42,.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Modifier l'utilisateur</h5>
                    <button class="btn-close" @onclick="() => _identite = null" disabled="@_identiteBusy"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Nom</label>
                            <input class="form-control" maxlength="150" @bind="_identite.Nom" @bind:event="oninput" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Prénom</label>
                            <input class="form-control" maxlength="150" @bind="_identite.Prenom" @bind:event="oninput" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">E-mail (identifiant de connexion)</label>
                            <ChampEmail @bind-Value="_identite.Email" />
                            @if (!string.Equals(_identite.Email?.Trim(), _identite.EmailInitial, StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="form-text text-warning">Nouvelle adresse = nouvel identifiant : l'utilisateur sera déconnecté et recevra un code à sa prochaine connexion.</div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="() => _identite = null" disabled="@_identiteBusy">Annuler</button>
                    <button class="btn btn-primary fw-bold" @onclick="EnregistrerIdentite"
                            disabled="@(_identiteBusy || string.IsNullOrWhiteSpace(_identite.Nom) || string.IsNullOrWhiteSpace(_identite.Prenom) || ControlesSaisie.Email(_identite.Email) is not null || string.IsNullOrWhiteSpace(_identite.Email))">
                        @if (_identiteBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Enregistrer
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ConfirmDialog _confirm = default!;

    private List<UtilisateurDto>? _utilisateurs;
    private UtilisateurDto? _utilisateurSelectionne;
    private bool _afficherFormulaire = false;
    private CreerCollaborateurRequest _request = new();

    private readonly HashSet<Guid> _enCours = new();
    private (string Utilisateur, string MotDePasse)? _motDePasseAffiche;
    private bool _copie;

    private int _page = 1;
    private int _taille = 10;

    private async Task ChargerUtilisateurs()
    {
        _utilisateurs = await UtilisateursApi.GetUtilisateursTenantAsync();
        _page = PagingExtensions.PageValide(_page, _utilisateurs?.Count ?? 0, _taille);
    }

    private void ChangerTaille(int taille) { _taille = taille; _page = 1; }

    // ─── Accès : profil prédéfini (« r:5 ») ou personnalisé (« p:guid ») ───
    private sealed record ProfilPerso(Guid Id, string Nom, string? Description, string[] Permissions, int NbUtilisateurs);
    private sealed record AccesUtilisateur(Guid Id, int RoleValeur, Guid? ProfilId, string? ProfilNom);

    private List<ProfilPerso> _profilsPerso = new();
    private Dictionary<Guid, AccesUtilisateur> _acces = new();
    private string _nouvelAcces = "r:1";
    private string _accesCreation = "r:1";

    protected override async Task OnInitializedAsync()
    {
        await ChargerUtilisateurs();
        await ChargerAccesAsync();
    }

    private async Task ChargerAccesAsync()
    {
        // Profils personnalisés indisponibles : profils prédéfinis seulement
        var profils = await Client.GetAsync<List<ProfilPerso>>("api/profils");
        var acces = await Client.GetAsync<List<AccesUtilisateur>>("api/Utilisateurs/acces");
        if (!profils.Succes || !acces.Succes) return;
        _profilsPerso = profils.Donnees ?? new();
        _acces = (acces.Donnees ?? new()).ToDictionary(a => a.Id);
    }

    private string AccesActuel(UtilisateurDto u)
        => _acces.TryGetValue(u.Id, out var a) && a.ProfilId is { } p ? $"p:{p}" : $"r:{RolesFinama.ParCode(u.Role)?.Valeur ?? 1}";

    private string LibelleAcces(UtilisateurDto u)
        => _acces.TryGetValue(u.Id, out var a) && a.ProfilNom is { } nom ? nom : ConvertirRoleAffichage(u.Role);

    private string DescriptionAcces(UtilisateurDto u)
        => _acces.TryGetValue(u.Id, out var a) && a.ProfilId is { } p
            ? _profilsPerso.FirstOrDefault(x => x.Id == p)?.Description ?? "Profil personnalisé de l'entreprise."
            : ObtenirDescriptionRole(u.Role);

    private string DescriptionChoix(string choix)
    {
        var (role, profilId) = Decoder(choix);
        return profilId is { } p
            ? _profilsPerso.FirstOrDefault(x => x.Id == p)?.Description ?? "Profil personnalisé de l'entreprise."
            : RolesFinama.Attribuables.FirstOrDefault(r => r.Valeur == role)?.Description ?? "";
    }

    private static (int Role, Guid? ProfilId) Decoder(string choix)
        => choix.StartsWith("p:") && Guid.TryParse(choix[2..], out var g) ? (3, g)
         : int.TryParse(choix.Length > 2 ? choix[2..] : "1", out var r) ? (r, null) : (1, null);

    private void AfficherDetails(UtilisateurDto user)
    {
        _utilisateurSelectionne = user;
        _nouvelAcces = AccesActuel(user);
    }

    private async Task ChangerAcces(UtilisateurDto u)
    {
        var (role, profilId) = Decoder(_nouvelAcces);
        _enCours.Add(u.Id);
        try
        {
            var r = await Client.PutAsync($"api/Utilisateurs/{u.Id}/acces", new { Role = role, ProfilId = profilId },
                "L'accès n'a pas pu être modifié.", "Accès modifié.");
            Notifier(r.Succes, r.Succes ? "Accès modifié" : "Action impossible", r.Message);
            if (r.Succes) { await ChargerUtilisateurs(); await ChargerAccesAsync(); SynchroniserSelection(u.Id); }
        }
        finally { _enCours.Remove(u.Id); }
    }

    // ─── Modification de l'identité (nom, prénom, e-mail) ───
    private sealed class Identite { public Guid Id { get; init; } public string Nom { get; set; } = ""; public string Prenom { get; set; } = ""; public string Email { get; set; } = ""; public string EmailInitial { get; init; } = ""; }
    private Identite? _identite;
    private bool _identiteBusy;

    private void OuvrirIdentite(UtilisateurDto u)
        => _identite = new Identite { Id = u.Id, Nom = u.Nom, Prenom = u.Prenom, Email = u.Email, EmailInitial = u.Email };

    private async Task EnregistrerIdentite()
    {
        if (_identite is null) return;
        _identiteBusy = true;
        try
        {
            var r = await Client.PutAsync($"api/Utilisateurs/{_identite.Id}/identite",
                new { Nom = _identite.Nom.Trim(), Prenom = _identite.Prenom.Trim(), Email = _identite.Email.Trim() });
            Notifier(r.Succes, r.Succes ? "Utilisateur modifié" : "Modification impossible", r.Message);
            if (r.Succes)
            {
                var id = _identite.Id;
                _identite = null;
                await ChargerUtilisateurs();
                SynchroniserSelection(id);
            }
        }
        catch { Notifier(false, "Erreur de communication", "Serveur injoignable."); }
        finally { _identiteBusy = false; }
    }
    private void FermerDetails() => _utilisateurSelectionne = null;

    private static string Initiales(UtilisateurDto u)
    {
        var p = string.IsNullOrWhiteSpace(u.Prenom) ? "" : u.Prenom.Trim()[..1];
        var n = string.IsNullOrWhiteSpace(u.Nom) ? "" : u.Nom.Trim()[..1];
        return (p + n).ToUpper();
    }

    private async Task EnregistrerUtilisateur()
    {
        var (role, profilId) = Decoder(_accesCreation);
        _request.Role = role;
        _request.ProfilId = profilId;
        var erreur = await UtilisateursApi.CreerCollaborateurAsync(_request);
        if (erreur == null)
        {
            NotificationService.Succes($"L'accès de {_request.Prenom} {_request.Nom} est créé. Il devra changer son mot de passe à sa première connexion.", "Collaborateur ajouté");
            _request = new();
            _accesCreation = "r:1";
            _afficherFormulaire = false;
            await ChargerUtilisateurs();
            await ChargerAccesAsync();
        }
        else
        {
            NotificationService.Erreur(erreur, "Création impossible");
        }
    }

    // ---- Suspendre / réactiver ----
    private Task DemanderBascule(UtilisateurDto u)
    {
        var suspendre = u.EstActif;
        return Confirmer(
            suspendre ? "Suspendre cet accès ?" : "Réactiver cet accès ?",
            suspendre
                ? $"{u.Prenom} {u.Nom} sera déconnecté et ne pourra plus se connecter tant que son accès n'est pas réactivé."
                : $"{u.Prenom} {u.Nom} pourra de nouveau se connecter.",
            suspendre ? "Suspendre" : "Réactiver",
            suspendre ? "danger" : "success",
            async () =>
            {
                _enCours.Add(u.Id);
                try
                {
                    var r = await UtilisateursApi.ModifierStatutUtilisateurAsync(u.Id, !u.EstActif);
                    Notifier(r.Succes, r.Succes ? "Accès mis à jour" : "Action impossible", r.Message);
                    if (r.Succes) { await ChargerUtilisateurs(); SynchroniserSelection(u.Id); }
                }
                finally { _enCours.Remove(u.Id); }
            });
    }

    // ---- Réinitialiser le mot de passe ----
    private Task DemanderReinitialisation(UtilisateurDto u)
    {
        return Confirmer(
            "Réinitialiser le mot de passe ?",
            $"Un mot de passe temporaire sera envoyé à {u.Email}. Ses sessions ouvertes seront fermées et il devra choisir un nouveau mot de passe à sa prochaine connexion.",
            "Réinitialiser", "primary",
            async () =>
            {
                _enCours.Add(u.Id);
                try
                {
                    var r = await UtilisateursApi.ReinitialiserMotDePasseUtilisateurAsync(u.Id);
                    Notifier(r.Succes, r.Succes ? "Mot de passe réinitialisé" : "Action impossible", r.Message);
                    if (r.Succes && !string.IsNullOrEmpty(r.MotDePasseTemporaire))
                    {
                        _copie = false;
                        _motDePasseAffiche = ($"{u.Prenom} {u.Nom}", r.MotDePasseTemporaire);
                    }
                }
                finally { _enCours.Remove(u.Id); }
            });
    }

    // Style "danger" = action destructrice (focus sur « Annuler ») ; le reste est une simple question.
    private Task Confirmer(string titre, string message, string libelle, string style, Func<Task> action) =>
        _confirm.ExecuterAsync(message, titre, libelle,
            style == "danger" ? ConfirmationType.Danger : ConfirmationType.Question,
            async () =>
            {
                try { await action(); }
                catch (Exception ex) { Notifier(false, "Erreur de communication", ex.Message); }
            });

    private async Task CopierMotDePasse()
    {
        if (_motDePasseAffiche is null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _motDePasseAffiche.Value.MotDePasse);
        _copie = true;
    }

    // Garde la fiche ouverte à jour après une action
    private void SynchroniserSelection(Guid id)
        => _utilisateurSelectionne = _utilisateurs?.FirstOrDefault(x => x.Id == id) is { } maj && _utilisateurSelectionne?.Id == id
            ? maj : _utilisateurSelectionne;

    private void Notifier(bool succes, string titre, string message)
    {
        if (succes) NotificationService.Succes(message, titre);
        else NotificationService.Erreur(message, titre);
    }

    private static string ConvertirRoleAffichage(string roleBrut) => RolesFinama.Libelle(roleBrut);

    private static string ObtenirDescriptionRole(string roleBrut)
        => roleBrut == "SuperAdmin" ? "Administrateur de la plateforme Finama." : RolesFinama.ParCode(roleBrut)?.Description ?? "Droits standards du profil.";
}
