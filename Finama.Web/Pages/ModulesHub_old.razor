@page "/modules"
@inject NavigationManager Nav

<div class="container py-5">
    <div class="text-center mb-5">
        <div class="brand-logo mb-2 d-inline-block">
            <img src="images/logo-icon.svg" alt="Finama" style="width: 48px; height: 48px;" />
        </div>
        <h1 class="fw-bold text-dark">Espaces de travail Finama</h1>
        <p class="text-muted">Sélectionnez un module pour accéder à vos outils de gestion</p>
    </div>

    <div class="row g-4 justify-content-center max-w-4k">
        <!-- Carte 1 : Comptabilité & Finance -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 module-card" @onclick='() => Nav.NavigateTo("/")' style="cursor: pointer;">
                <div class="card-body text-center p-4 d-flex flex-column align-items-center">
                    <div class="bg-primary text-white rounded-4 d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 70px; height: 70px;">
                        <i class="bi bi-wallet2 fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Comptabilité & Finance</h4>
                    <p class="text-muted small mt-2">Gestion des écritures, factures, tiers, balance, grand livre et plan OHADA.</p>
                    <span class="btn btn-outline-primary btn-sm mt-auto w-100 rounded-pill fw-bold">Ouvrir l'espace</span>
                </div>
            </div>
        </div>

        <!-- Carte 2 : Commerce & POS -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 module-card" @onclick='() => Nav.NavigateTo("/commerce/caisse")' style="cursor: pointer;">
                <div class="card-body text-center p-4 d-flex flex-column align-items-center">
                    <div class="bg-success text-white rounded-4 d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 70px; height: 70px;">
                        <i class="bi bi-cart3 fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Commerce & POS</h4>
                    <p class="text-muted small mt-2">Caisse tactile, gestion des stocks FEFO, catalogue produits et librairie.</p>
                    <span class="btn btn-outline-success btn-sm mt-auto w-100 rounded-pill fw-bold">Ouvrir l'espace</span>
                </div>
            </div>
        </div>

        <!-- Carte 3 : Administration -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 module-card" @onclick='() => Nav.NavigateTo("/entreprise")' style="cursor: pointer;">
                <div class="card-body text-center p-4 d-flex flex-column align-items-center">
                    <div class="bg-warning text-dark rounded-4 d-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 70px; height: 70px;">
                        <i class="bi bi-gear fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark">Administration</h4>
                    <p class="text-muted small mt-2">Paramètres de l'entreprise, gestion des utilisateurs, rôles et classes comptables.</p>
                    <span class="btn btn-outline-dark btn-sm mt-auto w-100 rounded-pill fw-bold">Ouvrir l'espace</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .module-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .module-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.1) !important;
        }
</style>