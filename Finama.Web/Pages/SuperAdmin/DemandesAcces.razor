@page "/superadmin/demandes-acces"
@using Finama.Web.Models
@using Finama.Web.Services
@using Finama.Web.Shared
@attribute [Authorize(Roles = "SuperAdmin")]
@inject ITenantAdminService TenantService
@inject NotificationService Notif

<PageTitle>Demandes d'accès | Administration Finama</PageTitle>

<div class="container-fluid py-3 px-2 px-md-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <h3 class="mb-1 fw-bold text-dark">Demandes d'accès</h3>
            <p class="text-muted small mb-0">Approuver une demande crée l'entreprise, son plan comptable et envoie les identifiants au demandeur.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm px-3" href="/superadmin/tenants">
                <i class="bi bi-buildings me-1"></i> Entreprises
            </a>
            <button class="btn btn-outline-primary btn-sm px-3" @onclick="ChargerDemandes" disabled="@chargement">
                <i class="bi bi-arrow-clockwise me-1 @(chargement ? "spin" : "")"></i> Actualiser
            </button>
        </div>
    </div>

    @if (demandes is null)
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <div class="spinner-border text-primary mx-auto mb-3" role="status"></div>
            <p class="text-muted mb-0">Chargement des demandes...</p>
        </div>
    }
    else
    {
        <ul class="nav nav-pills mb-3 gap-1">
            <li class="nav-item">
                <button class="nav-link @(onglet == Onglet.EnAttente ? "active" : "")" @onclick="() => { onglet = Onglet.EnAttente; _page = 1; }">
                    À traiter @if (NbEnAttente > 0) { <span class="badge bg-danger ms-1">@NbEnAttente</span> }
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(onglet == Onglet.Traitees ? "active" : "")" @onclick="() => { onglet = Onglet.Traitees; _page = 1; }">
                    Traitées <span class="opacity-75 ms-1">@(demandes.Count - NbEnAttente)</span>
                </button>
            </li>
        </ul>

        @if (!Affichees.Any())
        {
            <div class="card border-0 shadow-sm p-5 text-center">
                <i class="bi bi-inbox fs-1 text-muted mb-2"></i>
                <h5 class="fw-normal">@(onglet == Onglet.EnAttente ? "Aucune demande à traiter" : "Aucune demande traitée")</h5>
                <p class="text-muted small mb-0">
                    @(onglet == Onglet.EnAttente ? "Les nouvelles demandes apparaîtront ici." : "Les demandes approuvées ou refusées apparaîtront ici.")
                </p>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm d-none d-md-block overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr class="text-secondary small">
                                <th>Entreprise</th>
                                <th>Contact</th>
                                <th>Coordonnées</th>
                                <th>Message</th>
                                <th>Reçue le</th>
                                <th class="text-end">@(onglet == Onglet.EnAttente ? "Actions" : "Décision")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in AfficheesPage)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@d.NomEntreprise</td>
                                    <td>@d.PrenomContact @d.NomContact</td>
                                    <td>
                                        <div class="small"><i class="bi bi-envelope text-muted me-1"></i>@d.Email</div>
                                        @if (!string.IsNullOrEmpty(d.Telephone))
                                        {
                                            <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@d.Telephone</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-truncate d-inline-block" style="max-width:220px" title="@d.Message">
                                            @(string.IsNullOrWhiteSpace(d.Message) ? "—" : d.Message)
                                        </span>
                                    </td>
                                    <td><span class="badge bg-light text-dark fw-normal">@d.DateDemande.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></td>
                                    <td class="text-end">@Boutons(d)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-md-none d-flex flex-column gap-3">
                @foreach (var d in AfficheesPage)
                {
                    <div class="card border-0 shadow-sm p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-dark mb-0">@d.NomEntreprise</h5>
                            <span class="badge bg-light text-dark fw-normal small">@d.DateDemande.ToLocalTime().ToString("dd/MM/yy HH:mm")</span>
                        </div>
                        <div class="mb-2">
                            <div class="fw-semibold">@d.PrenomContact @d.NomContact</div>
                            <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@d.Email</div>
                            @if (!string.IsNullOrEmpty(d.Telephone))
                            {
                                <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@d.Telephone</div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(d.Message))
                        {
                            <div class="p-2 bg-light rounded small text-secondary mb-3"><i class="bi bi-chat-quote me-1"></i>@d.Message</div>
                        }
                        <div class="d-flex justify-content-end">@Boutons(d)</div>
                    </div>
                }
            </div>

            <div class="mt-3">
                <Pagination Page="PageCourante" PageSize="_taille" TotalItems="Affichees.Count()" Unite="demandes"
                            OnPageChange="p => _page = p" OnPageSizeChange="ChangerTaille" PageSizes="@(new[] { 10, 20, 50 })" />
            </div>
        }
    }
</div>

<ConfirmDialog Visible="@(confirmation is not null)"
               Titre="@confirmation?.Titre"
               Message="@confirmation?.Message"
               LibelleConfirmer="@(confirmation?.Libelle ?? "Confirmer")"
               Style="@(confirmation?.Style ?? "primary")"
               Busy="traitementEnCours"
               OnConfirm="ExecuterConfirmation"
               OnCancel="() => confirmation = null" />

@code {
    private enum Onglet { EnAttente, Traitees }
    private record Confirmation(string Titre, string Message, string Libelle, string Style, Func<Task<ResultatApi>> Action);

    // Statut : 0 = en attente, 1 = approuvée, 2 = rejetée
    private List<DemandeAccesResponseDto>? demandes;
    private Onglet onglet = Onglet.EnAttente;
    private bool chargement;
    private bool traitementEnCours;
    private Confirmation? confirmation;

    private int _page = 1;
    private int _taille = 10;
    private int PageCourante => PagingExtensions.PageValide(_page, Affichees.Count(), _taille);
    private IEnumerable<DemandeAccesResponseDto> AfficheesPage => Affichees.Page(PageCourante, _taille);
    private void ChangerTaille(int taille) { _taille = taille; _page = 1; }

    private int NbEnAttente => demandes?.Count(d => d.Statut == 0) ?? 0;

    private IEnumerable<DemandeAccesResponseDto> Affichees => (demandes ?? new())
        .Where(d => onglet == Onglet.EnAttente ? d.Statut == 0 : d.Statut != 0)
        .OrderByDescending(d => d.DateDemande);

    protected override async Task OnInitializedAsync()
    {
        // Ouvre directement l'onglet des demandes traitées s'il n'y a rien à traiter
        await ChargerDemandes();
        if (NbEnAttente == 0 && demandes?.Count > 0) onglet = Onglet.Traitees;
    }

    private async Task ChargerDemandes()
    {
        chargement = true;
        try { demandes = await TenantService.ObtenirDemandesAsync(); }
        catch (Exception)
        {
            demandes ??= new();
            Notifier("Impossible de charger les demandes. Vérifiez votre connexion puis actualisez.", "danger");
        }
        finally { chargement = false; }
    }

    private RenderFragment Boutons(DemandeAccesResponseDto d) => d.Statut == 0
        ? @<div class="btn-group btn-group-sm">
              <button class="btn btn-success px-3" @onclick="() => DemanderApprobation(d)">
                  <i class="bi bi-check-lg me-1"></i>Approuver
              </button>
              <button class="btn btn-outline-danger" @onclick="() => DemanderRefus(d)">
                  <i class="bi bi-x-lg me-1"></i>Refuser
              </button>
          </div>
        : @<span class="badge border px-2 py-1 @(d.Statut == 1 ? "bg-success-subtle text-success border-success-subtle" : "bg-danger-subtle text-danger border-danger-subtle")">
              <i class="bi @(d.Statut == 1 ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>@(d.Statut == 1 ? "Approuvée" : "Refusée")
          </span>;

    private void DemanderApprobation(DemandeAccesResponseDto d)
    {
        confirmation = new Confirmation(
            "Approuver cette demande ?",
            $"« {d.NomEntreprise} » sera créée avec son plan comptable et un essai gratuit. Les identifiants temporaires seront envoyés à {d.Email}.",
            "Approuver et créer", "success",
            () => TenantService.ApprouverDemandeAsync(d.Id));
    }

    private void DemanderRefus(DemandeAccesResponseDto d)
    {
        confirmation = new Confirmation(
            "Refuser cette demande ?",
            $"La demande de « {d.NomEntreprise} » sera marquée comme refusée. Aucun compte ne sera créé.",
            "Refuser", "danger",
            () => TenantService.RefuserDemandeAsync(d.Id));
    }

    private async Task ExecuterConfirmation()
    {
        if (confirmation is null || traitementEnCours) return;
        traitementEnCours = true;
        try
        {
            var r = await confirmation.Action();
            Notifier(r.Message, r.Succes ? "success" : "danger");
            // Recharge dans tous les cas : une demande déjà traitée doit disparaître de « À traiter »
            await ChargerDemandes();
        }
        catch (Exception ex)
        {
            Notifier($"Erreur de communication : {ex.Message}", "danger");
        }
        finally
        {
            traitementEnCours = false;
            confirmation = null;
        }
    }

    private void Notifier(string message, string type)
    {
        if (type == "success") Notif.Succes(message, "Terminé");
        else Notif.Erreur(message);
    }
}
