    // ── Paiement ──
    private void OuvrirPaiement()
    {
        if (!_panier.Any()) return;
        _clientRequestId = Guid.NewGuid();   // une nouvelle vente = une nouvelle clé d'idempotence
        _paiements.Clear();
        _afficherPaiement = true;
    }

    private void FermerPaiement() => _afficherPaiement = false;

    private void AjouterPaiement(ModePaiementPos mode)
    {
        _paiements.Add(new PaiementSaisi { Mode = mode, Montant = Reste > 0 ? Reste : 0 });
    }

    private async Task ValiderVente()
    {
        if (_session == null || !PaiementValide) return;

        _enCoursEncaissement = true;
        try
        {
            var paiementsRetenus = _paiements.Where(p => p.Montant > 0).ToList();

            var requete = new CreerVentePosRequest
            {
                ClientRequestId = _clientRequestId,   // identique en cas de renvoi : jamais de doublon
                SessionCaisseId = _session.Id,
                ClientId = _client?.Id,
                Lignes = _panier.Select(l => new LigneVentePosDto { ProduitId = l.ProduitId, Quantite = l.Quantite }).ToList(),
                Paiements = paiementsRetenus.Select(p => new PaiementPosDto
                {
                    Mode = p.Mode,
                    Montant = p.Montant,
                    Reference = string.IsNullOrWhiteSpace(p.Reference) ? null : p.Reference
                }).ToList()
            };

            TicketPosDto? ticket = null;
            var horsLigne = _horsLigne;
            if (!horsLigne)
            {
                ticket = await CaisseApi.EncaisserVenteAsync(requete);
                if (ticket == null && EstErreurReseau())
                    horsLigne = _horsLigne = true;   // réseau perdu pendant l'encaissement : on garde la vente sur l'appareil
                else if (ticket == null)
                {
                    Notif.Erreur(ErreurCommerce.Derniere ?? "Une erreur est survenue.", "Échec de l'encaissement");
                    return;
                }
            }

            if (horsLigne)
            {
                if (paiementsRetenus.Any(p => p.Mode is ModePaiementPos.Credit or ModePaiementPos.Points))
                {
                    Notif.Avertir("Hors connexion, le crédit client et les points ne sont pas utilisables. Choisissez un autre paiement.", "Hors connexion");
                    return;
                }
                ticket = await MettreEnFileAsync(requete, paiementsRetenus);
                if (ticket is null) return;
            }

            // Photo de la vente AVANT de vider le panier : sert au ticket et à la réimpression
            _dernierRecu = new RecuCaisse
            {
                Ticket = ticket!,
                EstHorsLigne = horsLigne,
                Entreprise = _entrepriseNom,
                Logo = _logo,
                Magasin = _magasinNom,
                MagasinAdresse = _magasinAdresse,
                MagasinTelephone = _magasinTelephone,
                Caisse = _caisseLibelle,
                ClientNom = _client?.Nom,
                ClientTelephone = _client?.Telephone,
                Lignes = _panier.Select(l => new LigneRecu(l.Designation, l.Quantite, l.PrixUnitaire, l.Total, l.Unite)).ToList(),
                Paiements = paiementsRetenus.Select(p => new PaiementRecu(LibelleMode(p.Mode), p.Montant, p.Reference)).ToList()
            };

            _panier.Clear();
            _paiements.Clear();
            _client = null;
            _afficherPaiement = false;
            if (!horsLigne)
                _ = PrechargerRecuPdfAsync(ticket!.Id);   // prêt avant le clic : le partage reste instantané sur mobile

            if (_impressionAuto)
                await ImprimerAsync(_dernierRecu, reimpression: false);

            await ChargerArticles();
            await FocusScannerAsync();
        }
        finally
        {
            _enCoursEncaissement = false;
        }
    }

    // ── Ticket : impression / partage ──
    private async Task ImprimerDernierTicket()
    {
        if (_dernierRecu != null)
            await ImprimerAsync(_dernierRecu, reimpression: true);
    }

    private async Task ImprimerAsync(RecuCaisse recu, bool reimpression)
    {
        if (_jsPos is null)
        {
            Notif.Avertir("Impression indisponible dans ce navigateur.", "Ticket");
            return;
        }

        _recuAImprimer = recu with { Reimpression = reimpression };

        // QR du ticket : numéro, date et montant, lisibles par n'importe quel téléphone (preuve d'achat, retour, facture sur demande)
        try
        {
            _jsCodes ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/finama-codes.js");
            var t = recu.Ticket;
            _qrTicket = await _jsCodes.InvokeAsync<string>("qrSvg",
                $"{(string.IsNullOrWhiteSpace(recu.Entreprise) ? recu.Magasin : recu.Entreprise)}\nTicket {t.NumeroTicket}\n{t.DateVente.ToLocalTime():dd/MM/yyyy HH:mm}\nTotal {t.TotalTTC:N0} FCFA");
        }
        catch { _qrTicket = null; /* ticket imprimé sans QR */ }

        StateHasChanged();          // rend le ticket dans la zone d'impression
        await Task.Yield();

        try { await _jsPos.InvokeVoidAsync("imprimerTicket"); }
        catch { Notif.Avertir("L'impression n'a pas pu être lancée.", "Ticket"); }
    }

    // ══════════════ MODE HORS CONNEXION ══════════════
    private IJSObjectReference? _jsHorsLigne;
    private bool _horsLigne;
    private int _ventesEnAttente, _ventesEnErreur;
    private List<VenteEnFile> _file = new();
    private bool _afficherFile, _synchronisation;
    private readonly CancellationTokenSource _arretSynchronisation = new();

    private const string CleContexte = "contexte-caisse";
    private const string MessageReseau = "Impossible de joindre le serveur";

    /// <summary>Vente gardée sur l'appareil (même forme que dans IndexedDB).</summary>
    public sealed class VenteEnFile
    {
        public Guid Id { get; set; }
        public string NumeroHorsLigne { get; set; } = "";
        public DateTime DateVenteLocale { get; set; }
        public decimal Total { get; set; }
        public string Statut { get; set; } = "attente";
        public string? Erreur { get; set; }
        public CreerVentePosRequest Requete { get; set; } = new();
    }

    /// <summary>Ce qu'il faut pour vendre sans réseau : magasin, session ouverte, catalogue (dernier chargement en ligne).</summary>
    public sealed class ContexteCaisse
    {
        public string Utilisateur { get; set; } = "";
        public Guid MagasinId { get; set; }
        public string MagasinNom { get; set; } = "";
        public string? MagasinAdresse { get; set; }
        public string? MagasinTelephone { get; set; }
        public SessionPosDto? Session { get; set; }
        public string CaisseLibelle { get; set; } = "";
        public string CaisseCode { get; set; } = "";
        public List<ProduitCommerceDto> Articles { get; set; } = new();
        public DateTime EnregistreLe { get; set; }
    }

    private bool EstErreurReseau() => ErreurCommerce.Derniere?.StartsWith(MessageReseau) == true;

    private async Task<bool> EnLigneAsync()
    {
        try { return _jsHorsLigne is null || await _jsHorsLigne.InvokeAsync<bool>("enLigne"); } catch { return true; }
    }

    private async Task<string> UtilisateurAsync()
    {
        var etat = await AuthState.GetAuthenticationStateAsync();
        return etat.User.FindFirst("sub")?.Value ?? etat.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    }

    private async Task EnregistrerContexteLocalAsync()
    {
        if (_jsHorsLigne is null || _session is null || _magasinId is null) return;
        try
        {
            await _jsHorsLigne.InvokeVoidAsync("ecrire", CleContexte, new ContexteCaisse
            {
                Utilisateur = await UtilisateurAsync(),
                MagasinId = _magasinId.Value, MagasinNom = _magasinNom, MagasinAdresse = _magasinAdresse, MagasinTelephone = _magasinTelephone,
                Session = _session, CaisseLibelle = _caisseLibelle,
                CaisseCode = _caisses.FirstOrDefault(c => c.Id == _session.CaisseId)?.Code ?? "C",
                Articles = _articles, EnregistreLe = DateTime.UtcNow
            });
        }
        catch { /* stockage indisponible (navigation privée) : pas de mode hors connexion */ }
    }

    private async Task ChargerContexteLocalAsync()
    {
        if (_jsHorsLigne is null) return;
        try
        {
            var c = await _jsHorsLigne.InvokeAsync<ContexteCaisse?>("lire", CleContexte);
            if (c?.Session is null || c.Utilisateur != await UtilisateurAsync()) return;   // jamais la caisse d'un autre utilisateur

            _horsLigne = true;
            _magasinId = c.MagasinId; _magasinNom = c.MagasinNom; _magasinAdresse = c.MagasinAdresse; _magasinTelephone = c.MagasinTelephone;
            _session = c.Session; _caisseLibelle = c.CaisseLibelle;
            _caisses = new() { new CaissePosDto { Id = c.Session.CaisseId, Code = c.CaisseCode, Libelle = c.CaisseLibelle, SessionOuverte = true } };
            _articles = c.Articles;
            FiltrerArticles();
            Notif.Avertir($"Pas de réseau : la caisse fonctionne avec le catalogue du {c.EnregistreLe.ToLocalTime():dd/MM à HH:mm}. Les ventes seront envoyées au retour du réseau.", "Hors connexion");
        }
        catch { }
    }

    /// <summary>Garde la vente sur l'appareil et renvoie un ticket provisoire (numéro HL-CAISSE-AAMMJJ-n).</summary>
    private async Task<TicketPosDto?> MettreEnFileAsync(CreerVentePosRequest requete, List<PaiementSaisi> paiements)
    {
        if (_jsHorsLigne is null || _session is null)
        {
            Notif.Erreur("Cet appareil ne peut pas garder de ventes hors connexion (navigation privée ?).", "Hors connexion");
            return null;
        }

        var maintenant = DateTime.UtcNow;
        var code = new string((_caisses.FirstOrDefault(c => c.Id == _session.CaisseId)?.Code ?? "C").ToUpperInvariant().Where(char.IsLetterOrDigit).Take(10).ToArray());
        if (code.Length == 0) code = "C";
        var jour = maintenant.ToLocalTime().ToString("yyMMdd");
        var n = await _jsHorsLigne.InvokeAsync<int>("prochainNumero", $"compteur:{_session.CaisseId}:{jour}");
        var numero = $"HL-{code}-{jour}-{n:D4}";

        var vente = new VenteEnFile
        {
            Id = requete.ClientRequestId, NumeroHorsLigne = numero, DateVenteLocale = maintenant,
            Total = TotalPanier, Requete = requete
        };
        await _jsHorsLigne.InvokeVoidAsync("fileAjouter", vente);

        // Stock affiché : on retire ce qui vient d'être vendu (le serveur fera foi à la synchronisation)
        foreach (var l in requete.Lignes)
            if (_articles.FirstOrDefault(a => a.Id == l.ProduitId) is { GereStock: true } art) art.StockActuel -= l.Quantite;
        await EnregistrerContexteLocalAsync();
        await RafraichirFileAsync();

        Notif.Avertir($"Vente enregistrée sur l'appareil (ticket {numero}). Elle sera envoyée automatiquement au retour du réseau.", "Hors connexion");
        return new TicketPosDto
        {
            Id = requete.ClientRequestId, NumeroTicket = numero, DateVente = maintenant,
            TotalTTC = TotalPanier, MontantPaye = paiements.Sum(p => p.Montant), RenduMonnaie = Rendu
        };
    }

    private async Task RafraichirFileAsync()
    {
        if (_jsHorsLigne is null) return;
        try
        {
            _file = await _jsHorsLigne.InvokeAsync<List<VenteEnFile>>("fileLister") ?? new();
            _ventesEnAttente = _file.Count(v => v.Statut != "erreur");
            _ventesEnErreur = _file.Count(v => v.Statut == "erreur");
        }
        catch { }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OuvrirFile()
    {
        await RafraichirFileAsync();
        _afficherFile = true;
    }

    private async Task ReessayerFile()
    {
        if (_jsHorsLigne is not null) await _jsHorsLigne.InvokeVoidAsync("fileRemettreEnAttente");
        await SynchroniserAsync(manuel: true);
    }

    /// <summary>Toutes les 15 secondes : retour du réseau détecté → envoi des ventes en attente, puis rechargement de la caisse.</summary>
    private async Task BoucleSynchronisationAsync()
    {
        using var minuterie = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await minuterie.WaitForNextTickAsync(_arretSynchronisation.Token))
            {
                var enLigne = await EnLigneAsync();
                if (!enLigne)
                {
                    if (!_horsLigne) { _horsLigne = true; await InvokeAsync(StateHasChanged); }
                    continue;
                }
                if (_ventesEnAttente > 0 || _horsLigne) await SynchroniserAsync(manuel: false);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task SynchroniserAsync(bool manuel)
    {
        if (_synchronisation || _jsHorsLigne is null) return;
        _synchronisation = true;
        var envoyees = 0;
        var reseauOk = true;
        try
        {
            var file = await _jsHorsLigne.InvokeAsync<List<VenteEnFile>>("fileLister") ?? new();
            foreach (var v in file.Where(v => v.Statut != "erreur"))
            {
                var reponse = await Api.PostAsync<object>("api/commerce/pos/ventes/hors-ligne",
                    new { Vente = v.Requete, DateVenteLocale = v.DateVenteLocale, NumeroHorsLigne = v.NumeroHorsLigne }, erreur: "");

                if (reponse.Statut is not { } statut) { reseauOk = false; break; }   // toujours pas de réseau

                if (reponse.Succes)
                {
                    await _jsHorsLigne.InvokeVoidAsync("fileRetirer", v.Id);
                    envoyees++;
                }
                else if ((int)statut is 401 or 429 or >= 500)
                {
                    reseauOk = (int)statut != 401;
                    break;   // session expirée, serveur occupé ou en panne : on réessaiera plus tard
                }
                else
                {
                    await _jsHorsLigne.InvokeVoidAsync("fileMarquerErreur", v.Id,
                        string.IsNullOrEmpty(reponse.Message) ? $"Refusée par le serveur (erreur {(int)statut})." : reponse.Message);
                }
            }

            if (reseauOk && _horsLigne)
            {
                // Réseau revenu : on repasse en ligne et on recharge la caisse depuis le serveur
                _horsLigne = false;
                await ResoudreMagasinAsync();
                if (_magasinId.HasValue) await ChargerSessionAsync();
                if (EstErreurReseau()) _horsLigne = true;
            }
        }
        catch { /* réessai au prochain tour */ }
        finally
        {
            _synchronisation = false;
            await RafraichirFileAsync();
            if (envoyees > 0)
                Notif.Succes($"{envoyees} vente(s) faite(s) hors connexion envoyée(s) au serveur.", "Synchronisation");
            else if (manuel && !reseauOk)
                Notif.Avertir("Toujours pas de réseau : nouvel essai automatique dans quelques secondes.", "Synchronisation");
            if (_ventesEnErreur > 0 && envoyees > 0)
                Notif.Erreur($"{_ventesEnErreur} vente(s) refusée(s) par le serveur : ouvrez « à envoyer » pour le détail.", "Synchronisation");
        }
    }

    // ── Reçu : WhatsApp direct au client (texte + lien PDF) ou partage du fichier PDF ──
    private IJSObjectReference? _jsPartage;
    private (Guid VenteId, string Base64)? _recuPdf;
    private (Guid VenteId, string Url)? _lienRecu;
    private bool _envoiRecu;

    private sealed record LienRecu(string Url);

    /// <summary>Juste après la vente : PDF et lien préparés en arrière-plan, pour que le clic ouvre tout instantanément
    /// (sinon le téléphone bloque le partage et l'ordinateur bloque l'ouverture de WhatsApp).</summary>
    private async Task PrechargerRecuPdfAsync(Guid venteId)
    {
        var pdf = await Api.GetOctetsAsync($"api/commerce/pos/ventes/{venteId}/recu");
        if (pdf is { Succes: true, Donnees: { } octets })   // sinon : sera téléchargé au clic
            _recuPdf = (venteId, Convert.ToBase64String(octets));

        var lien = await Api.PostAsync<LienRecu>($"api/commerce/pos/ventes/{venteId}/lien-recu", null);
        if (lien is { Succes: true, Donnees.Url: { } url })   // sinon : message sans lien
            _lienRecu = (venteId, url);
    }

    /// <summary>Détail du ticket, envoyé avec le PDF (légende du fichier dans WhatsApp).</summary>
    private static string MessageRecu(RecuCaisse r, string? lien = null)
    {
        var texte = new System.Text.StringBuilder()
            .AppendLine(string.IsNullOrWhiteSpace(r.Entreprise) ? r.Magasin : r.Entreprise)
            .AppendLine($"Ticket {r.Ticket.NumeroTicket} du {r.Ticket.DateVente.ToLocalTime():dd/MM/yyyy HH:mm}");
        foreach (var l in r.Lignes)
            texte.AppendLine($"- {l.Designation} : {l.Quantite:0.###} x {l.PrixUnitaire:N0} = {l.Total:N0}");
        texte.AppendLine($"TOTAL : {r.Ticket.TotalTTC:N0} FCFA");
        if (!string.IsNullOrEmpty(lien))
            texte.AppendLine().AppendLine($"Téléchargez votre reçu (PDF) : {lien}");
        texte.Append("Merci de votre visite !");
        return texte.ToString();
    }

    /// <summary>
    /// Téléphone / tablette : le menu de partage s'ouvre avec le FICHIER PDF + le détail du ticket en message ;
    /// on choisit WhatsApp puis le client. Ordinateur (pas de partage de fichiers) : conversation WhatsApp du client
    /// avec le détail et le lien du PDF.
    /// </summary>
    private async Task EnvoyerRecu()
    {
        if (_dernierRecu is not { } r || _envoiRecu) return;
        _envoiRecu = true;
        try
        {
            _jsPartage ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/finama-partage.js");

            if (r.EstHorsLigne)
            {
                // Ticket provisoire : pas encore de PDF sur le serveur → détail du ticket par WhatsApp
                var tel = new string((r.ClientTelephone ?? "").Where(char.IsDigit).ToArray());
                if (tel.Length == 8) tel = "228" + tel;
                await _jsPartage.InvokeVoidAsync("ouvrir", $"https://wa.me/{tel}?text={Uri.EscapeDataString(MessageRecu(r))}");
                return;
            }

            if (_recuPdf is not { } pdf || pdf.VenteId != r.Ticket.Id)
            {
                await PrechargerRecuPdfAsync(r.Ticket.Id);
                pdf = _recuPdf ?? default;
            }

            if (pdf.VenteId == r.Ticket.Id && !string.IsNullOrEmpty(pdf.Base64))
            {
                var resultat = await _jsPartage.InvokeAsync<string>("partagerPdf", pdf.Base64, $"Recu_{r.Ticket.NumeroTicket}.pdf", MessageRecu(r));
                if (resultat is "partage" or "annule") return;
            }

            // Ordinateur : conversation du client (ou choix du contact) avec le détail + le lien du PDF
            var numero = new string((r.ClientTelephone ?? "").Where(char.IsDigit).ToArray());
            if (numero.Length == 8) numero = "228" + numero;   // numéro local togolais → indicatif +228
            var lien = _lienRecu is { } l && l.VenteId == r.Ticket.Id ? l.Url : null;
            await _jsPartage.InvokeVoidAsync("ouvrir", $"https://wa.me/{numero}?text={Uri.EscapeDataString(MessageRecu(r, lien))}");
        }
        catch (Exception)
        {
            Notif.Erreur("Le reçu n'a pas pu être envoyé. Réessayez.", "Envoi du reçu");
        }
        finally
        {
            _envoiRecu = false;
        }
    }

