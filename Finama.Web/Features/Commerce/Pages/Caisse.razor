@page "/commerce/caisse"
@using Finama.Web
@implements IAsyncDisposable
@inject ILocalStorage Stockage
@inject ICaisseService CaisseApi
@inject ICatalogueService CatalogueApi
@inject IClientsCommerceService ClientsApi
@inject IMagasinsService MagasinsApi
@inject ErreursCommerce ErreurCommerce
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ApiClient Api
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthState
@inject PermissionsWeb Permissions
@inject NotificationService Notif
@inject ImagesArticlesService Images

<div class="pos-wrapper d-flex flex-column bg-light">
    <!-- EN-TÊTE -->
    <header class="pos-header bg-dark text-white px-3 py-2 d-flex justify-content-between align-items-center shadow-sm">
        <div class="pos-header-info d-flex align-items-center gap-3 min-w-0">
            <span class="fw-bold fs-5 text-success text-nowrap"><i class="bi bi-shop me-2"></i><span class="d-none d-sm-inline">Finama </span>POS</span>
            @if (_session != null)
            {
                <span class="pos-session badge bg-success bg-opacity-25 text-success font-monospace text-truncate">
                    <i class="bi bi-person-fill me-1"></i>@_magasinNom · @_caisseLibelle · ouverte à @_session.DateOuverture.ToLocalTime().ToString("HH:mm")
                </span>
            }
        </div>
        <div class="pos-header-actions d-flex align-items-center gap-2">
            @if (_horsLigne)
            {
                <span class="badge bg-warning text-dark text-nowrap" title="Les ventes sont gardées sur l'appareil et envoyées au retour du réseau">
                    <i class="bi bi-wifi-off me-1"></i>Hors connexion
                </span>
            }
            @if (_ventesEnAttente > 0 || _ventesEnErreur > 0)
            {
                <button class="btn btn-sm @(_ventesEnErreur > 0 ? "btn-danger" : "btn-outline-warning") text-nowrap" @onclick="OuvrirFile" title="Ventes faites sans réseau">
                    <i class="bi bi-cloud-upload"></i><span class="pos-libelle ms-1">@(_ventesEnAttente + _ventesEnErreur) à envoyer</span>
                </button>
            }
            @if (_session != null)
            {
                <span class="badge bg-secondary font-monospace d-none d-xl-inline">[F2] Encaisser | [F4] Réimprimer | [F8] Tickets | [Échap] Vider</span>
                <button class="btn btn-outline-light btn-sm font-monospace text-nowrap" @onclick="OuvrirTickets" title="Tickets de la session : réimprimer ou annuler">
                    <i class="bi bi-list-ul"></i><span class="pos-libelle ms-1">Tickets</span>
                </button>
                <button class="btn btn-outline-warning btn-sm font-monospace text-nowrap" @onclick="OuvrirCloture" title="Clôturer la caisse">
                    <i class="bi bi-lock"></i><span class="pos-libelle ms-1">Clôturer<span class="d-none d-lg-inline"> la caisse</span></span>
                </button>
            }
                        <button class="btn btn-outline-light btn-sm text-nowrap" title="Afficher ou masquer les photos des articles" @onclick="BasculerImages">
                <i class="bi @(_afficherImages ? "bi-image-fill" : "bi-image")"></i>
            </button>
            <button class="btn btn-outline-light btn-sm font-monospace text-nowrap" @onclick='() => Nav.NavigateTo("/modules")' title="Quitter la caisse">
                <i class="bi bi-arrow-left-circle"></i><span class="pos-libelle ms-1">Quitter</span>
            </button>
        </div>
    </header>

    @if (_chargementSession)
    {
        <div class="flex-grow-1 d-flex justify-content-center align-items-center">
            <div class="spinner-border text-success" role="status"></div>
        </div>
    }
    else if (_magasinId == null)
    {
        <div class="flex-grow-1 d-flex justify-content-center align-items-center p-4">
            <div class="alert alert-warning shadow-sm text-center" style="max-width: 520px;">
                <i class="bi bi-shop fs-1 d-block mb-2"></i>
                <div class="fw-bold mb-1">Aucun point de vente actif</div>
                <div class="small mb-3">Créez un magasin de type « Point de Vente » pour pouvoir encaisser.</div>
                <button class="btn btn-success" @onclick='() => Nav.NavigateTo("/commerce/magasins")'>Aller aux magasins</button>
            </div>
        </div>
    }
    else if (_session == null)
    {
        <!-- OUVERTURE DE SESSION -->
        <div class="flex-grow-1 d-flex justify-content-center align-items-center p-4">
            <div class="card border-0 shadow-sm rounded-3" style="width: 440px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-1"><i class="bi bi-unlock text-success me-2"></i>Ouvrir la caisse</h5>
                    <p class="text-muted small mb-3">Point de vente : <strong>@_magasinNom</strong></p>

                    <label class="form-label fw-bold small">Caisse</label>
                    <select class="form-select mb-3" @bind="_caisseChoisieId">
                        @foreach (var c in _caisses)
                        {
                            <option value="@c.Id" disabled="@c.SessionOuverte">@c.Libelle (@c.Code)@(c.SessionOuverte ? " — déjà ouverte" : "")</option>
                        }
                    </select>

                    <label class="form-label fw-bold small">Fond de caisse (FCFA)</label>
                    <input type="number" class="form-control font-monospace mb-4" @bind="_fondDeCaisse" min="0" />

                    <button class="btn btn-success w-100 fw-bold py-2" @onclick="OuvrirSession" disabled="@(_enCoursAction || _caisseChoisieId == Guid.Empty)">
                        @if (_enCoursAction) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Ouvrir la session
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- CORPS DE CAISSE -->
        <div class="pos-body flex-grow-1 d-flex overflow-hidden p-2 gap-2" @onkeydown="GererRaccourcis" tabindex="0">

            <!-- CATALOGUE -->
            <div class="pos-catalogue d-flex flex-column flex-grow-1 bg-white rounded-3 p-3 shadow-sm">
                <div class="mb-3">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light border-end-0 text-success"><i class="bi bi-qr-code-scan fs-4"></i></span>
                        <input id="pos-scanner-input" type="text" class="form-control bg-light border-start-0 fs-5"
                               placeholder="Scanner ou chercher un article…"
                               @bind="_rechercheArticle" @bind:event="oninput" @onkeyup="GererSaisieClavier" />
                        <button class="btn btn-success px-3" type="button" title="Scanner avec la caméra" @onclick="() => _scanner.OuvrirAsync()">
                            <i class="bi bi-camera fs-4"></i>
                        </button>
                    </div>
                </div>

                <div class="flex-grow-1 overflow-auto pe-1">
                    @if (_chargementArticles)
                    {
                        <div class="text-center py-5"><div class="spinner-border text-success" role="status"></div></div>
                    }
                    else if (!_articlesFiltres.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-search fs-1 d-block mb-2 opacity-50"></i>
                            Aucun article trouvé.
                        </div>
                    }
                    else
                    {
                        <div class="row g-2">
                            @foreach (var art in _articlesFiltres)
                            {
                                <div class="col-6 col-md-6 col-xl-4" @key="art.Id">
                                    <button type="button"
                                            class="article-card btn btn-outline-light text-dark w-100 p-3 h-100 d-flex flex-column justify-content-between border rounded-3 shadow-sm text-start"
                                                                                       @onclick="() => AjouterAuPanier(art)">
                                        @if (_afficherImages && AvecPhotos)
                                        {
                                            <div class="article-visuel mb-2">
                                                @if (Images.Url(art.Id) is { } photo)
                                                {
                                                    <img src="@photo" alt="" loading="lazy" />
                                                }
                                                else
                                                {
                                                    <span class="article-initiales">@Initiales(art.Designation)</span>
                                                }
                                            </div>
                                        }
                                        <div class="d-flex justify-content-between align-items-start mb-2 w-100 gap-1">
                                            <span class="fw-bold text-dark article-nom" title="@art.Designation">@art.Designation</span>
                                            @if (art.IsLivre)
                                            {
                                                <span class="badge bg-info bg-opacity-10 text-info flex-shrink-0"><i class="bi bi-book"></i></span>
                                            }
                                        </div>

                                        <!-- Prix toujours sur une seule ligne, devise comprise -->
                                        <div class="article-prix text-success font-monospace w-100 text-end">
                                            @art.PrixVenteTtc.ToString("N0")<small class="ms-1">F@(UniteSuffixe(art))</small>
                                        </div>

                                        <div class="w-100 mt-2">
                                            @if (art.GereStock)
                                            {
                                                var etat = EtatStock(art);
                                                <span class="badge font-monospace @etat.Classe">@etat.Libelle</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary bg-opacity-10 text-primary font-monospace">Service</span>
                                            }
                                        </div>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- TICKET EN COURS -->
            <div id="pos-ticket" class="pos-ticket d-flex flex-column bg-white rounded-3 p-3 shadow-sm">

                <!-- CLIENT -->
                <div class="mb-2 pb-2 border-bottom position-relative">
                    @if (_client == null)
                    {
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" class="form-control" placeholder="Client (nom ou téléphone)"
                                   @bind="_rechercheClient" @bind:event="oninput" @onkeyup="RechercherClients" />
                        </div>
                        @if (_afficherResultatsClient)
                        {
                            <div class="list-group position-absolute w-100 shadow" style="z-index: 20; max-height: 220px; overflow:auto;">
                                @if (!_resultatsClients.Any())
                                {
                                    <div class="list-group-item small text-muted">Aucun client trouvé.</div>
                                }
                                @foreach (var c in _resultatsClients)
                                {
                                    <button type="button" class="list-group-item list-group-item-action small" @onclick="() => ChoisirClient(c)">
                                        <strong>@c.Nom</strong> <span class="text-muted">@c.Telephone</span>
                                        <span class="float-end badge bg-success bg-opacity-10 text-success">@c.PointsFidelite pts</span>
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center bg-success bg-opacity-10 rounded-2 px-2 py-1">
                            <div class="small">
                                <i class="bi bi-person-check text-success me-1"></i><strong>@_client.Nom</strong>
                                <span class="text-muted ms-1">@_client.PointsFidelite pts</span>
                                @if (_client.SoldeCredit > 0)
                                {
                                    <span class="text-danger ms-1">· dû @_client.SoldeCredit.ToString("N0")</span>
                                }
                            </div>
                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="RetirerClient"><i class="bi bi-x-circle"></i></button>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-cart-check text-success me-2"></i>Ticket en cours</h6>
                    <button class="btn btn-outline-danger btn-sm" @onclick="DemanderViderPanier" disabled="@(!_panier.Any())">
                        <i class="bi bi-trash me-1"></i> Vider
                    </button>
                </div>

                <!-- DERNIÈRE VENTE : rendu, réimpression, partage -->
                @if (_dernierRecu != null)
                {
                    <div class="alert alert-success py-2 small mb-2">
                        <div class="d-flex justify-content-between align-items-start">
                            <span>
                                Ticket <strong>@_dernierRecu.Ticket.NumeroTicket</strong> validé
                                @if (_dernierRecu.Ticket.RenduMonnaie > 0)
                                {
                                    <span class="d-block fs-6 mt-1">Rendu : <strong class="font-monospace">@_dernierRecu.Ticket.RenduMonnaie.ToString("N0") FCFA</strong></span>
                                }
                            </span>
                            <button class="btn-close btn-sm" @onclick="() => _dernierRecu = null" aria-label="Masquer"></button>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <button class="btn btn-sm btn-primary fw-bold" @onclick="NouvelleVente">
                                <i class="bi bi-plus-circle me-1"></i>Nouvelle vente
                            </button>
                            <button class="btn btn-sm btn-success" @onclick="ImprimerDernierTicket">
                                <i class="bi bi-printer me-1"></i>Réimprimer [F4]
                            </button>
                            <button class="btn btn-sm btn-outline-success fw-bold" @onclick="EnvoyerRecu" disabled="@_envoiRecu"
                                    title="Envoie le reçu PDF avec le détail du ticket (WhatsApp, e-mail…)">
                                @if (_envoiRecu) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                else { <i class="bi bi-whatsapp me-1"></i> }
                                Envoyer le reçu
                            </button>
                            @if (!_dernierRecu.EstHorsLigne)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DemarrerAnnulation(_dernierRecu.Ticket.Id, _dernierRecu.Ticket.NumeroTicket, _dernierRecu.Ticket.TotalTTC)">
                                    <i class="bi bi-x-circle me-1"></i>Annuler ce ticket
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="flex-grow-1 overflow-auto border-bottom mb-2">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="bg-light small text-uppercase">
                            <tr><th>Article</th><th class="text-center" style="width: 120px;">Qté</th><th class="text-end">Total</th><th></th></tr>
                        </thead>
                        <tbody>
                            @if (!_panier.Any())
                            {
                                <tr><td colspan="4" class="text-center py-5 text-muted"><i class="bi bi-cart-x fs-1 d-block mb-2 opacity-50"></i>Panier vide. Scannez un article.</td></tr>
                            }
                            else
                            {
                                @foreach (var ligne in _panier)
                                {
                                    <tr @key="ligne.ProduitId">
                                        <td>
                                            <div class="fw-bold small text-truncate" style="max-width: 150px;">@ligne.Designation</div>
                                            <span class="text-muted small font-monospace text-nowrap">@ligne.PrixUnitaire.ToString("N0") F@(ligne.Unite)</span>
                                        </td>
                                        <td class="text-center">
                                            @if (ligne.Vrac)
                                            {
                                                <input type="number" step="0.001" min="0" class="form-control form-control-sm text-center font-monospace"
                                                       value="@ligne.Quantite" @onchange="e => SaisirQuantite(ligne, e.Value)" />
                                            }
                                            else
                                            {
                                                <div class="btn-group btn-group-sm">
                                                    <button class="btn btn-outline-secondary" @onclick="() => ModifierQuantite(ligne, -1)">-</button>
                                                    <span class="btn btn-light fw-bold font-monospace px-2">@ligne.Quantite.ToString("0.###")</span>
                                                    <button class="btn btn-outline-secondary" @onclick="() => ModifierQuantite(ligne, 1)">+</button>
                                                </div>
                                            }
                                        </td>
                                        <td class="text-end font-monospace fw-bold text-nowrap">@ligne.Total.ToString("N0")</td>
                                        <td class="text-end"><button class="btn btn-link text-danger p-0" @onclick="() => SupprimerLigne(ligne)"><i class="bi bi-x-circle"></i></button></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="bg-light p-3 rounded-3 mb-2 d-none d-md-block">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <span class="fw-bold fs-5 text-nowrap">NET À PAYER :</span>
                        <span class="fw-bold text-success fs-3 font-monospace text-nowrap">@TotalPanier.ToString("N0") FCFA</span>
                    </div>
                </div>

                <div class="form-check form-switch small mb-2">
                    <input class="form-check-input" type="checkbox" id="impression-auto" checked="@_impressionAuto" @onchange="BasculerImpressionAuto" />
                    <label class="form-check-label" for="impression-auto">Imprimer le ticket automatiquement</label>
                </div>

                <button class="btn btn-success btn-lg w-100 py-3 fw-bold text-uppercase shadow-sm d-none d-md-block" disabled="@(!_panier.Any())" @onclick="OuvrirPaiement">
                    <i class="bi bi-cash-coin me-2"></i>Encaisser [F2]
                </button>
            </div>
        </div>

        <!-- TÉLÉPHONE : barre fixe en bas (articles, total, encaisser) -->
        <div class="pos-barre-mobile d-md-none">
            <a href="#pos-ticket" class="pos-barre-panier text-decoration-none">
                <span class="position-relative">
                    <i class="bi bi-cart3 fs-4"></i>
                    @if (_panier.Any())
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@_panier.Sum(l => l.Quantite).ToString("0.##")</span>
                    }
                </span>
                <span class="ms-3 lh-sm">
                    <span class="d-block small opacity-75">Net à payer</span>
                    <strong class="font-monospace fs-5">@TotalPanier.ToString("N0") F</strong>
                </span>
            </a>
            <button class="btn btn-success fw-bold px-4" disabled="@(!_panier.Any())" @onclick="OuvrirPaiement">
                <i class="bi bi-cash-coin me-1"></i>Encaisser
            </button>
        </div>
    }
</div>

<!-- MODALE PAIEMENT -->
@if (_afficherPaiement)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-cash-coin me-2"></i>Paiement — @TotalPanier.ToString("N0") FCFA</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FermerPaiement"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button class="btn btn-outline-success" @onclick="() => AjouterPaiement(ModePaiementPos.Especes)"><i class="bi bi-cash me-1"></i>Espèces</button>
                        <button class="btn btn-outline-primary" @onclick="() => AjouterPaiement(ModePaiementPos.Carte)"><i class="bi bi-credit-card me-1"></i>Carte</button>
                        <button class="btn btn-outline-warning" @onclick="() => AjouterPaiement(ModePaiementPos.MobileMoney)"><i class="bi bi-phone me-1"></i>Mobile Money</button>
                        <button class="btn btn-outline-secondary" disabled="@(_client == null || _horsLigne)" title="@(_horsLigne ? "Indisponible hors connexion" : null)" @onclick="() => AjouterPaiement(ModePaiementPos.Credit)"><i class="bi bi-journal-text me-1"></i>Crédit client</button>
                        <button class="btn btn-outline-secondary" disabled="@(_client == null || _horsLigne)" title="@(_horsLigne ? "Indisponible hors connexion" : null)" @onclick="() => AjouterPaiement(ModePaiementPos.Points)"><i class="bi bi-star me-1"></i>Points</button>
                    </div>

                    @foreach (var p in _paiements)
                    {
                        <div class="input-group mb-2" @key="p">
                            <span class="input-group-text" style="min-width: 130px;">@LibelleMode(p.Mode)</span>
                            <input type="number" class="form-control font-monospace text-end" min="0" @bind="p.Montant" @bind:event="oninput" />
                            @if (p.Mode == ModePaiementPos.MobileMoney || p.Mode == ModePaiementPos.Carte)
                            {
                                <input type="text" class="form-control" placeholder="Référence" @bind="p.Reference" />
                            }
                            <button class="btn btn-outline-danger" @onclick="() => _paiements.Remove(p)"><i class="bi bi-x"></i></button>
                        </div>
                    }

                    <div class="bg-light rounded-3 p-3 mt-3 font-monospace">
                        <div class="d-flex justify-content-between"><span>Total reçu</span><strong>@TotalPaye.ToString("N0")</strong></div>
                        @if (Reste > 0)
                        {
                            <div class="d-flex justify-content-between text-danger"><span>Reste à payer</span><strong>@Reste.ToString("N0")</strong></div>
                        }
                        @if (Rendu > 0)
                        {
                            <div class="d-flex justify-content-between @(RenduPossible ? "text-success" : "text-danger")"><span>Rendu monnaie</span><strong>@Rendu.ToString("N0")</strong></div>
                        }
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button class="btn btn-light" @onclick="FermerPaiement">Retour</button>
                    <button class="btn btn-success fw-bold px-4" @onclick="ValiderVente" disabled="@(!PaiementValide || _enCoursEncaissement)">
                        @if (_enCoursEncaissement) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Valider la vente
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODALE CLÔTURE À L'AVEUGLE -->
@if (_afficherCloture)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-lock me-2"></i>Clôture de caisse</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _afficherCloture = false"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small">Comptez votre caisse et saisissez les montants réels. Le système calcule l'écart après la clôture.</p>
                    <label class="form-label fw-bold small">Espèces comptées (FCFA)</label>
                    <input type="number" class="form-control font-monospace mb-3" min="0" @bind="_declEspeces" />
                    <label class="form-label fw-bold small">Total des paiements par carte (FCFA)</label>
                    <input type="number" class="form-control font-monospace mb-3" min="0" @bind="_declCarte" />
                    <label class="form-label fw-bold small">Total Mobile Money (FCFA)</label>
                    <input type="number" class="form-control font-monospace mb-3" min="0" @bind="_declMobile" />
                    <label class="form-label fw-bold small">Commentaire</label>
                    <input type="text" class="form-control" @bind="_commentaireCloture" />
                </div>
                <div class="modal-footer bg-light">
                    <button class="btn btn-light" @onclick="() => _afficherCloture = false">Annuler</button>
                    <button class="btn btn-dark fw-bold px-4" @onclick="CloturerSession" disabled="@_enCoursAction">
                        @if (_enCoursAction) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Clôturer définitivement
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- TICKET IMPRIMABLE (80 mm) : invisible à l'écran, seul élément imprimé -->
@if (_recuAImprimer is { } r)
{
    <TicketImprimable Recu="r" QrSvg="@_qrTicket" />
}

<style>
    .article-card { background-color: #f8f9fa; border-color: #e9ecef !important; transition: all 0.15s ease-in-out; }
    .article-card:hover { border-color: #198754 !important; background-color: #f1f8f5; transform: translateY(-2px); }
    .article-prix { font-size: 1.15rem; font-weight: 700; white-space: nowrap; }
    .article-prix small { font-size: .75rem; font-weight: 600;        }

    .article-visuel {
        width: 100%;
        height: 110px;
        border-radius: .5rem;
        background: #fff;
        border: 1px solid #eef1f4;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .article-visuel img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .article-initiales {
        font-size: 1.6rem;
        font-weight: 700;
        color: #94a3b8;
        letter-spacing: .05em;
    }
    .min-w-0 { min-width: 0; }

    /* Ordinateur / tablette : catalogue à gauche (60 %), ticket à droite (40 %), sur toute la hauteur */
    .pos-wrapper { height: 100vh; overflow: hidden; }
    .pos-catalogue { width: 60%; }
    .pos-ticket { width: 40%; }

    /* Téléphone : tout empilé — recherche et articles, puis ticket ; barre « Encaisser » fixée en bas */
    @@media (max-width: 767.98px) {
        .pos-wrapper { height: auto; min-height: 100vh; overflow: visible; }
        .pos-body { flex-direction: column; overflow: visible !important; padding-bottom: 88px !important; }
        .pos-catalogue, .pos-ticket { width: 100%; }
        .pos-catalogue { min-height: 0; }
        .pos-catalogue .row.g-2 { min-height: 40vh; align-content: flex-start; }
                                               .article-visuel { height: 84px; }
        .pos-header { flex-wrap: wrap; gap: 8px; padding: 8px 12px !important; }
        .pos-header-info { flex: 1 1 100%; justify-content: space-between; }
        .pos-header-actions { flex: 1 1 100%; }
        .pos-header-actions .btn { flex: 1 1 0; padding: .5rem; font-size: .95rem; }
        .pos-session { max-width: 70vw !important; font-size: .75rem; }
        .pos-catalogue .input-group-lg .form-control { font-size: 1rem !important; }
        .pos-ticket { scroll-margin-top: 70px; }
        .article-prix { font-size: 1rem; }

        .pos-barre-mobile { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1040;
            display: flex; align-items: center; justify-content: space-between; gap: 12px;
            padding: 10px 14px calc(10px + env(safe-area-inset-bottom)); background: #0f172a; color: #fff;
            box-shadow: 0 -6px 20px rgba(0,0,0,.25); }
        .pos-barre-panier { display: flex; align-items: center; color: #fff; }
        .pos-barre-mobile .btn { padding-top: .7rem; padding-bottom: .7rem; }
    }
    .article-nom { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.25; }

    /* Badges de stock : rouge = rupture, orange = sous le seuil, gris = normal */
    .stock-ok { background: #e9ecef; color: #495057; }
    .stock-bas { background: #fff3cd; color: #997404; border: 1px solid #ffe69c; }
    .stock-rupture { background: #f8d7da; color: #b02a37; border: 1px solid #f1aeb5; }

    /* Ticket : caché à l'écran */
    .ticket-impression { display: none; }

    @@media print {
        @@page { size: 80mm auto; margin: 3mm; }

        /* On retire du flux tout ce qui n'est pas le ticket (évite les pages blanches) */
        .sidebar, .topbar, .pos-wrapper, .modal, .rz-notification { display: none !important; }
        .main-content, .page-wrapper { margin: 0 !important; padding: 0 !important; width: auto !important; }

        body * { visibility: hidden !important; }

        .ticket-impression,
        .ticket-impression * { visibility: visible !important; }

        .ticket-impression {
            display: block !important;
            position: static;
            width: 72mm;
            font-family: "Courier New", monospace;
            font-size: 11px;
            line-height: 1.35;
            color: #000;
            background: #fff;
        }

        .t-centre { text-align: center; }
        .t-logo { display: block; max-width: 40mm; max-height: 22mm; margin: 0 auto 4px; object-fit: contain; filter: grayscale(100%); }
        .t-titre { font-size: 15px; font-weight: 700; text-transform: uppercase; }
        .t-gras { font-weight: 700; }
        .t-petit { font-size: 9px; margin-top: 4px; }
        .t-sep { border-top: 1px dashed #000; margin: 5px 0; }
        .t-ligne { display: flex; justify-content: space-between; gap: 6px; }
        .t-ligne span:last-child { white-space: nowrap; }
        .t-article { font-weight: 700; overflow-wrap: anywhere; }
        .t-total { font-size: 13px; font-weight: 700; margin-top: 3px; }
        .t-qr { width: 22mm; height: 22mm; margin: 4px auto; }
        .t-qr svg { width: 100%; height: 100%; }
    }
</style>

<!-- VENTES FAITES HORS CONNEXION -->
@if (_afficherFile)
{
    <VentesHorsLigneModal Ventes="_file" NbErreurs="_ventesEnErreur" Synchronisation="_synchronisation"
                          OnFermer="() => _afficherFile = false" OnReessayer="ReessayerFile" />
}

<!-- TICKETS DE LA SESSION -->
@if (_afficherTickets)
{
    <TicketsSessionModal Tickets="_tickets" OnFermer="() => _afficherTickets = false"
                         OnAnnuler="t => DemarrerAnnulation(t.Id, t.NumeroTicket, t.TotalTTC)" />
}

<!-- ANNULATION D'UN TICKET -->
@if (_annulation is { } an)
{
    <AnnulationTicketModal Demande="an" EstGerant="_estGerant" EnCours="_enCoursAnnulation"
                           OnRetour="() => _annulation = null" OnConfirmer="ConfirmerAnnulation" />
}

<ConfirmDialog @ref="_confirm" />
<ScannerCamera @ref="_scanner" OnCode="SurCodeCamera" Continu="true" Titre="Scanner les articles" />

