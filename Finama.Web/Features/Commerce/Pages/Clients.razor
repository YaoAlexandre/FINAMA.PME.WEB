@page "/commerce/clients"
@using Finama.Web
@inject IClientsCommerceService ClientsApi
@inject ErreursCommerce ErreurCommerce
@inject NotificationService Notif

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-people text-success me-2"></i>Clients & Fidélité</h3>
        <p class="text-muted small mb-0">Fichier clients, crédit autorisé et points de fidélité</p>
    </div>
    <div class="d-flex gap-2">
        <BoutonExportExcel Url="api/exports/clients" NomFichier="Clients.xlsx" Classe="btn-outline-success fw-bold px-3 py-2 rounded-3 shadow-sm" />
        <button class="btn btn-success fw-bold px-3 py-2 rounded-3 shadow-sm" @onclick="OuvrirNouveau">
            <i class="bi bi-person-plus me-1"></i> Nouveau client
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" class="form-control bg-light border-start-0" placeholder="Nom, code ou téléphone..." maxlength="100"
                   @bind="_recherche" @bind:event="oninput" @onkeyup="RechercherSiEntree" />
            <button class="btn btn-outline-success" @onclick="Charger">Rechercher</button>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="@(_detail != null ? "col-lg-7" : "col-12")">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light small text-uppercase">
                        <tr>
                            <th class="ps-4">Client</th>
                            <th>Téléphone</th>
                            <th class="text-end">Points</th>
                            <th class="text-end">Crédit dû / plafond</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_chargement)
                        {
                            <tr><td colspan="5" class="text-center py-5"><div class="spinner-border text-success"></div></td></tr>
                        }
                        else if (!_clients.Any())
                        {
                            <tr><td colspan="5" class="text-center py-5 text-muted"><i class="bi bi-people fs-1 d-block mb-2 opacity-50"></i>Aucun client.</td></tr>
                        }
                        else
                        {
                            @foreach (var c in _clients)
                            {
                                <tr @key="c.Id" class="@(c.EstActif ? "" : "text-muted")">
                                    <td class="ps-4">
                                        <div class="fw-bold">@c.Nom @if (!c.EstActif) { <span class="badge bg-secondary ms-1">Inactif</span> }</div>
                                        <span class="small text-muted font-monospace">@c.Code · @(c.Type == TypeClientCommerce.Entreprise ? "Entreprise" : "Particulier")</span>
                                    </td>
                                    <td class="font-monospace small">@(c.Telephone ?? "—")</td>
                                    <td class="text-end"><span class="badge bg-success bg-opacity-10 text-success font-monospace">@c.PointsFidelite</span></td>
                                    <td class="text-end font-monospace small">
                                        <span class="@(c.SoldeCredit > 0 ? "text-danger fw-bold" : "")">@c.SoldeCredit.ToString("N0")</span> / @c.PlafondCredit.ToString("N0")
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-secondary me-1" title="Fiche" @onclick="() => VoirDetail(c)"><i class="bi bi-eye"></i></button>
                                        <button class="btn btn-sm btn-outline-success me-1" title="Modifier" @onclick="() => Editer(c)"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-@(c.EstActif ? "danger" : "primary")" title="@(c.EstActif ? "Désactiver" : "Réactiver")" @onclick="() => BasculerActif(c)">
                                            <i class="bi @(c.EstActif ? "bi-person-x" : "bi-person-check")"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @if (_clients.Count >= 50)
            {
                <div class="small text-muted px-3 py-2 border-top">Les 50 premiers résultats sont affichés : précisez votre recherche (nom, téléphone ou code) pour trouver un client.</div>
            }
        </div>
    </div>

    @if (_detail != null)
    {
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">@_detail.Client.Nom</h5>
                    <button class="btn-close" @onclick="() => _detail = null"></button>
                </div>
                <div class="card-body">
                    <div class="row text-center g-2 mb-3">
                        <div class="col-4"><div class="small text-muted">Points</div><div class="fs-4 fw-bold text-success">@_detail.Client.PointsFidelite</div></div>
                        <div class="col-4"><div class="small text-muted">Achats cumulés</div><div class="fs-6 fw-bold font-monospace">@_detail.TotalAchats.ToString("N0")</div></div>
                        <div class="col-4"><div class="small text-muted">Crédit dû</div><div class="fs-6 fw-bold font-monospace @(_detail.Client.SoldeCredit > 0 ? "text-danger" : "")">@_detail.Client.SoldeCredit.ToString("N0")</div></div>
                    </div>

                    <h6 class="fw-bold small text-uppercase text-muted">Derniers achats</h6>
                    @if (!_detail.DerniersAchats.Any())
                    {
                        <div class="text-muted small mb-3">Aucun achat.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var a in _detail.DerniersAchats)
                            {
                                <li class="list-group-item d-flex justify-content-between px-0 small">
                                    <span class="font-monospace">@a.NumeroTicket <span class="text-muted">@a.DateVente.ToLocalTime().ToString("dd/MM/yy")</span></span>
                                    <strong>@a.TotalTTC.ToString("N0")</strong>
                                </li>
                            }
                        </ul>
                    }

                    <h6 class="fw-bold small text-uppercase text-muted">Mouvements de points</h6>
                    @if (!_detail.Fidelite.Any())
                    {
                        <div class="text-muted small">Aucun mouvement.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var m in _detail.Fidelite)
                            {
                                <li class="list-group-item d-flex justify-content-between px-0 small">
                                    <span>@m.DateMouvement.ToLocalTime().ToString("dd/MM/yy") <span class="text-muted">@m.Motif</span></span>
                                    <strong class="@(m.Points >= 0 ? "text-success" : "text-danger")">@(m.Points >= 0 ? "+" : "")@m.Points</strong>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (_afficherModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.5); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold">@(_idEdition == null ? "Nouveau client" : "Modifier le client")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => _afficherModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small">Nom *</label>
                            <input type="text" class="form-control @(_tente && ErreurNom is not null ? "is-invalid" : "")" maxlength="150" @bind="_form.Nom" @bind:event="oninput" />
                            @if (_tente && ErreurNom is not null) { <div class="invalid-feedback d-block small">@ErreurNom</div> }
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small">Type</label>
                            <select class="form-select" @bind="_form.Type">
                                <option value="@TypeClientCommerce.Particulier">Particulier</option>
                                <option value="@TypeClientCommerce.Entreprise">Entreprise</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Téléphone</label>
                            <ChampTelephone @bind-Value="_form.Telephone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">E-mail</label>
                            <ChampEmail @bind-Value="_form.Email" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small">Adresse</label>
                            <input type="text" class="form-control" maxlength="250" @bind="_form.Adresse" />
                        </div>
                        @if (_form.Type == TypeClientCommerce.Entreprise)
                        {
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">NIF</label>
                                <input type="text" class="form-control font-monospace text-uppercase" maxlength="30" @bind="_form.Nif"
                                       onkeydown="return event.key.length > 1 || event.ctrlKey || event.metaKey || /[A-Za-z0-9\-\/ ]/.test(event.key)" />
                            </div>
                        }
                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Plafond de crédit</label>
                            <ChampMontant @bind-Value="_form.PlafondCredit" />
                            <div class="form-text">0 = vente à crédit interdite</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button class="btn btn-light" @onclick="() => _afficherModal = false">Annuler</button>
                    <button class="btn btn-success fw-bold px-4" @onclick="Enregistrer" disabled="@_enCours">
                        @if (_enCours) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Enregistrer
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDialog @ref="_confirm" />

@code {
    private ConfirmDialog _confirm = default!;
    private List<ClientCommerceDto> _clients = new();
    private ClientDetailCommerceDto? _detail;
    private string _recherche = "";
    private bool _chargement = true;
    private bool _afficherModal;
    private bool _enCours;
    private bool _tente;
    private Guid? _idEdition;
    private SaveClientCommerceRequest _form = new();

    private string? ErreurNom => ControlesSaisie.Nom(_form.Nom);

    protected override async Task OnInitializedAsync() => await Charger();

    private async Task Charger()
    {
        _chargement = true;
        _clients = await ClientsApi.RechercherClientsAsync(_recherche);
        if (ErreurCommerce.Derniere != null) Notif.Erreur(ErreurCommerce.Derniere, "Chargement");
        _chargement = false;
    }

    private async Task RechercherSiEntree(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Charger();
    }

    private async Task VoirDetail(ClientCommerceDto c)
    {
        _detail = await ClientsApi.GetClientAsync(c.Id);
        if (_detail == null) Notif.Erreur(ErreurCommerce.Derniere ?? "Introuvable.", "Fiche client");
    }

    private void OuvrirNouveau()
    {
        _idEdition = null;
        _form = new SaveClientCommerceRequest();
        _tente = false;
        _afficherModal = true;
    }

    private void Editer(ClientCommerceDto c)
    {
        _idEdition = c.Id;
        _form = new SaveClientCommerceRequest
        {
            Nom = c.Nom, Type = c.Type, Telephone = c.Telephone, Email = c.Email,
            Adresse = c.Adresse, Nif = c.Nif, PlafondCredit = c.PlafondCredit
        };
        _tente = false;
        _afficherModal = true;
    }

    private async Task Enregistrer()
    {
        _tente = true;

        // Contrôles de saisie : mêmes règles que le serveur, message immédiat
        var erreur = ErreurNom is { } n ? $"Nom : {n}"
                   : ControlesSaisie.Telephone(_form.Telephone) is { } t ? $"Téléphone : {t}"
                   : ControlesSaisie.Email(_form.Email) is { } m ? $"E-mail : {m}"
                   : _form.PlafondCredit < 0 ? "Le plafond de crédit ne peut pas être négatif."
                   : null;
        if (erreur is not null)
        {
            Notif.Avertir(erreur, "Vérifiez la saisie");
            return;
        }

        _enCours = true;
        try
        {
            var resultat = _idEdition == null
                ? await ClientsApi.CreerClientAsync(_form)
                : await ClientsApi.ModifierClientAsync(_idEdition.Value, _form);

            if (resultat == null)
            {
                Notif.Erreur(ErreurCommerce.Derniere ?? "Erreur inconnue.", "Enregistrement impossible");
                return;
            }

            Notif.Succes(_idEdition == null ? "Client créé." : "Client mis à jour.");
            _afficherModal = false;
            await Charger();
        }
        finally { _enCours = false; }
    }

    private async Task BasculerActif(ClientCommerceDto c)
    {
        if (c.EstActif && !await _confirm.DemanderAsync(
                $"« {c.Nom} » ne sera plus proposé en caisse.\nSon historique, ses points de fidélité et son crédit sont conservés.",
                "Désactiver ce client ?", "Désactiver", type: ConfirmationType.Danger))
            return;

        if (!await ClientsApi.DefinirClientActifAsync(c.Id, !c.EstActif))
        {
            Notif.Erreur(ErreurCommerce.Derniere ?? "Opération impossible.");
            return;
        }
        await Charger();
    }
}
