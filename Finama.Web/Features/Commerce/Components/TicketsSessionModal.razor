@* Tickets de la session de caisse en cours, avec accès à l'annulation. *@

<div class="modal fade show d-block" tabindex="-1" style="background: rgba(15,23,42,.6); z-index: 2000;">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-list-ul me-2"></i>Tickets de la session</h5>
                <button class="btn-close" @onclick="OnFermer"></button>
            </div>
            <div class="modal-body p-0">
                @if (Tickets is null)
                {
                    <div class="text-center py-5"><div class="spinner-border"></div></div>
                }
                else if (!Tickets.Any())
                {
                    <div class="text-center py-5 text-muted">Aucun ticket dans cette session.</div>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead class="small text-uppercase text-muted"><tr><th class="ps-3">Ticket</th><th>Heure</th><th>Client</th><th class="text-end">Total</th><th class="text-end pe-3"></th></tr></thead>
                        <tbody>
                            @foreach (var t in Tickets)
                            {
                                <tr class="@(t.EstAnnule ? "text-muted" : "")">
                                    <td class="ps-3 font-monospace fw-bold @(t.EstAnnule ? "text-decoration-line-through" : "")">@t.NumeroTicket</td>
                                    <td>@t.DateVente.ToLocalTime().ToString("HH:mm")</td>
                                    <td class="small">@(t.ClientNom ?? "—")</td>
                                    <td class="text-end font-monospace">@t.TotalTTC.ToString("N0")</td>
                                    <td class="text-end pe-3">
                                        @if (t.EstAnnule)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger" title="@t.MotifAnnulation">Annulé</span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => OnAnnuler.InvokeAsync(t)">Annuler</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>Null pendant le chargement.</summary>
    [Parameter] public IReadOnlyCollection<TicketSession>? Tickets { get; set; }
    [Parameter] public EventCallback OnFermer { get; set; }
    [Parameter] public EventCallback<TicketSession> OnAnnuler { get; set; }
}
