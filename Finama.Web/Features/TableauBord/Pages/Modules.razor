@page "/modules"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Finama.Web
@inject ILocalStorage Stockage
@inject IAuthService AuthApi
@inject IParametresCommerceService ParametresApi
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inject IAuthorizationService Auth
@inject ModulesService ModulesAbonnement

@* Accueil des modules : accueille l'utilisateur, lui montre ce qui demande son attention et lui permet d'aller n'importe où en tapant quelques lettres.
   Seuls les modules et pages auxquels il a droit apparaissent : rôle de l'utilisateur ET modules de l'abonnement. *@

<div class="mb-4">
    <h2 class="fw-bold mb-1">@Salutation()@(string.IsNullOrWhiteSpace(_nom) ? "" : $", {_nom}")</h2>
    <div class="text-muted">@(string.IsNullOrWhiteSpace(_entreprise) ? "" : _entreprise + " · ")@DateDuJour()</div>
</div>

<!-- RECHERCHE RAPIDE -->
<div class="position-relative mb-4" style="max-width: 680px;">
    <div class="input-group input-group-lg shadow-sm">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input type="text" class="form-control border-start-0" autocomplete="off"
               placeholder="Que voulez-vous faire ? (caisse, facture…)"
               @bind="_recherche" @bind:event="oninput" @onkeydown="SurTouche" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_recherche))
    {
        var resultats = Resultats().ToList();
        <div class="list-group position-absolute w-100 shadow-lg mt-1 rounded-3 overflow-hidden" style="z-index: 30;">
            @if (!resultats.Any())
            {
                <div class="list-group-item text-muted small">Aucun résultat pour « @_recherche ».</div>
            }
            @foreach (var d in resultats)
            {
                <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-2" @onclick="() => Aller(d.Url)">
                    <i class="bi @d.Icone fs-5 text-muted"></i>
                    <span class="flex-grow-1">@d.Libelle</span>
                    <span class="badge bg-light text-secondary border fw-normal">@NomModule(d.Module)</span>
                </button>
            }
        </div>
    }
</div>

<!-- REPRISE -->
@if (_reprise != null && string.IsNullOrWhiteSpace(_recherche))
{
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-success bg-opacity-10">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
            <div>
                <div class="small text-muted">Reprendre où vous en étiez</div>
                <div class="fw-bold"><i class="bi @_reprise.Icone me-2 text-success"></i>@_reprise.Libelle <span class="text-muted fw-normal">· @NomModule(_reprise.Module)</span></div>
            </div>
            <button class="btn btn-success fw-bold" @onclick="() => Aller(_reprise.Url)">Reprendre <i class="bi bi-arrow-right ms-1"></i></button>
        </div>
    </div>
}

<div class="row g-4">
    <!-- MODULES -->
    <div class="col-xl-8">
        <div class="row g-3">
            @if (_chargement)
            {
                @for (var i = 0; i < 2; i++)
                {
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm rounded-4" aria-hidden="true">
                            <div class="card-body p-4 placeholder-glow">
                                <span class="placeholder col-6 mb-3 d-block" style="height: 28px;"></span>
                                <span class="placeholder col-10 mb-2 d-block"></span>
                                <span class="placeholder col-8 mb-4 d-block"></span>
                                <span class="placeholder col-4 btn btn-sm disabled"></span>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                @foreach (var c in _cartes)
                {
                    <div class="col-md-6" @key="c.Code">
                        <div class="card border-0 shadow-sm rounded-4 h-100 carte-module">
                            <div class="card-body p-4 d-flex flex-column">
                                <div class="d-flex align-items-start gap-3 mb-3">
                                    <span class="carte-icone @c.Fond"><i class="bi @c.Icone fs-3"></i></span>
                                    <div>
                                        <h5 class="fw-bold mb-0">@c.Titre</h5>
                                        <div class="text-muted small">@c.Description</div>
                                    </div>
                                </div>

                                @if (c.Chips.Any())
                                {
                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        @foreach (var chip in c.Chips)
                                        {
                                            <span class="badge rounded-pill fw-normal px-3 py-2 @chip.Classe">@chip.Texte</span>
                                        }
                                    </div>
                                }

                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    @foreach (var a in c.Actions)
                                    {
                                        <button class="btn btn-sm @(a.Principal ? c.Bouton : "btn-outline-secondary")" @onclick="() => Aller(a.Url)">
                                            <i class="bi @a.Icone me-1"></i>@a.Label
                                        </button>
                                    }
                                </div>

                                <div class="mt-auto">
                                    <button class="btn btn-link p-0 fw-bold text-decoration-none" @onclick="() => OuvrirModuleAsync(c.Code)">
                                        Ouvrir le module <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- POINTS D'ATTENTION -->
    <div class="col-xl-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 pt-3 pb-0">
                <h6 class="fw-bold mb-0"><i class="bi bi-bell me-2"></i>À traiter</h6>
            </div>
            <div class="card-body">
                @if (_chargement)
                {
                    <div class="placeholder-glow" aria-hidden="true">
                        <span class="placeholder col-12 mb-2 d-block"></span>
                        <span class="placeholder col-9 mb-3 d-block"></span>
                        <span class="placeholder col-12 mb-2 d-block"></span>
                        <span class="placeholder col-7 d-block"></span>
                    </div>
                }
                else if (!_alertes.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-check2-circle fs-1 text-success d-block mb-2"></i>
                        Tout est en ordre.
                    </div>
                }
                else
                {
                    @foreach (var a in _alertes)
                    {
                        <div class="d-flex gap-3 py-3 border-bottom alerte-ligne">
                            <i class="bi @a.Icone fs-4 @ClasseNiveau(a.Niveau)"></i>
                            <div class="flex-grow-1">
                                <div class="fw-bold small">@a.Titre</div>
                                <div class="text-muted small">@a.Detail</div>
                                @if (!string.IsNullOrEmpty(a.CtaUrl))
                                {
                                    <button class="btn btn-sm btn-link p-0 mt-1 fw-bold text-decoration-none" @onclick="() => Aller(a.CtaUrl)">@a.CtaLibelle <i class="bi bi-arrow-right"></i></button>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Téléphone : moins de marges, cartes plus compactes, tout tient dans la largeur */
    @@media (max-width: 576px) {
        .carte-module .card-body { padding: 1rem !important; }
        .carte-module h5 { font-size: 1.1rem; }
        h2.fw-bold { font-size: 1.5rem; }
        .carte-icone { width: 44px !important; height: 44px !important; }
        .carte-icone i { font-size: 1.25rem !important; }
        .carte-module .btn { padding: .35rem .7rem; font-size: .9rem; }
    }
    .carte-icone {
        width: 52px;
        height: 52px;
        flex: 0 0 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
    }

    .carte-module {
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .carte-module:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1.25rem rgba(0, 0, 0, .12) !important;
        }

    .alerte-ligne:last-child {
        border-bottom: 0 !important;
    }
</style>

@code {
    private record Destination(string Module, string Libelle, string Url, string Icone, string Mots);
    private record ActionRapide(string Label, string Url, string Icone, bool Principal = false);
    private record Puce(string Texte, string Classe);
    private record Carte(string Code, string Titre, string Description, string Icone, string Fond, string Bouton, List<ActionRapide> Actions, List<Puce> Chips);
    private record Alerte(string Niveau, string Icone, string Titre, string Detail, string? CtaLibelle, string? CtaUrl);

    private string _nom = "";
    private string _entreprise = "";
    private string _devise = "FCFA";
    private string _recherche = "";
    private bool _chargement = true;

    private bool _peutSaisie;
    private bool _peutCommerce;
    private bool _peutCompta;     // module Finance & Compta ouvert à l'entreprise
    private bool _peutDevis;      // module Gestion commerciale ouvert + rôle Commercial
    private bool _peutAdmin;
    private bool _estSuperAdmin;

    private TableauBordCommerceDto? _tb;
    private bool _tbIndisponible;

    private List<Destination> _destinations = new();
    private List<Carte> _cartes = new();
    private List<Alerte> _alertes = new();
    private Destination? _reprise;

    protected override async Task OnInitializedAsync()
    {
        _nom = await AuthApi.GetUserNomAsync() ?? "";
        _entreprise = await AuthApi.GetEntrepriseNomAsync() ?? "";
        _devise = await AuthApi.GetDeviseSymboleAsync() ?? "FCFA";

        var etat = await AuthState.GetAuthenticationStateAsync();
        var utilisateur = etat.User;
        _peutSaisie = (await Auth.AuthorizeAsync(utilisateur, "Saisie")).Succeeded;
        _peutCommerce = (await Auth.AuthorizeAsync(utilisateur, "Commercial")).Succeeded;
        _peutAdmin = (await Auth.AuthorizeAsync(utilisateur, "AdminTenant")).Succeeded;
        _estSuperAdmin = utilisateur.IsInRole("SuperAdmin");

        // Modules de l'abonnement : on combine avec les droits du rôle
        var modules = await ModulesAbonnement.ChargerAsync();
        var roleCommercial = _peutCommerce;
        _peutCompta = modules.Comptabilite;
        _peutSaisie &= modules.Comptabilite;
        _peutCommerce = roleCommercial && modules.Commerce;
        _peutDevis = roleCommercial && modules.GestionCommerciale;

        // Compte plateforme (SuperAdmin hors mode support) : seule l'administration de la plateforme le concerne.
        // En mode support, le SuperAdmin voit les modules du client, comme le client.
        if (modules.SansEntreprise)
        {
            _peutCompta = _peutSaisie = _peutCommerce = _peutDevis = false;
        }

        // La synthèse commerce est facultative : si elle échoue, la page reste utilisable.
        if (_peutCommerce)
        {
            _tb = await ParametresApi.GetTableauBordAsync();
            _tbIndisponible = _tb == null;
        }

        ConstruireDestinations();
        await ChargerRepriseAsync();
        ConstruireCartes();
        ConstruireAlertes();
        _chargement = false;
    }

    // ───────────── Destinations (recherche rapide + reprise) ─────────────

    private void ConstruireDestinations()
    {
        var d = new List<Destination>();

        if (_peutCompta)
            d.Add(new("COMPTA", "Vue d'ensemble comptable", "/", "bi-speedometer2", "tableau de bord accueil synthèse"));

        if (_peutSaisie)
        {
            d.Add(new("COMPTA", "Écritures comptables", "/comptabilite/ecritures", "bi-pencil-square", "écriture saisie journal comptabilité"));
            d.Add(new("COMPTA", "Factures", "/factures", "bi-file-earmark-text", "facture facturation client fournisseur"));
            d.Add(new("COMPTA", "Tiers (clients et fournisseurs)", "/referentiel/tiers", "bi-people-fill", "tiers client fournisseur"));
            d.Add(new("COMPTA", "Balance", "/balance", "bi-journal-check", "balance comptes états"));
            d.Add(new("COMPTA", "Grand livre", "/grand-livre", "bi-journal-text", "grand livre comptes mouvements"));
            d.Add(new("COMPTA", "Plan comptable", "/plan-comptable", "bi-book-half", "plan comptable ohada comptes"));
        }

        if (_peutDevis)
        {
            d.Add(new("VENTES", "Tableau de bord des ventes", "/ventes", "bi-speedometer2", "ventes devis synthèse relance"));
            d.Add(new("VENTES", "Devis", "/ventes/devis", "bi-file-earmark-text", "devis proposition offre commerciale"));
            d.Add(new("VENTES", "Nouveau devis", "/ventes/devis/nouveau", "bi-file-earmark-plus", "créer devis offre"));
            d.Add(new("VENTES", "Pipeline", "/ventes/pipeline", "bi-kanban", "pipeline affaires opportunités"));
            d.Add(new("VENTES", "Clients", "/ventes/clients", "bi-person-lines-fill", "client prospect fichier"));
        }

        if (_peutCommerce)
        {
            d.Add(new("COMMERCE", "Ouvrir la caisse", "/commerce/caisse", "bi-receipt", "vendre vente encaisser ticket pos caisse"));
            d.Add(new("COMMERCE", "Clients & fidélité", "/commerce/clients", "bi-people", "client fidélité points crédit créance"));
            d.Add(new("COMMERCE", "Articles & services", "/commerce/produits", "bi-box-seam", "produit article service catalogue prix code-barres"));
            d.Add(new("COMMERCE", "Catégories", "/commerce/categories", "bi-tags", "catégorie rayon famille champs caractéristiques"));
            d.Add(new("COMMERCE", "Magasins & dépôts", "/commerce/magasins", "bi-shop", "magasin dépôt entrepôt point de vente"));
            d.Add(new("COMMERCE", "Niveaux de stock", "/commerce/stocks", "bi-boxes", "stock lot péremption réapprovisionnement entrée"));
            d.Add(new("COMMERCE", "Inventaires", "/commerce/inventaires", "bi-clipboard-check", "inventaire comptage écart"));
            d.Add(new("COMMERCE", "Étiquettes & codes-barres", "/commerce/etiquettes", "bi-upc-scan", "étiquette code-barres qr imprimer prix"));
            if (_peutAdmin)
                d.Add(new("COMMERCE", "Fin de journée", "/commerce/fin-journee", "bi-calendar-check", "fin de journée rapport z caisse ventes encaissements"));
        }

        if (_peutAdmin)
        {
            if (_peutCommerce)
                d.Add(new("COMMERCE", "Mon activité & options", "/commerce/parametres", "bi-sliders", "activité options tva fidélité remise configuration paramètres"));

            d.Add(new("ADMIN", "Utilisateurs", "/utilisateurs", "bi-people", "utilisateur rôle droit accès mot de passe caissier"));
            d.Add(new("ADMIN", "Profils & permissions", "/administration/profils", "bi-ui-checks-grid", "profil permission droit rôle caissier magasinier"));
            d.Add(new("ADMIN", "Mon entreprise", "/entreprise", "bi-building", "entreprise société profil informations"));
            if (_peutCompta)
                d.Add(new("ADMIN", "Classes comptables OHADA", "/configuration/classes-comptables", "bi-gear-wide-connected", "classes ohada comptables configuration"));
        }

        if (_estSuperAdmin)
        {
            d.Add(new("ADMIN", "Gestion des PME", "/superadmin/tenants", "bi-building-gear", "pme entreprises tenants abonnements"));
            d.Add(new("ADMIN", "Demandes d'accès", "/superadmin/demandes-acces", "bi-person-check", "demandes accès inscription essai"));
        }

        _destinations = d;
    }

    private async Task ChargerRepriseAsync()
    {
        try
        {
            var chemin = await Stockage.LireAsync(ClesStockage.DernierePage);
            if (string.IsNullOrWhiteSpace(chemin) || chemin == "/") return;
            _reprise = _destinations.FirstOrDefault(x => string.Equals(x.Url, chemin, StringComparison.OrdinalIgnoreCase));
        }
        catch { /* stockage indisponible : pas de bandeau de reprise */ }
    }

    // ───────────── Cartes de modules ─────────────

    private void ConstruireCartes()
    {
        var cartes = new List<Carte>();

        // Finance & Compta : tout utilisateur connecté, si le module est dans l'abonnement
        if (_peutCompta)
        {
            var compta = new List<ActionRapide>();
            if (_peutSaisie)
            {
                compta.Add(new("Écritures", "/comptabilite/ecritures", "bi-pencil-square", true));
                compta.Add(new("Factures", "/factures", "bi-file-earmark-text"));
                compta.Add(new("Balance", "/balance", "bi-journal-check"));
            }
            else
            {
                compta.Add(new("Vue d'ensemble", "/", "bi-speedometer2", true));
            }
            cartes.Add(new("COMPTA", "Finance & Compta", "Écritures, factures, tiers et états financiers OHADA",
                "bi-wallet2", "bg-primary bg-opacity-10 text-primary", "btn-primary", compta, new()));
        }

        // Ventes & Devis
        if (_peutDevis)
        {
            cartes.Add(new("VENTES", "Ventes & Devis", "Devis en PDF, suivi des affaires et factures de vente",
                "bi-file-earmark-check", "bg-info bg-opacity-10 text-info", "btn-info text-white",
                new List<ActionRapide>
                {
                    new("Nouveau devis", "/ventes/devis/nouveau", "bi-file-earmark-plus", true),
                    new("Devis", "/ventes/devis", "bi-file-earmark-text"),
                    new("Pipeline", "/ventes/pipeline", "bi-kanban")
                }, new()));
        }

        // Commerce & Ventes
        if (_peutCommerce)
        {
            var actions = new List<ActionRapide>
            {
                _tb?.SessionOuverte == true
                    ? new ActionRapide("Reprendre la vente", "/commerce/caisse", "bi-receipt", true)
                    : new ActionRapide("Ouvrir la caisse", "/commerce/caisse", "bi-receipt", true),
                new("Articles & services", "/commerce/produits", "bi-box-seam"),
                new("Clients", "/commerce/clients", "bi-people"),
                new("Stock", "/commerce/stocks", "bi-boxes")
            };

            var puces = new List<Puce>();
            if (_tb != null)
            {
                if (_tb.SessionOuverte) puces.Add(new("Caisse ouverte", "bg-success bg-opacity-10 text-success"));
                else if (_tb.NbPointsDeVente > 0) puces.Add(new("Caisse fermée", "bg-secondary bg-opacity-10 text-secondary"));

                puces.Add(new($"{_tb.NbVentesJour} vente(s) aujourd'hui · {_tb.ChiffreAffairesJour:N0} {_devise}", "bg-light text-dark border"));
                puces.Add(new($"{_tb.NbArticles} article(s)", "bg-light text-dark border"));
                puces.Add(new($"{_tb.NbClients} client(s)", "bg-light text-dark border"));
            }
            else if (_tbIndisponible)
            {
                puces.Add(new("Synthèse momentanément indisponible", "bg-warning bg-opacity-25 text-dark"));
            }

            cartes.Add(new("COMMERCE", "Commerce & Ventes", "Caisse, catalogue, stock et clients de votre commerce",
                "bi-cart3", "bg-success bg-opacity-10 text-success", "btn-success", actions, puces));
        }

        // Administration
        if (_peutAdmin)
        {
            var admin = new List<ActionRapide>
            {
                new("Utilisateurs", "/utilisateurs", "bi-people", true),
                new("Profils & permissions", "/administration/profils", "bi-ui-checks-grid"),
                new("Mon entreprise", "/entreprise", "bi-building")
            };
            if (_peutCompta)
                admin.Add(new("Classes OHADA", "/configuration/classes-comptables", "bi-gear-wide-connected"));
            if (_estSuperAdmin)
            {
                admin.Add(new("Demandes d'accès", "/superadmin/demandes-acces", "bi-person-check"));
                admin.Add(new("Gestion des PME", "/superadmin/tenants", "bi-building-gear"));
            }
            cartes.Add(new("ADMIN", "Administration", "Utilisateurs, profils, entreprise et paramètres",
                "bi-gear", "bg-warning bg-opacity-10 text-warning", "btn-warning", admin, new()));
        }

        _cartes = cartes;
    }

    // ───────────── Points d'attention (le « cerveau » de la page) ─────────────

    private void ConstruireAlertes()
    {
        var alertes = new List<Alerte>();

        if (_peutCommerce && _tb != null)
        {
            var t = _tb;

            if (t.LotsPerimes > 0)
                alertes.Add(new("danger", "bi-exclamation-octagon-fill", $"{t.LotsPerimes} lot(s) périmé(s) en stock",
                    "Ne les vendez plus : retirez-les du stock.", "Voir les lots", "/commerce/stocks"));

            if (t.LotsProchesPeremption > 0)
                alertes.Add(new("warning", "bi-hourglass-split", $"{t.LotsProchesPeremption} lot(s) expirent dans 30 jours",
                    "Écoulez-les en priorité (promotion, vente rapide).", "Voir les lots", "/commerce/stocks"));

            if (t.ArticlesSousSeuil > 0)
                alertes.Add(new("warning", "bi-graph-down-arrow", $"{t.ArticlesSousSeuil} article(s) sous le seuil de réapprovisionnement",
                    "Pensez à recommander avant la rupture.", "Voir le stock", "/commerce/produits"));

            if (!t.ActiviteConfiguree)
                alertes.Add(new("info", "bi-magic", "Configurez votre activité",
                    _peutAdmin
                        ? "Choisissez un modèle (alimentation, mode, services...) : catégories et champs adaptés à votre métier en 1 minute."
                        : "Demandez à l'administrateur de choisir l'activité de l'entreprise pour adapter les écrans.",
                    _peutAdmin ? "Configurer" : null, _peutAdmin ? "/commerce/parametres" : null));

            if (t.NbPointsDeVente == 0)
                alertes.Add(new("info", "bi-shop", "Aucun point de vente",
                    "Créez votre premier point de vente pour pouvoir encaisser.", "Créer un point de vente", "/commerce/magasins"));

            if (t.NbArticles == 0)
                alertes.Add(new("info", "bi-box-seam", "Votre catalogue est vide",
                    "Ajoutez vos premiers articles ou services.", "Ajouter un article", "/commerce/produits"));

            if (t.SessionOuverte)
                alertes.Add(new("success", "bi-receipt", "Votre caisse est ouverte",
                    "N'oubliez pas de la clôturer en fin de journée.", "Reprendre la vente", "/commerce/caisse"));
            else if (t.NbPointsDeVente > 0 && t.NbArticles > 0)
                alertes.Add(new("info", "bi-door-open", "Aucune caisse ouverte",
                    "Ouvrez une session pour commencer à vendre.", "Ouvrir la caisse", "/commerce/caisse"));

            if (t.CreancesClients > 0)
                alertes.Add(new("info", "bi-journal-text", $"{t.NbClientsEnCredit} client(s) vous doivent {t.CreancesClients:N0} {_devise}",
                    "Ventes à crédit en attente de règlement.", "Voir les clients", "/commerce/clients"));
        }

        _alertes = alertes.OrderBy(a => RangNiveau(a.Niveau)).ToList();
    }

    private static int RangNiveau(string niveau) => niveau switch { "danger" => 0, "warning" => 1, "info" => 2, _ => 3 };

    private static string ClasseNiveau(string niveau) => niveau switch
    {
        "danger" => "text-danger",
        "warning" => "text-warning",
        "success" => "text-success",
        _ => "text-primary"
    };

    // ───────────── Recherche & navigation ─────────────

    private IEnumerable<Destination> Resultats()
    {
        var mots = Normaliser(_recherche).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (mots.Length == 0) return Enumerable.Empty<Destination>();

        return _destinations
            .Where(d =>
            {
                var cible = Normaliser($"{d.Libelle} {d.Mots} {NomModule(d.Module)}");
                return mots.All(m => cible.Contains(m));
            })
            .Take(8);
    }

    private void SurTouche(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var premier = Resultats().FirstOrDefault();
            if (premier != null) Aller(premier.Url);
        }
        else if (e.Key == "Escape")
        {
            _recherche = "";
        }
    }

    private void Aller(string url) => Nav.NavigateTo(url);

    /// <summary>Ouvre un module à la dernière page qu'on y a visitée (sinon à sa page d'entrée).</summary>
    private async Task OuvrirModuleAsync(string code)
    {
        var defaut = code switch
        {
            "COMMERCE" => "/commerce/produits",
            "VENTES" => "/ventes",
            "ADMIN" => "/entreprise",
            _ => "/"
        };

        string? derniere = null;
        try { derniere = await Stockage.LireAsync(ClesStockage.PageModule(code)); }
        catch { /* stockage indisponible */ }

        Nav.NavigateTo(!string.IsNullOrWhiteSpace(derniere) && derniere.StartsWith('/') ? derniere : defaut);
    }

    private static string NomModule(string code) => code switch
    {
        "COMPTA" => "Finance & Compta",
        "COMMERCE" => "Commerce & Ventes",
        "VENTES" => "Ventes & Devis",
        "ADMIN" => "Administration",
        _ => code
    };

    // ───────────── Affichage ─────────────

    private static string Salutation() => DateTime.Now.Hour switch
    {
        < 5 => "Bonsoir",
        < 12 => "Bonjour",
        < 18 => "Bon après-midi",
        _ => "Bonsoir"
    };

    private static string DateDuJour()
    {
        string[] jours = { "dimanche", "lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi" };
        string[] mois = { "janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août", "septembre", "octobre", "novembre", "décembre" };
        var maintenant = DateTime.Now;
        return $"{jours[(int)maintenant.DayOfWeek]} {maintenant.Day} {mois[maintenant.Month - 1]} {maintenant.Year}";
    }

    /// <summary>Minuscules sans accents : « Écriture » est trouvée en tapant « ecriture ».</summary>
    private static string Normaliser(string? texte)
    {
        const string avec = "àâäáãåçéèêëíìîïñóòôöõúùûüýÿ";
        const string sans = "aaaaaaceeeeiiiinooooouuuuyy";

        var minuscule = (texte ?? "").Trim().ToLowerInvariant().ToCharArray();
        for (var i = 0; i < minuscule.Length; i++)
        {
            var position = avec.IndexOf(minuscule[i]);
            if (position >= 0) minuscule[i] = sans[position];
        }
        return new string(minuscule);
    }
