@page "/connexion"
@page "/login"
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject ILocalStorage Stockage
@inject IAuthService AuthApi
@inject NavigationManager Nav
@inject AppState State
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <img class="auth-brand" src="images/logo-full-light.svg" alt="Finama" />
            <h1 class="auth-title">
                @(_enAttenteDeOtp ? "Vérification de sécurité" : "Bienvenue sur Finama")
            </h1>
        </div>

        <EditForm Model="_model" OnValidSubmit="GererSoumissionGlobale">
            @if (!_enAttenteDeOtp)
            {
                <div class="form-group">
                    <label>Email professionnel</label>
                    <InputText @bind-Value="_model.Email" class="form-control" placeholder="nom@entreprise.com" autocomplete="username" />
                </div>
                <div class="form-group">
                    <label>Mot de passe</label>
                    <InputText @bind-Value="_model.MotDePasse" type="password" class="form-control" autocomplete="current-password" />
                </div>
            }
            else
            {
                <div class="form-group" style="text-align: center;">
                    <label style="margin-bottom: 12px; display: block; font-weight: 500;">
                        Un code de validation unique a été envoyé à l'adresse <strong>@_model.Email</strong>.
                    </label>
                    <p style="font-size: 13px; color: #666; margin-bottom: 15px;">Le code est valide pendant 10 minutes.</p>

                    <InputText @bind-Value="_codeOtp"
                               @onkeyup="GererEntreeClavier"
                               class="form-control"
                               placeholder="------"
                               maxlength="6"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               style="text-align: center; font-size: 24px; letter-spacing: 8px; font-weight: bold;" />
                </div>
            }

            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="auth-message auth-message-@_typeMessage" role="alert">
                    <span class="auth-message-icone">@(_typeMessage switch { "succes" => "✅", "info" => "ℹ️", _ => "⚠️" })</span>
                    <div>
                        <div>@_message</div>
                        @if (!string.IsNullOrEmpty(_aide))
                        {
                            <div class="auth-message-aide">@_aide</div>
                        }
                    </div>
                </div>
            }

            <button type="submit" class="btn-auth" disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span>Vérification...</span>
                }
                else
                {
                    <span>@(_enAttenteDeOtp ? "Valider le code" : "Se connecter")</span>
                }
            </button>

            @if (_enAttenteDeOtp)
            {
                <div style="text-align: center; margin-top: 15px; display: flex; flex-direction: column; gap: 8px; align-items: center;">
                    <button type="button" class="auth-link" style="background: none; border: none; cursor: pointer; font-size: 13px; color: #007bff;"
                            @onclick="GererRenvoiOtp" disabled="@_isSubmitting">
                        ⏳ @(_isResending ? "Renvoi du code en cours..." : "Renvoyer un nouveau code")
                    </button>

                    <button type="button" class="auth-link" style="background: none; border: none; cursor: pointer; font-size: 12px; color: #666;"
                            @onclick="RetournerAuLogin" disabled="@_isSubmitting">
                        ↩️ Revenir à la saisie du mot de passe
                    </button>
                </div>
            }
        </EditForm>

        @if (!_enAttenteDeOtp)
        {
            <div class="auth-footer">
                <p>Pas encore de compte ? <a href="/inscription" class="auth-link">Créer un compte</a></p>
            </div>
        }
    </div>
</div>

<style>
    .auth-message { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border-radius: 10px; font-size: 13.5px; margin-bottom: 12px; text-align: left; }
    .auth-message-erreur { background: #fdecec; color: #a12622; border: 1px solid #f5c2c0; }
    .auth-message-alerte { background: #fff6e5; color: #7a4b00; border: 1px solid #ffd99a; }
    .auth-message-info { background: #e8f1fd; color: #144e8c; border: 1px solid #b9d4f5; }
    .auth-message-succes { background: #e8f7ef; color: #0f6b3e; border: 1px solid #b7e4c9; }
    .auth-message-icone { line-height: 1.3; }
    .auth-message-aide { margin-top: 4px; opacity: .85; font-size: 12.5px; }
</style>

@code {
    private LoginModel _model = new();
    private string _codeOtp = string.Empty;
    private bool _enAttenteDeOtp;
    private bool _isSubmitting;
    private bool _isResending;

    // Message affiché : texte exact de l'API + une aide concrète selon le cas
    private string? _message;
    private string? _aide;
    private string _typeMessage = "erreur";   // erreur | alerte | info | succes

    protected override void OnInitialized()
    {
        // Redirection par AuthHeaderHandler quand la session n'a pas pu être renouvelée
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query;
        if (query.Contains("expire=", StringComparison.OrdinalIgnoreCase))
            Afficher("Votre session a expiré. Reconnectez-vous pour continuer.", type: "info");
    }

    private async Task GererSoumissionGlobale()
    {
        _isSubmitting = true;
        Effacer();

        try
        {
            if (!_enAttenteDeOtp)
            {
                // ─── ÉTAPE 1 : identifiants ───
                var resultat = await AuthApi.LoginAsync(_model.Email, _model.MotDePasse);
                if (resultat is null)
                {
                    Afficher("La connexion n'a pas abouti. Réessayez.");
                }
                else if (string.IsNullOrEmpty(resultat.AccessToken))
                {
                    _enAttenteDeOtp = true;   // appareil non reconnu : code envoyé par e-mail
                }
                else
                {
                    await TraiterConnexionReussie(resultat);
                }
            }
            else
            {
                // ─── ÉTAPE 2 : code OTP ───
                if (string.IsNullOrWhiteSpace(_codeOtp) || _codeOtp.Length < 6)
                {
                    Afficher("Saisissez le code à 6 chiffres reçu par e-mail.", type: "alerte");
                    return;
                }

                var authData = await AuthApi.VerifyOtpAsync(_model.Email, _codeOtp);
                if (authData is not null) await TraiterConnexionReussie(authData);
                else Afficher("Code incorrect ou expiré.");
            }
        }
        catch (Exception ex)
        {
            AfficherErreurApi(ex.Message);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    /// <summary>Message exact de l'API, avec une aide adaptée (abonnement, entreprise suspendue, code déjà envoyé…).</summary>
    private void AfficherErreurApi(string? message)
    {
        var m = string.IsNullOrWhiteSpace(message) ? "La connexion n'a pas abouti. Réessayez." : message;

        if (m.Contains("abonnement", StringComparison.OrdinalIgnoreCase))
            Afficher(m, "Pour réactiver l'accès, l'administrateur de votre entreprise doit renouveler l'abonnement auprès du support Finama.", "alerte");
        else if (m.Contains("désactivé", StringComparison.OrdinalIgnoreCase) || m.Contains("suspendu", StringComparison.OrdinalIgnoreCase))
            Afficher(m, "Contactez l'administrateur de votre entreprise ou le support Finama.", "alerte");
        else if (m.Contains("Patientez", StringComparison.OrdinalIgnoreCase))
        {
            // Un code a déjà été envoyé : on passe directement à la saisie du code
            _enAttenteDeOtp = true;
            Afficher(m, "Saisissez le code reçu par e-mail ci-dessus (vérifiez aussi les courriers indésirables).", "info");
        }
        else if (m.Contains("Trop de", StringComparison.OrdinalIgnoreCase))
            Afficher(m, "Patientez une minute avant de réessayer.", "alerte");
        else
            Afficher(m);
    }

    private async Task TraiterConnexionReussie(AuthResponse authData)
    {
        // Le magasin mémorisé peut appartenir à un autre compte ou à des données supprimées
        await Stockage.SupprimerAsync(ClesStockage.MagasinId);
        State.Utilisateur = authData;
        // Jetons (access + refresh) déjà enregistrés par AuthService.SauvegarderSessionAsync

        if (AuthStateProvider is CustomAuthStateProvider customProvider)
            customProvider.NotifyUserAuthentication(authData.AccessToken);

        if (authData.DoitChangerMotDePasse)
            Nav.NavigateTo("/changer-mot-de-passe");
        else
            Nav.NavigateTo("/", forceLoad: true);   // démarre propre avec les droits du compte connecté
    }

    private async Task GererRenvoiOtp()
    {
        _isResending = true;
        _isSubmitting = true;
        Effacer();
        _codeOtp = string.Empty;

        try
        {
            var resultat = await AuthApi.LoginAsync(_model.Email, _model.MotDePasse);
            if (resultat is not null && string.IsNullOrEmpty(resultat.AccessToken))
                Afficher("Un nouveau code a été envoyé à votre adresse e-mail.", type: "succes");
            else
                Afficher("Impossible de renvoyer le code. Réessayez ou revenez en arrière.");
        }
        catch (Exception ex)
        {
            AfficherErreurApi(ex.Message);
        }
        finally
        {
            _isResending = false;
            _isSubmitting = false;
        }
    }

    private async Task GererEntreeClavier(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_codeOtp))
            await GererSoumissionGlobale();
    }

    private void RetournerAuLogin()
    {
        _enAttenteDeOtp = false;
        _codeOtp = string.Empty;
        Effacer();
    }

    private async Task Inscription()
    {
        await AuthApi.LogoutAsync();
        Nav.NavigateTo("/inscription");
    }

    private void Afficher(string message, string? aide = null, string type = "erreur")
    {
        _message = message;
        _aide = aide;
        _typeMessage = type;
    }

    private void Effacer()
    {
        _message = null;
        _aide = null;
    }
}
