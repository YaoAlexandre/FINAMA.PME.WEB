@inject NavigationManager Nav
@inject FinamaApiService Api

@if (_accesRefuse)
{
    <div class="container py-5 text-center">
        <i class="bi bi-shield-lock fs-1 text-warning"></i>
        <h4 class="mt-3">Accès réservé</h4>
        <p class="text-muted">Votre profil ne permet pas d'ouvrir cette page. Contactez l'administrateur de votre entreprise.</p>
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/modules")'>Retour aux modules</button>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _accesRefuse;

    protected override async Task OnInitializedAsync()
    {
        var etat = AuthState is null ? null : await AuthState;

        if (etat?.User.Identity?.IsAuthenticated == true && await Api.EstConnecteAsync())
        {
            // Connecté mais rôle insuffisant : on explique au lieu d'afficher une page blanche
            _accesRefuse = true;
            return;
        }

        var retour = Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri));
        Nav.NavigateTo(string.IsNullOrEmpty(retour) ? "/connexion" : $"/connexion?retour={retour}");
    }
}
