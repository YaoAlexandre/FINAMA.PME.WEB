@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject ILocalStorage Stockage
@inject IAuthService AuthApi
@inject IEntrepriseService EntrepriseApi
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ModulesService Modules

<RadzenNotification />

<div class="finama-layout">
    <!-- Overlay de chargement maintenu uniquement pendant la première vérification -->
    @if (_verificationEnCours)
    {
        <!-- Suite visuelle de l'écran de chargement (index.html) : même décor, sans animation d'entrée -->
        <div class="fn-load fn-suite" role="status" aria-label="Ouverture de votre session">
            <div class="fn-grille"></div>
            <div class="fn-centre">
                <div class="fn-scene">
                    <div class="fn-orbite">
                        <span class="fn-module"><i class="bi bi-wallet2"></i></span>
                        <span class="fn-module"><i class="bi bi-file-earmark-check"></i></span>
                        <span class="fn-module"><i class="bi bi-cart3"></i></span>
                        <span class="fn-module"><i class="bi bi-gear"></i></span>
                    </div>
                    <div class="fn-logo"><img src="icons/icon-512.png" alt="" style="width:100%;height:100%" /></div>
                </div>
                <h1 class="fn-nom">FINAMA</h1>
                <div class="fn-messages"><span class="fn-fixe">Ouverture de votre session…</span></div>
                <div class="fn-progression"><div class="fn-barre-fond"><div class="fn-barre-plein"></div></div></div>
            </div>
        </div>
    }

    <aside class="sidebar @(_sidebarOpen ? "open" : "")">
        <div class="sidebar-brand d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <div class="brand-logo"><img src="images/logo-icon.svg" alt="" /></div>
                <span class="brand-name">Finama</span>
            </div>

            <button class="btn text-white border-0 d-lg-none" @onclick="ToggleSidebar" style="font-size: 1.2rem; padding: 4px;" aria-label="Fermer le menu">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <!-- SÉLECTEUR DE MODULE : un seul point d'entrée, avec description et accueil des modules -->
        <div class="px-3 py-2 border-bottom border-secondary border-opacity-25">
            <div class="menu-zone position-relative">
                <button class="module-switch w-100" type="button" @onclick="ToggleModuleDropdown"
                        aria-haspopup="true" aria-expanded="@(_moduleDropdownOpen ? "true" : "false")">
                    <span class="module-icone @InfoModule(_moduleActif).Fond"><i class="bi @InfoModule(_moduleActif).Icone"></i></span>
                    <span class="module-texte">
                        <span class="d-block fw-bold text-white small text-truncate">@InfoModule(_moduleActif).Titre</span>
                        <span class="module-sous-titre">@(string.IsNullOrWhiteSpace(_entrepriseNom) ? "Changer de module" : _entrepriseNom)</span>
                    </span>
                    <i class="bi bi-chevron-expand text-muted flex-shrink-0"></i>
                </button>

                <div class="module-menu @(_moduleDropdownOpen ? "show" : "")" role="menu">
                    <button type="button" role="menuitem" class="module-item @(_moduleActif == "MODULES" ? "actif" : "")" @onclick="AllerAuxModules">
                        <span class="module-icone bg-secondary bg-opacity-25 text-light"><i class="bi bi-grid-3x3-gap"></i></span>
                        <span class="module-texte">
                            <span class="d-block fw-bold small">Accueil des modules</span>
                            <span class="module-desc">Vue d'ensemble et points d'attention</span>
                        </span>
                        @if (_moduleActif == "MODULES") { <i class="bi bi-check2 module-coche"></i> }
                    </button>

                    <div class="module-separateur"></div>

                    @if (Modules.Actuels.Comptabilite)
                    {
                        <AuthorizeView Policy="LectureSeule">
                            <Authorized>@ItemModule("COMPTA")</Authorized>
                        </AuthorizeView>
                    }

                    @if (Modules.Actuels.GestionCommerciale)
                    {
                        <AuthorizeView Policy="Ventes">
                            <Authorized>@ItemModule("VENTES")</Authorized>
                        </AuthorizeView>
                    }

                    @if (Modules.Actuels.Commerce)
                    {
                        <AuthorizeView Policy="Commercial">
                            <Authorized>@ItemModule("COMMERCE")</Authorized>
                        </AuthorizeView>
                    }

                    <AuthorizeView Policy="AdminTenant" Context="admin">
                        <Authorized>@ItemModule("ADMIN")</Authorized>
                        <NotAuthorized>
                            <AuthorizeView Policy="Utilisateurs" Context="utilisateurs">
                                <Authorized>@ItemModule("ADMIN")</Authorized>
                            </AuthorizeView>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>

        <nav class="sidebar-nav" @onclick="GererClicNav">
            <MenuLateral Module="@_moduleActif" />
        </nav>

        <div class="sidebar-footer">
            <div class="user-card">
                <div class="user-avatar">@(_userInitiales)</div>
                <div class="user-info">
                    <span class="user-nom">@_userNom</span>
                    <span class="user-entreprise text-muted">@_entrepriseNom</span>
                </div>
            </div>
            <button class="btn-logout" @onclick="Deconnecter" title="Déconnexion" aria-label="Déconnexion">
                <i class="bi bi-power"></i>
            </button>
        </div>
    </aside>

    <main class="main-content">
        <BandeauSupport />
        <div class="topbar px-4">
            <button class="btn-menu" @onclick="ToggleSidebar" aria-label="Afficher ou masquer le menu">
                <i class="bi bi-list fs-4"></i>
            </button>

            <div class="topbar-right d-flex align-items-center gap-3">
                <span class="badge bg-secondary font-monospace d-none d-md-inline-block">
                    Module : @(_moduleActif == "COMPTA" ? "Finance & Compta" : _moduleActif == "COMMERCE" ? "Commerce & Ventes" : _moduleActif == "VENTES" ? "Ventes & Devis" : _moduleActif == "ADMIN" ? "Administration" : "Accueil")
                </span>
                <a href="/notifications" class="btn btn-sm btn-outline-secondary rounded-3" title="Notifications" aria-label="Notifications">
                    <i class="bi bi-bell"></i>
                </a>
                <ThemeSwitcher />

                <!-- Devise de tenue de la comptabilité : fixe (OHADA : une seule monnaie de tenue).
                     Les opérations en devises étrangères se saisissent dans les écritures / factures avec leur taux. -->
                <span class="badge rounded-pill border border-primary text-primary fw-bold px-3 py-2 d-inline-flex align-items-center"
                      title="Devise de tenue de la comptabilité de @(_entrepriseNom). Tous les montants sont exprimés dans cette devise.">
                    <i class="bi bi-cash-coin me-1"></i>@_deviseActiveCode (@_deviseSymbole)
                </span>
            </div>
        </div>
        <div class="page-wrapper p-3 p-md-4">
            @if (!_verificationEnCours && !Modules.EstActif(_moduleActif))
            {
                <!-- Garde : module non inclus dans l'abonnement (l'API refuse de toute façon) -->
                <div class="text-center py-5" style="max-width: 560px; margin: 40px auto;">
                    @if (Modules.Actuels.SansEntreprise)
                    {
                        <i class="bi bi-buildings fs-1 text-warning d-block mb-3"></i>
                        <h4 class="fw-bold">Compte d'administration de la plateforme</h4>
                        <p class="text-muted">Ce compte n'a pas d'entreprise, donc pas de données comptables ni commerciales.
                            Pour voir l'application comme un client, ouvrez une session <strong>Support</strong> depuis la gestion des PME.</p>
                        <a href="/superadmin/tenants" class="btn btn-warning fw-bold"><i class="bi bi-headset me-1"></i>Gestion des PME</a>
                    }
                    else
                    {
                        <i class="bi bi-lock fs-1 text-warning d-block mb-3"></i>
                        <h4 class="fw-bold">Module non activé</h4>
                        <p class="text-muted">Le module « @InfoModule(_moduleActif).Titre » n'est pas inclus dans l'abonnement de votre entreprise.
                            Contactez Finama pour l'ajouter à votre formule.</p>
                        <a href="/modules" class="btn btn-success">Retour aux modules</a>
                    }
                </div>
            }
            else
            {
                @Body
            }
        </div>
    </main>
</div>

<StylesLayout />

@code {
    private bool _verificationEnCours = true;
    private bool _isInitialized = false;
    private bool _sidebarOpen = true;
    private string _userNom = "";
    private string _userInitiales = "?";
    private string _entrepriseNom = "";
    private string _deviseSymbole = "FCFA";
    private List<DeviseDto>? _listeDevises;
    private string _deviseActiveCode = "XOF";
    private bool _dropdownOpen = false;
    private bool _moduleDropdownOpen = false;

    private string _moduleActif = "COMPTA";

    // Interop JS : module dédié (wwwroot/js/finama-menus.js), sans eval.
    private DotNetObjectReference<MainLayout>? _reference;
    private IJSObjectReference? _moduleMenus;
    private IJSObjectReference? _abonnementMenus;
    private bool _detruit;

    // Informations d'affichage d'un module (une seule source pour le sélecteur, le badge et le titre).
    private static (string Titre, string Description, string Icone, string Fond) InfoModule(string code) => code switch
    {
        "COMPTA" => ("Finance & Compta", "Écritures, factures, balance, tiers", "bi-wallet2", "bg-primary bg-opacity-25 text-primary"),
        "COMMERCE" => ("Commerce & Ventes", "Caisse, articles, stock, clients", "bi-cart3", "bg-success bg-opacity-25 text-success"),
        "VENTES" => ("Ventes & Devis", "Devis, pipeline, clients, factures", "bi-file-earmark-check", "bg-info bg-opacity-25 text-info"),
        "ADMIN" => ("Administration", "Utilisateurs, entreprise, paramètres", "bi-gear", "bg-warning bg-opacity-25 text-warning"),
        _ => ("Choisir un module", "Accueil des modules", "bi-grid-3x3-gap", "bg-secondary bg-opacity-25 text-light")
    };

    private RenderFragment ItemModule(string code) => __builder =>
    {
        var info = InfoModule(code);
        <button type="button" role="menuitem" class="module-item @(_moduleActif == code ? "actif" : "")" @onclick="() => SelectionnerModuleAsync(code)">
            <span class="module-icone @info.Fond"><i class="bi @info.Icone"></i></span>
            <span class="module-texte">
                <span class="d-block fw-bold small">@info.Titre</span>
                <span class="module-desc">@info.Description</span>
            </span>
            @if (_moduleActif == code) { <i class="bi bi-check2 module-coche"></i> }
        </button>
    };

}
